<% content_for :title, "Help" %>

<h1 class="text-3xl font-bold">Help</h1>
<p class="mt-1 mb-6 text-steel-600">Guides to HardPoint, and the people behind it.</p>

<div class="grid gap-6 lg:grid-cols-5">
  <section class="card lg:col-span-2">
    <h2 class="mb-3 text-lg font-semibold">Guides</h2>
    <ul class="space-y-2 text-sm">
      <% HelpArticle.all.each do |article| %>
        <li><%= link_to article.title, help_article_url(article, subdomain: false), class: "link", target: "_blank", rel: "noopener" %></li>
      <% end %>
    </ul>
    <p class="mt-4 text-sm"><%= link_to "All guides in the help centre ↗", help_url(subdomain: false), class: "link", target: "_blank", rel: "noopener" %></p>
  </section>

  <div class="space-y-6 lg:col-span-3">
    <section class="card">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold">Chat on WhatsApp</h2>
          <p class="hint">Quickest for something urgent at the till.</p>
        </div>
        <%= link_to "Open WhatsApp", whatsapp_support_url("Hello HardPoint, this is #{Current.user.name} from #{Current.account.name} (#{Current.account.subdomain}). "),
              class: "btn bg-green-600 text-white hover:bg-green-700", target: "_blank", rel: "noopener" %>
      </div>
    </section>

    <section class="card">
      <h2 class="text-lg font-semibold">Send us a message</h2>
      <p class="hint mb-4">We reply by email to <%= Current.user.email_address %>, usually within a working day.</p>
      <%= form_with model: @support_request do |form| %>
        <%= render "shared/errors", model: @support_request %>
        <%= form.hidden_field :page %>
        <div class="field">
          <%= form.label :subject, "What's it about?", class: "label" %>
          <%= form.text_field :subject, required: true, maxlength: 150, class: "input", placeholder: "e.g. Receipts print too wide" %>
        </div>
        <div class="field">
          <%= form.label :body, "Tell us more", class: "label" %>
          <%= form.text_area :body, required: true, rows: 6, class: "input", placeholder: "What were you doing, what did you expect, and what happened instead?" %>
        </div>
        <% if @support_request.page.present? %>
          <p class="hint mb-4">We'll see you were on <span class="font-mono"><%= @support_request.page %></span>.</p>
        <% end %>
        <%= form.submit "Send to support", class: "btn-primary" %>
      <% end %>
    </section>

    <% if @recent.any? %>
      <section class="card">
        <h2 class="mb-3 text-lg font-semibold">Your recent messages</h2>
        <table class="table">
          <tbody>
            <% @recent.each do |request| %>
              <tr>
                <td class="font-mono"><%= request.reference %></td>
                <td><%= request.subject %></td>
                <td><span class="badge <%= request.resolved? ? "bg-green-100 text-green-800" : "" %>"><%= request.status.humanize %></span></td>
                <td class="text-right text-steel-600"><%= time_ago_in_words(request.created_at) %> ago</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>
  </div>
</div>
