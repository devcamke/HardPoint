<% content_for :title, "Reports" %>

<h1 class="text-xl font-medium">Reports</h1>
<p class="hint mb-4">Any period and branch, on screen, as CSV or as PDF. Owners, managers and accountants can get a daily summary by email (see My profile).</p>

<div class="grid gap-4 lg:grid-cols-2">
  <% @reports.each do |group, reports| %>
    <% extra = group == "Stock" ?
         [ [ "Stock movement history", stock_movements_path, "Every change to stock, filterable by product, branch and reason" ],
           [ "Stock levels and reconciliation", stock_path, "Value per branch and a check that levels match the ledger" ] ] :
         [ [ "Who owes us", receivables_path, "Customer balances by how late they are" ],
           [ "What we owe", payables_path, "Supplier balances by how late they are" ],
           [ "QuickBooks export", quickbooks_export_path, "A month of the books for your accountant, ready to import into QuickBooks Online" ] ] %>
    <section class="rounded border border-gray-200 bg-white">
      <h2 class="border-b border-gray-200 bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-800"><%= group %></h2>
      <% (reports.map { [ _1.title, report_path(_1.key), _1.description ] } + extra).each do |title, path, description| %>
        <%= link_to path, class: "block border-b border-gray-100 px-4 py-3 last:border-b-0 hover:bg-gray-50" do %>
          <p class="font-medium text-gray-900"><%= title %></p>
          <p class="hint"><%= description %></p>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
