<% content_for :title, @report.title %>
<% report = @report %>

<p class="text-sm print:hidden"><%= link_to "← Reports", reports_path, class: "link" %></p>
<div class="mt-2 mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-3xl font-bold"><%= report.title %></h1>
    <p class="hint mt-1"><%= report.subtitle %> · amounts in <%= Current.account.currency %></p>
  </div>
  <div class="flex gap-2 print:hidden">
    <%= link_to "CSV", report_path(report.class.key, request.query_parameters.merge(format: :csv)), class: "btn-secondary" %>
    <%= link_to "PDF", report_path(report.class.key, request.query_parameters.merge(format: :pdf)), target: "_blank", class: "btn-secondary" %>
    <button type="button" class="btn-secondary" data-controller="print" data-action="print#print">Print</button>
  </div>
</div>

<%= form_with url: report_path(report.class.key), method: :get, class: "card mb-6 flex flex-wrap items-end gap-3 p-4 print:hidden", data: { controller: "auto-submit report-period" } do |form| %>
  <% if report.uses_period %>
    <div><%= form.label :preset, "Period", class: "label" %>
      <%= form.select :preset, Report::Period::PRESETS.invert.to_a + [ [ "Choose dates…", "" ] ], { selected: report.period.preset.to_s }, class: "input",
            data: { report_period_target: "preset", action: "change->auto-submit#submit" } %></div>
    <div><%= form.label :from, class: "label" %><%= form.date_field :from, value: report.period.from, class: "input", data: { action: "change->report-period#chooseDates" } %></div>
    <div><%= form.label :to, class: "label" %><%= form.date_field :to, value: report.period.to, class: "input", data: { action: "change->report-period#chooseDates" } %></div>
  <% end %>
  <div><%= form.label :branch_id, "Branch", class: "label" %>
    <%= form.collection_select :branch_id, Current.account.branches.alphabetically, :id, :name, { selected: report.branch&.id, include_blank: "All branches" }, class: "input",
          data: { action: "change->auto-submit#submit" } %></div>
  <% report.class.options.each do |name, label, choices, _| %>
    <div><%= form.label name, label, class: "label" %>
      <%= form.select name, choices, { selected: report.options[name] }, class: "input", data: { action: "change->auto-submit#submit" } %></div>
  <% end %>
  <%= form.submit "Show", class: "btn-secondary" %>
<% end %>

<% report.sections.each do |section| %>
  <section class="card mb-6 overflow-x-auto">
    <%= tag.h2 section.title, class: "mb-3 text-lg font-semibold" if section.title %>
    <% if section.rows.any? %>
      <table class="table">
        <thead>
          <tr><% section.columns.each do |column| %><th class="<%= "text-right" if column.numeric? %>"><%= column.label %></th><% end %></tr>
        </thead>
        <tbody>
          <% section.rows.each_with_index do |row, index| %>
            <tr class="<%= "font-bold" if index.in?(section.emphasis) %>">
              <% row.zip(section.columns).each do |value, column| %><td class="<%= report_cell_classes(value, column) %>"><%= report_cell(value, column) %></td><% end %>
            </tr>
          <% end %>
          <% if section.totals %>
            <tr class="font-bold">
              <% section.totals.zip(section.columns).each do |value, column| %><td class="<%= report_cell_classes(value, column) %>"><%= report_cell(value, column) %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">Nothing in this period.</p>
    <% end %>
    <%= tag.p section.note, class: "hint mt-3" if section.note %>
  </section>
<% end %>
