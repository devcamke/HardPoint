<% content_for :title, @report.title %>
<% report = @report %>

<% filters = [] %>
<% if report.uses_period %>
  <% filters << search_filter(:preset, label: "Period", value: report.period.preset, clear: "this_month",
       options: Report::Period::PRESETS.to_a) %>
  <% filters << search_filter(:from, label: "From", type: :date, value: report.period.from.iso8601, facet: false, drops: [ :preset ]) %>
  <% filters << search_filter(:to, label: "To", type: :date, value: report.period.to.iso8601, facet: false, drops: [ :preset ]) %>
<% end %>
<% filters << search_filter(:branch_id, label: "Branch", value: report.branch&.id,
     options: Current.account.branches.alphabetically.map { [ _1.id, _1.name ] }) %>
<% report.class.options.each do |name, label, choices, default| %>
  <% filters << search_filter(name, label: label, value: report.options[name], clear: default, options: choices.map(&:reverse),
       section: (label == "Group by" ? :group_by : :filters)) %>
<% end %>

<div class="print:hidden">
  <%= render "shared/control_panel",
        title: safe_join([ link_to("Reports", reports_path, class: "link"), tag.span("/", class: "text-gray-400"), report.title ], " "),
        actions: [ [ "Export CSV", report_path(report.class.key, request.query_parameters.merge(format: :csv)) ],
                   [ "Download PDF", report_path(report.class.key, request.query_parameters.merge(format: :pdf)), { target: "_blank" } ],
                   [ "Print", "#", { data: { controller: "print", action: "print#print" } } ] ],
        filters: filters %>
</div>
<p class="hint mb-4" data-tour="report-subtitle"><%= report.subtitle %> · amounts in <%= Current.account.currency %></p>
<h1 class="mb-2 hidden text-xl font-medium print:block"><%= report.title %></h1>

<% report.sections.each_with_index do |section, index| %>
  <section class="card mb-4 overflow-x-auto" <%= tag.attributes(data: { tour: ("report-table" if index.zero?) }) %>>
    <%= tag.h2 section.title, class: "mb-2 font-medium" if section.title %>
    <% if section.rows.any? %>
      <table class="table">
        <thead>
          <tr><% section.columns.each do |column| %><th class="<%= "text-right" if column.numeric? %>"><%= column.label %></th><% end %></tr>
        </thead>
        <tbody>
          <% section.rows.each_with_index do |row, index| %>
            <tr class="<%= "font-semibold" if index.in?(section.emphasis) %>">
              <% row.zip(section.columns).each do |value, column| %><td class="<%= report_cell_classes(value, column) %>"><%= report_cell(value, column) %></td><% end %>
            </tr>
          <% end %>
          <% if section.totals %>
            <tr class="bg-gray-50 font-semibold">
              <% section.totals.zip(section.columns).each do |value, column| %><td class="<%= report_cell_classes(value, column) %>"><%= report_cell(value, column) %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">Nothing in this period.</p>
    <% end %>
    <%= tag.p section.note, class: "hint mt-3" if section.note %>
  </section>
<% end %>
