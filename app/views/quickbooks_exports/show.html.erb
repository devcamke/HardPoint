<% content_for :title, "QuickBooks export" %>

<div class="mt-2 mb-6">
  <h1 class="text-xl font-medium"><%= link_to "Reports", reports_path, class: "link" %> <span class="text-gray-400">/</span> QuickBooks export</h1>
  <p class="mt-1 max-w-3xl text-gray-500">A month of the books for your accountant to import into QuickBooks Online: sales by how they were paid with VAT,
    cost of sales, returns, deposits, customers paying their accounts, supplier bills and payments, as balanced journal entries, with the
    customers and suppliers to import first. The README in the download says how.</p>
</div>

<div class="grid items-start gap-6 lg:grid-cols-2">
  <section class="card">
    <h2 class="mb-3 font-semibold">Download a month</h2>
    <%= form_with url: quickbooks_export_path(format: :zip), method: :get, data: { turbo: false }, class: "flex flex-wrap items-end gap-3" do |form| %>
      <div><%= form.label :month, "Month", class: "label" %>
        <%= form.month_field :month, value: @month.strftime("%Y-%m"), max: Date.current.strftime("%Y-%m"), class: "input" %></div>
      <%= form.submit "Download for QuickBooks", class: "btn-primary" %>
    <% end %>
    <p class="hint mt-3">A ZIP of CSV files. Amounts in <%= Current.account.currency %>; anything that can't go in a journal (such as paying a supplier
      in dollars) is listed separately with the reason.</p>
  </section>

  <section class="card">
    <h2 class="mb-1 font-semibold">Accounts in QuickBooks</h2>
    <p class="hint mb-3">The account each kind of money posts to. Match these to your accountant's chart of accounts; blank keeps the usual name.</p>
    <%= form_with url: quickbooks_export_path, method: :patch do |form| %>
      <%= hidden_field_tag :month, @month.strftime("%Y-%m") %>
      <% QuickbooksExport::ACCOUNTS.each do |key, (label, default)| %>
        <div class="field grid items-center gap-2 sm:grid-cols-2">
          <%= label_tag "accounts_#{key}", label, class: "text-sm text-gray-700" %>
          <%= text_field_tag "accounts[#{key}]", @account_names[key], id: "accounts_#{key}", placeholder: default, class: "input py-1.5" %>
        </div>
      <% end %>
      <%= form.submit "Save account names", class: "btn-secondary" %>
    <% end %>
  </section>
</div>
