<div class="field">
  <%= form.label :name, class: "label" %>
  <%= form.text_field :name, required: true, class: "input" %>
</div>
<div class="field">
  <%= form.label :rate, "Rate (%)", class: "label" %>
  <%= form.number_field :rate, required: true, step: "0.01", min: 0, max: 99.99, class: "input" %>
</div>
<div class="field flex items-center gap-2">
  <%= form.check_box :default, class: "size-4 accent-safety-500" %>
  <%= form.label :default, "Default for new products", class: "text-sm font-medium text-navy-800" %>
</div>
