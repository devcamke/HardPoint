<% content_for :title, "Hire tools" %>

<%= render "shared/control_panel",
      title: "Tools for hire",
      new_button: ([ "New", new_hire_item_path ] if current_membership.can_manage_catalogue?),
      filters: [ search_filter(:status, label: "Status", value: @status,
                   options: HireItem::STATUSES.map { [ _1, "#{_1.humanize} (#{@counts.fetch(_1, 0)})" ] }) ] %>

<div class="card overflow-x-auto">
  <% if @hire_items.any? %>
    <table class="table">
      <thead><tr><th>Tool</th><th>Branch</th><th class="text-right">Per day</th><th class="text-right">Per week</th><th class="text-right">Deposit</th><th>Status</th><th class="text-right">Earned (90 days)</th><th></th></tr></thead>
      <tbody>
        <% @hire_items.each do |item| %>
          <tr id="<%= dom_id(item) %>">
            <td><span class="font-medium"><%= item.name %></span> <span class="font-mono text-xs text-gray-500"><%= item.asset_tag %></span></td>
            <td><%= item.branch.name %></td>
            <td class="text-right tabular-nums"><%= money(item.daily_rate_cents) %></td>
            <td class="text-right tabular-nums"><%= item.weekly_rate_cents ? money(item.weekly_rate_cents) : "–" %></td>
            <td class="text-right tabular-nums"><%= money(item.deposit_cents) %></td>
            <td>
              <%= render "hire_items/status", item: item %>
              <% if (hire = @current_hires[item.id]) %><%= link_to hire.reference, hire_agreement_path(hire), class: "link ml-1 text-xs" %><% end %>
            </td>
            <td class="text-right tabular-nums"><%= money(@earned.fetch(item.id, 0)) %></td>
            <td class="text-right"><%= link_to "Edit", edit_hire_item_path(item), class: "link" if current_membership.can_manage_catalogue? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500">No tools yet. Add each one you hire out (each mixer separately, with its own tag like MIX-01) to start.</p>
  <% end %>
</div>
