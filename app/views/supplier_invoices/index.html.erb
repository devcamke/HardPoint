<% content_for :title, "Supplier invoices" %>

<div class="mb-4 flex items-center justify-between">
  <h1 class="text-3xl font-bold">Purchasing</h1>
  <%= link_to "Record invoice", new_supplier_invoice_path, class: "btn-primary" %>
</div>
<%= render "purchasing/tabs" %>

<div class="card">
  <% if @invoices.any? %>
    <table class="table">
      <thead><tr><th>Invoice</th><th>Supplier</th><th>Dated</th><th>Due</th><th class="text-right">Amount</th></tr></thead>
      <tbody>
        <% @invoices.each do |invoice| %>
          <tr><td><%= link_to invoice.number, invoice, class: "link font-mono" %></td><td><%= link_to invoice.supplier.name, invoice.supplier, class: "hover:text-safety-700" %></td>
            <td><%= l(invoice.invoice_date, format: :short) %></td><td><%= l(invoice.due_date, format: :short) %></td><td class="text-right tabular-nums"><%= money(invoice.total_cents, currency: invoice.supplier.currency_code) %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">No supplier invoices recorded yet.</p>
  <% end %>
</div>
<%= render "shared/pagination" %>
