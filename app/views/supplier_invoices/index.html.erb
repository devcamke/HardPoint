<% content_for :title, "Supplier invoices" %>

<%= render "shared/control_panel",
      title: "Supplier invoices",
      new_button: [ "New", new_supplier_invoice_path ],
      search: { placeholder: "Supplier" },
      records: @invoices %>

<div class="card">
  <% if @invoices.any? %>
    <table class="table">
      <thead><tr><th>Invoice</th><th>Supplier</th><th>Dated</th><th>Due</th><th class="text-right">Amount</th></tr></thead>
      <tbody>
        <% @invoices.each do |invoice| %>
          <tr><td><%= link_to invoice.number, invoice, class: "link font-mono" %></td><td><%= link_to invoice.supplier.name, invoice.supplier, class: "hover:text-primary-700" %></td>
            <td><%= l(invoice.invoice_date, format: :short) %></td><td><%= l(invoice.due_date, format: :short) %></td><td class="text-right tabular-nums"><%= money(invoice.total_cents, currency: invoice.supplier.currency_code) %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">No supplier invoices recorded yet.</p>
  <% end %>
</div>
