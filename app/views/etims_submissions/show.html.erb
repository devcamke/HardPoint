<% content_for :title, "eTIMS invoice #{@submission.invoice_number}" %>
<% submission = @submission %>
<p class="text-sm"><%= link_to "← Sent to KRA", etims_submissions_path, class: "link" %></p>
<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-3xl font-bold">Invoice <%= submission.invoice_number %> <%= render "etims_submissions/status", submission: submission %></h1>
    <p class="hint mt-1"><%= submission.document_label %> · <%= submission.device.name %> · <%= submission.credit_note? ? "credit note against invoice #{submission.original_invoice_number}" : "sale" %></p>
  </div>
  <% unless submission.sent? %><%= button_to "Send again now", etims_submission_retry_path(submission), class: "btn-primary" %><% end %>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="card">
    <h2 class="mb-3 font-semibold">What KRA signed</h2>
    <% if submission.sent? %>
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-steel-600">Control unit</dt><dd class="font-mono"><%= submission.device.sdc_id %></dd>
        <dt class="text-steel-600">Receipt number</dt><dd class="font-mono"><%= submission.receipt_number %> / <%= submission.total_receipt_number %></dd>
        <dt class="text-steel-600">Internal data</dt><dd class="break-all font-mono"><%= submission.internal_data %></dd>
        <dt class="text-steel-600">Signature</dt><dd class="font-mono"><%= submission.receipt_signature %></dd>
        <dt class="text-steel-600">Signed</dt><dd><%= submission.signed_at ? l(submission.signed_at, format: :long) : submission.sdc_date_time %></dd>
      </dl>
      <%= link_to "Check with KRA", submission.verification_url, target: "_blank", rel: "noopener", class: "link mt-3 inline-block text-sm" %>
    <% else %>
      <p class="hint">Not signed yet.</p>
    <% end %>
  </section>
  <section class="card">
    <h2 class="mb-3 font-semibold">Attempts</h2>
    <p class="text-sm"><%= pluralize(submission.attempts, "attempt") %><%= ", last #{l(submission.last_attempted_at, format: :short)}" if submission.last_attempted_at %></p>
    <%= tag.p submission.last_error, class: "mt-2 text-sm #{submission.failed? ? "text-red-700" : "text-steel-600"}" if submission.last_error %>
    <% if submission.failed? %>
      <p class="hint mt-3">Fix what KRA objected to (often an item class code on the category, a tax type on the tax rate, or the control unit's setup), then send it again.</p>
    <% elsif submission.pending? %>
      <p class="hint mt-3">It's sent again automatically, waiting a little longer after each try.</p>
    <% end %>
  </section>
</div>
