<% content_for :title, "eTIMS submissions" %>

<%= render "shared/control_panel",
      title: safe_join([ link_to("KRA eTIMS", etims_devices_path, class: "link"), tag.span("/", class: "text-gray-400"), "Sent to KRA" ], " "),
      actions: ([ [ "Retry #{pluralize(@counts["failed"], "refused one")}", etims_retries_path, { data: { turbo_method: :post } } ] ] if @counts["failed"].to_i.positive?).to_a,
      filters: [ search_filter(:status, label: "Status", value: @status, clear: "all",
                   options: [ [ "pending", "Waiting (#{@counts["pending"].to_i})" ], [ "failed", "Refused (#{@counts["failed"].to_i})" ], [ "sent", "Signed" ] ]) ],
      records: @submissions %>

<div class="card">
  <% if @submissions.any? %>
    <table class="table">
      <thead><tr><th>Invoice</th><th>Document</th><th>Branch</th><th>When</th><th>Status</th><th>Attempts</th><th>KRA says</th></tr></thead>
      <tbody>
        <% @submissions.each do |submission| %>
          <tr>
            <td><%= link_to submission.invoice_number, submission, class: "link font-mono" %></td>
            <td><%= submission.document_label %></td>
            <td><%= submission.device.branch.name %></td>
            <td><%= l(submission.created_at, format: :short) %></td>
            <td><%= render "etims_submissions/status", submission: submission %></td>
            <td class="tabular-nums"><%= submission.attempts %></td>
            <td class="max-w-80 truncate text-sm <%= "text-red-700" if submission.failed? %>"><%= submission.sent? ? "Receipt #{submission.receipt_number}" : submission.last_error %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">Nothing here.</p>
  <% end %>
</div>
