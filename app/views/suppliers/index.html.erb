<% content_for :title, "Suppliers" %>

<%= render "shared/control_panel",
      title: "Suppliers",
      new_button: ([ "New", new_supplier_path ] if current_membership.can_purchase?),
      search: { placeholder: "Supplier name" },
      records: @suppliers %>

<div class="card">
  <% if @suppliers.any? %>
    <table class="table">
      <thead><tr><th>Supplier</th><th>Contact</th><th>Terms</th><th class="text-right">We owe</th></tr></thead>
      <tbody>
        <% @suppliers.each do |supplier| %>
          <tr>
            <td><%= link_to supplier.name, supplier, class: "link" %><%= tag.span("Inactive", class: "badge ml-1 bg-gray-200 text-gray-500") unless supplier.active? %></td>
            <td><%= [ supplier.contact_name, supplier.phone ].compact_blank.join(" · ") %></td>
            <td><%= supplier.payment_terms_days.zero? ? "Cash" : "#{supplier.payment_terms_days} days" %></td>
            <td class="text-right tabular-nums"><%= money(supplier.balance_cents, currency: supplier.currency_code) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">No suppliers yet.</p>
  <% end %>
</div>
