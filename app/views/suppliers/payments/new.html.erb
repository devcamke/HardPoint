<% content_for :title, "Record payment" %>
<p class="text-sm"><%= link_to "← #{@supplier.name}", @supplier, class: "link" %></p>
<h1 class="mt-2 mb-2 text-3xl font-bold">Pay <%= @supplier.name %></h1>
<p class="hint mb-6">We owe <%= money(@supplier.balance_cents) %>. Payments settle the oldest invoices first.</p>

<%= form_with model: @payment, url: supplier_payments_path(@supplier), class: "card max-w-md" do |form| %>
  <%= render "shared/errors", model: @payment %>
  <div class="field"><%= form.label :amount, "Amount (#{Current.account.currency})", class: "label" %><%= form.number_field :amount, value: plain_number(@payment.amount), step: "0.01", min: 0, required: true, class: "input" %></div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="field"><%= form.label :paid_on, "Paid on", class: "label" %><%= form.date_field :paid_on, required: true, class: "input" %></div>
    <div class="field"><%= form.label :payment_method, "By", class: "label" %><%= form.select :payment_method, SupplierPayment::METHODS.map { [ _1.humanize, _1 ] }, {}, class: "input" %></div>
  </div>
  <div class="field"><%= form.label :reference, "Reference (cheque no., bank or M-Pesa code)", class: "label" %><%= form.text_field :reference, class: "input" %></div>
  <div class="field"><%= form.label :note, class: "label" %><%= form.text_field :note, class: "input" %></div>
  <%= form.submit "Record payment", class: "btn-primary" %>
<% end %>
