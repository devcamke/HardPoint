<% content_for :title, @supplier.name %>

<p class="text-sm"><%= link_to "← Suppliers", suppliers_path, class: "link" %></p>
<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-3xl font-bold"><%= @supplier.name %></h1>
    <p class="hint mt-1"><%= [ @supplier.contact_name, @supplier.phone, @supplier.email, ("PIN #{@supplier.tax_pin}" if @supplier.tax_pin.present?),
                             (@supplier.payment_terms_days.zero? ? "cash on delivery" : "pay within #{@supplier.payment_terms_days} days") ].compact_blank.join(" · ") %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if current_membership.can_manage_payables? %>
      <%= link_to "Record invoice", new_supplier_invoice_path(supplier_id: @supplier.id), class: "btn-secondary" %>
      <%= link_to "Record payment", new_supplier_payment_path(@supplier), class: "btn-secondary" %>
    <% end %>
    <% if current_membership.can_purchase? %>
      <%= link_to "Edit", edit_supplier_path(@supplier), class: "btn-secondary" %>
      <%= link_to "New order", new_purchase_order_path(supplier_id: @supplier.id), class: "btn-primary" %>
    <% end %>
  </div>
</div>

<% if current_membership.can_manage_payables? %>
  <% ageing = @supplier.ageing %>
  <div class="mb-6 grid gap-4 sm:grid-cols-3 lg:grid-cols-6">
    <div class="card"><p class="hint">We owe</p><p class="mt-1 text-lg font-bold tabular-nums"><%= money(@supplier.balance_cents, currency: @supplier.currency_code) %></p></div>
    <% { "current" => "Not yet due", "1_30" => "1–30 days late", "31_60" => "31–60", "61_90" => "61–90", "over_90" => "Over 90" }.each do |bucket, label| %>
      <div class="card"><p class="hint"><%= label %></p><p class="mt-1 text-lg font-bold tabular-nums <%= "text-red-700" if bucket != "current" && ageing[bucket].positive? %>"><%= money(ageing[bucket], currency: @supplier.currency_code) %></p></div>
    <% end %>
  </div>
<% end %>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="card lg:col-span-2">
    <h2 class="mb-3 text-lg font-semibold">Products they supply</h2>
    <% if @supplier_products.any? %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th>Product</th><th>Their code</th><th class="text-right">Cost</th><th class="text-right">Lead time (days)</th><th class="text-right">Min. order</th><th>Preferred</th><th></th></tr></thead>
          <tbody>
            <% @supplier_products.each do |supplier_product| %>
              <tr>
                <td><%= link_to supplier_product.product.name, supplier_product.product, class: "hover:text-safety-700" %></td>
                <% if current_membership.can_purchase? %>
                  <td><%= text_field_tag "supplier_product[supplier_sku]", supplier_product.supplier_sku, form: dom_id(supplier_product, :form), class: "input w-28 py-1 font-mono text-xs", "aria-label": "Supplier code" %></td>
                  <td class="text-right"><%= number_field_tag "supplier_product[cost]", plain_number(supplier_product.cost), step: "0.01", min: 0, form: dom_id(supplier_product, :form), class: "input w-28 py-1 text-right", "aria-label": "Cost" %></td>
                  <td class="text-right"><%= number_field_tag "supplier_product[lead_time_days]", supplier_product.lead_time_days, min: 0, form: dom_id(supplier_product, :form), class: "input w-20 py-1 text-right", "aria-label": "Lead time" %></td>
                  <td class="text-right"><%= number_field_tag "supplier_product[min_order_quantity]", plain_number(supplier_product.min_order_quantity), step: "any", min: 0, form: dom_id(supplier_product, :form), class: "input w-20 py-1 text-right", "aria-label": "Minimum order" %></td>
                  <td><%= hidden_field_tag "supplier_product[preferred]", "0", form: dom_id(supplier_product, :form), id: nil %><%= check_box_tag "supplier_product[preferred]", "1", supplier_product.preferred?, form: dom_id(supplier_product, :form), class: "size-4 accent-safety-500", "aria-label": "Preferred supplier" %></td>
                  <td class="whitespace-nowrap text-right"><%= submit_tag "Save", form: dom_id(supplier_product, :form), class: "btn-secondary px-2 py-1 text-xs" %>
                    <%= button_to "Remove", supplier_product_path(@supplier, supplier_product), method: :delete, class: "link ml-2 text-xs", form_class: "inline" %></td>
                <% else %>
                  <td class="font-mono text-xs"><%= supplier_product.supplier_sku %></td>
                  <td class="text-right tabular-nums"><%= money(supplier_product.cost_cents, currency: @supplier.currency_code) %></td>
                  <td class="text-right"><%= supplier_product.lead_time_days %></td>
                  <td class="text-right"><%= quantity(supplier_product.min_order_quantity) %></td>
                  <td><%= "Yes" if supplier_product.preferred? %></td><td></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%# Row forms live outside the table (forms can't sit inside rows); the inputs point at them with form="…". %>
      <% if current_membership.can_purchase? %>
        <% @supplier_products.each do |supplier_product| %>
          <%= form_with model: supplier_product, url: supplier_product_path(@supplier, supplier_product), method: :patch, id: dom_id(supplier_product, :form), class: "hidden" do %><% end %>
        <% end %>
      <% end %>
    <% else %>
      <p class="hint mb-3">No products yet. Receiving goods from them adds products here automatically.</p>
    <% end %>
    <% if current_membership.can_purchase? %>
      <%= form_with model: SupplierProduct.new, url: supplier_products_path(@supplier), class: "mt-4 flex flex-wrap items-end gap-2" do |form| %>
        <div class="flex-1"><%= form.label :product_code, "Add a product (barcode or SKU)", class: "label" %><%= form.text_field :product_code, required: true, class: "input font-mono" %></div>
        <div class="w-28"><%= form.label :cost, class: "label" %><%= form.number_field :cost, value: nil, step: "0.01", min: 0, class: "input" %></div>
        <div class="w-24"><%= form.label :lead_time_days, "Lead days", class: "label" %><%= form.number_field :lead_time_days, value: 7, min: 0, class: "input" %></div>
        <div class="w-24"><%= form.label :min_order_quantity, "Min. order", class: "label" %><%= form.number_field :min_order_quantity, value: 1, step: "any", min: 0, class: "input" %></div>
        <%= form.submit "Add", class: "btn-secondary" %>
      <% end %>
    <% end %>
  </section>

  <section class="card">
    <h2 class="mb-3 text-lg font-semibold">Recent orders</h2>
    <% if @purchase_orders.any? %>
      <table class="table"><tbody>
        <% @purchase_orders.each do |order| %>
          <tr><td><%= current_membership.can_purchase? ? link_to(order.reference, order, class: "link font-mono") : tag.span(order.reference, class: "font-mono") %></td>
            <td><%= l(order.created_at.to_date, format: :short) %></td><td class="text-right tabular-nums"><%= money(order.total_cents, currency: @supplier.currency_code) %></td><td><%= render "purchasing/status", order: order %></td></tr>
        <% end %>
      </tbody></table>
    <% else %>
      <p class="hint">No orders yet.</p>
    <% end %>
  </section>

  <% if current_membership.can_manage_payables? %>
    <section class="card">
      <h2 class="mb-3 text-lg font-semibold">Unpaid invoices</h2>
      <% if @open_invoices.any? %>
        <table class="table"><tbody>
          <% @open_invoices.each do |open| %>
            <tr><td><%= link_to open.invoice.number, open.invoice, class: "link font-mono" %></td>
              <td class="<%= "text-red-700" if open.days_overdue.positive? %>">due <%= l(open.invoice.due_date, format: :short) %><%= " · #{open.days_overdue} days late" if open.days_overdue.positive? %></td>
              <td class="text-right tabular-nums"><%= money(open.outstanding_cents, currency: @supplier.currency_code) %></td></tr>
          <% end %>
        </tbody></table>
      <% else %>
        <p class="hint">Nothing owed.</p>
      <% end %>
      <% if @payments.any? %>
        <h3 class="mt-4 mb-2 text-sm font-semibold text-steel-600">Recent payments</h3>
        <% @payments.each do |payment| %>
          <p class="flex justify-between text-sm"><span><%= l(payment.paid_on, format: :short) %> · <%= payment.payment_method.humanize %><%= " · #{payment.reference}" if payment.reference.present? %></span><span class="tabular-nums"><%= money(payment.amount_cents, currency: @supplier.currency_code) %></span></p>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>
