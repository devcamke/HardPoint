<% content_for :title, "Settings" %>

<h1 class="mb-4 text-xl font-medium">Settings</h1>

<% sections = {
     "Shop" => [
       ([ "Shop details", edit_account_path, "Name, time zone, currency, two-factor rule" ] if current_membership.can_manage_account?),
       ([ "Billing", billing_path, "Your HardPoint plan, invoices and payments" ] if current_membership.can_manage_account?),
       ([ "Features", features_path, "Switch on only what your shop uses" ] if current_membership.can_manage_account?),
       ([ "Set up your shop", onboarding_path, "The first-day checklist" ] if current_membership.can_manage_account?),
       ([ "Your data", account_data_path, "Backups, export everything, or close the account" ] if current_membership.owner?),
       ([ "Online store", edit_storefront_path, "Sell online for collection at your branches" ] if current_membership.can_manage_account? && Current.account.feature?(:online_store)),
       ([ "Developers", developers_path, "API keys and webhooks for web shops and other apps" ] if current_membership.can_manage_account? && Current.account.feature?(:developers)),
       [ "Branches", branches_path, "Your locations" ],
       [ "Tills", registers_path, "Points of sale in each branch" ]
     ].compact,
     "People" => ([
       [ "Staff", memberships_path, "Who can sign in, their roles and till PINs" ],
       [ "Activity", events_path, "Who did what, and when" ]
     ] if current_membership.can_manage_staff?).to_a,
     "Payments and tax" => ([
       [ "M-Pesa", mpesa_shortcodes_path, "Paybill or Till: prompts to pay from the till, payments received" ],
       [ "Airtel Money", airtel_merchants_path, "Prompts to pay with Airtel Money from the till" ],
       [ "KRA eTIMS", etims_devices_path, "Send sales to KRA and print signed receipts" ],
       [ "SMS", edit_account_path(anchor: "sms"), "Text receipts, order updates and balance reminders" ]
     ] if current_membership.can_manage_account?).to_a + ([
       ([ "Currencies", currencies_path, "Dollars and shillings at the till, suppliers who invoice in them, and today's rates" ] if Current.account.feature?(:currencies))
     ].compact if current_membership.approver?).to_a,
     "Catalogue" => [
       [ "Categories", categories_path, "Group products, e.g. Plumbing › Pipes" ],
       [ "Brands", brands_path, "Makers and suppliers' brands" ],
       [ "Units", units_path, "Piece, bag, kilogram, metre…" ],
       [ "Tax rates", tax_rates_path, "VAT and other rates" ],
       [ "Price lists", price_lists_path, "Contractor and wholesale prices" ],
       ([ "Import products", product_imports_path, "Load or update products from a spreadsheet" ] if current_membership.can_manage_catalogue?)
     ].compact
   } %>

<div class="flex gap-6">
  <nav class="sticky top-16 hidden w-48 shrink-0 self-start text-sm lg:block">
    <% sections.compact_blank.each_key do |heading| %>
      <a href="#<%= heading.parameterize %>" class="block rounded px-3 py-1.5 text-gray-700 hover:bg-gray-100"><%= heading %></a>
    <% end %>
  </nav>
  <div class="min-w-0 flex-1 space-y-4">
    <% sections.compact_blank.each do |heading, links| %>
      <section id="<%= heading.parameterize %>" class="scroll-mt-16 rounded border border-gray-200 bg-white">
        <h2 class="border-b border-gray-200 bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-800"><%= heading %></h2>
        <div class="grid sm:grid-cols-2">
          <% links.each do |name, path, description| %>
            <%= link_to path, class: "block border-b border-gray-100 px-4 py-3 hover:bg-gray-50" do %>
              <p class="font-medium text-gray-900"><%= name %></p>
              <p class="hint"><%= description %></p>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
