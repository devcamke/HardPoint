<% content_for :title, "Settings" %>

<h1 class="mb-6 text-3xl font-bold">Settings</h1>

<% sections = {
     "Shop" => [
       ([ "Shop details", edit_account_path, "Name, time zone, currency, two-factor rule" ] if current_membership.can_manage_account?),
       ([ "Billing", billing_path, "Your HardPoint plan, invoices and payments" ] if current_membership.can_manage_account?),
       ([ "Set up your shop", onboarding_path, "The first-day checklist" ] if current_membership.can_manage_account?),
       ([ "Your data", account_data_path, "Export everything, or close the account" ] if current_membership.owner?),
       ([ "Online store", edit_storefront_path, "Sell online for collection at your branches" ] if current_membership.can_manage_account?),
       ([ "Developers", developers_path, "API keys and webhooks for web shops and other apps" ] if current_membership.can_manage_account?),
       [ "Branches", branches_path, "Your locations" ],
       [ "Tills", registers_path, "Points of sale in each branch" ]
     ].compact,
     "Payments and tax" => ([
       [ "M-Pesa", mpesa_shortcodes_path, "Paybill or Till: prompts to pay from the till, payments received" ],
       [ "KRA eTIMS", etims_devices_path, "Send sales to KRA and print signed receipts" ],
       [ "SMS", edit_account_path(anchor: "sms"), "Text receipts, order updates and balance reminders" ]
     ] if current_membership.can_manage_account?).to_a + ([ [ "Currencies", currencies_path, "Dollars and shillings at the till, suppliers who invoice in them, and today's rates" ],
       [ "Loyalty points", edit_loyalty_program_path, "Points customers earn on what they buy and spend at the till" ] ] if current_membership.approver?).to_a,
     "Catalogue" => [
       [ "Categories", categories_path, "Group products, e.g. Plumbing › Pipes" ],
       [ "Brands", brands_path, "Makers and suppliers' brands" ],
       [ "Units", units_path, "Piece, bag, kilogram, metre…" ],
       [ "Tax rates", tax_rates_path, "VAT and other rates" ],
       [ "Price lists", price_lists_path, "Contractor and wholesale prices" ],
       ([ "Tools for hire", hire_items_path, "Mixers, compactors, scaffolding… hired out by the day or week" ] if current_membership.can_manage_catalogue?),
       ([ "Import products", product_imports_path, "Load or update products from a spreadsheet" ] if current_membership.can_manage_catalogue?)
     ].compact
   } %>

<% sections.compact_blank.each do |heading, links| %>
  <h2 class="mt-8 mb-3 text-sm font-semibold uppercase tracking-wide text-steel-600"><%= heading %></h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% links.each do |name, path, description| %>
      <%= link_to path, class: "card block transition hover:border-safety-300 hover:shadow" do %>
        <p class="font-semibold"><%= name %></p>
        <p class="hint mt-1"><%= description %></p>
      <% end %>
    <% end %>
  </div>
<% end %>
