<% content_for :title, "Settings" %>
<% sections = settings_sections %>

<div data-controller="settings-filter">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-xl font-medium">Settings</h1>
      <p class="hint mt-1">Make HardPoint work the way <%= Current.account.name %> does. Each card shows how it's set now.</p>
    </div>
    <label class="relative w-full sm:w-80">
      <span class="sr-only">Find a setting</span>
      <svg class="pointer-events-none absolute top-1/2 left-1 size-4 -translate-y-1/2 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" placeholder="Find a setting: logo, M-Pesa…" autocomplete="off" class="input" style="padding-left: 1.75rem"
             data-settings-filter-target="query" data-action="input->settings-filter#filter keydown->settings-filter#keydown">
    </label>
  </div>

  <div class="flex gap-8">
    <nav class="sticky top-16 hidden w-48 shrink-0 self-start text-sm lg:block" aria-label="Settings sections" data-tour="settings-index">
      <% sections.each do |heading, cards| %>
        <a href="#<%= heading.parameterize %>" class="flex items-center justify-between gap-3 rounded px-3 py-1.5 text-gray-700 hover:bg-gray-100">
          <%= heading %><span class="text-xs text-gray-400 tabular-nums"><%= cards.size %></span>
        </a>
      <% end %>
    </nav>

    <div class="min-w-0 flex-1 space-y-8">
      <% sections.each do |heading, cards| %>
        <% key = { "Your shop" => "shop" }.fetch(heading, heading.parameterize) %>
        <section id="<%= heading.parameterize %>" class="scroll-mt-16" data-settings-filter-target="section" data-tour="settings-<%= key %>">
          <h2 class="mb-3 text-sm font-semibold tracking-wide text-gray-500 uppercase"><%= heading %></h2>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <% cards.each do |card| %>
              <%= link_to card.path, class: "group flex gap-3 rounded-lg border border-gray-200 bg-white p-4 transition hover:border-primary-300 hover:shadow-sm focus-visible:outline-2 focus-visible:outline-primary-500",
                    data: { settings_filter_target: "card", search: [ card.name, card.description, card.keywords, heading ].join(" ").downcase } do %>
                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary-50 text-primary-600 group-hover:bg-primary-100">
                  <%= settings_icon card.icon, class: "size-5" %>
                </span>
                <span class="min-w-0">
                  <span class="block font-medium text-gray-900"><%= card.name %></span>
                  <span class="mt-0.5 block text-sm text-gray-600"><%= card.description %></span>
                  <% if card.status.present? %><span class="mt-2 block text-sm text-gray-500"><%= card.status %></span><% end %>
                </span>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
      <p hidden class="rounded-lg border border-dashed border-gray-300 p-6 text-center text-gray-500" data-settings-filter-target="empty">
        No setting matches that. Try another word, or see the <%= link_to "help on settings", help_article_url("shop-settings", subdomain: false), class: "link" %>.
      </p>
    </div>
  </div>
</div>
