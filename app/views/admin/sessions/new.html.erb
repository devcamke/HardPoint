<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md">
  <h1 class="text-3xl font-bold">Administrator sign in</h1>

  <div class="card mt-6">
    <%= form_with url: admin_session_path do |form| %>
      <div class="field">
        <%= form.label :email_address, class: "label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "input" %>
      </div>

      <div class="field">
        <%= form.label :password, class: "label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
      </div>

      <%= form.submit "Continue", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
