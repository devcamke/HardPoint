<% content_for :title, "Two-factor" %>

<div class="mx-auto max-w-md">
  <% if @user.two_factor_enabled? %>
    <h1 class="text-3xl font-bold">Enter your code</h1>
    <p class="hint mt-2">Enter the 6-digit code from your authenticator app, or a recovery code.</p>
  <% else %>
    <h1 class="text-3xl font-bold">Set up two-factor</h1>
    <p class="hint mt-2">Administrators must use two-factor sign-in. Scan this code with your authenticator app.</p>
    <div class="mt-4 inline-block rounded-lg border border-concrete-200 bg-white p-3">
      <%= qr_code_svg @provisioning_uri, class: "size-48", role: "img", "aria-label": "QR code for your authenticator app" %>
    </div>
    <p class="hint mt-2">Key: <code class="font-mono text-navy-900"><%= @secret.scan(/.{4}/).join(" ") %></code></p>
  <% end %>

  <div class="card mt-6">
    <%= form_with url: admin_two_factor_path do |form| %>
      <div class="field">
        <%= form.label :code, class: "label" %>
        <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", class: "input text-center font-mono text-2xl tracking-widest" %>
      </div>
      <%= form.submit "Verify", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
