<% content_for :title, "Database" %>
<% rates = @health.cache_hit_rates %>
<% connections = @health.connections %>

<h1 class="mb-6 text-xl font-medium">Database</h1>

<section id="platform" class="card mb-6 <%= "border-red-200" unless @platform.ok? %>">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold">Platform checks</h2>
    <p class="hint">What <code>/health</code> tells the uptime monitor, and what PlatformHealthJob emails about every 10 minutes while it fails.</p>
  </div>
  <table class="table mt-3 text-sm"><tbody>
    <% @platform.checks.each do |check| %>
      <tr id="check_<%= check.name %>">
        <td class="w-40 font-medium"><%= check.name.to_s.humanize %></td>
        <td class="w-28"><%= status_dot check.status.to_s.humanize, { ok: :success, warning: :warning, failing: :danger }.fetch(check.status) %></td>
        <td class="text-gray-700"><%= check.detail %></td>
      </tr>
    <% end %>
  </tbody></table>
</section>

<div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="card"><p class="hint">Size</p><p class="text-2xl font-bold"><%= @health.size %></p><p class="hint">PostgreSQL <%= @health.version %></p></div>
  <div class="card"><p class="hint">Connections</p><p class="text-2xl font-bold tabular-nums"><%= connections.values.sum %> <span class="text-base font-normal text-gray-500">of <%= @health.max_connections %></span></p>
    <p class="hint"><%= connections.map { "#{_2} #{_1}" }.join(" · ") %></p></div>
  <div class="card"><p class="hint">Cache hits (tables)</p><p class="text-2xl font-bold tabular-nums <%= "text-red-700" if rates[:tables] && rates[:tables] < 99 %>"><%= rates[:tables] ? "#{rates[:tables]}%" : "–" %></p><p class="hint">Below 99%: more memory helps</p></div>
  <div class="card"><p class="hint">Cache hits (indexes)</p><p class="text-2xl font-bold tabular-nums <%= "text-red-700" if rates[:indexes] && rates[:indexes] < 99 %>"><%= rates[:indexes] ? "#{rates[:indexes]}%" : "–" %></p></div>
</div>

<section id="integrity" class="card mb-6 <%= "border-red-200" if @integrity && @integrity[:findings].any? %>">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-lg font-semibold">Data integrity</h2>
    <p class="hint">Nightly (IntegrityCheckJob): receipt numbers with no gaps, stock on hand equal to the ledger, sales paid in full, closed shifts counted, M-Pesa money matched.</p>
  </div>
  <% if @integrity.nil? %>
    <p class="mt-2 text-gray-600">No run recorded yet.</p>
  <% elsif @integrity[:findings].empty? %>
    <p class="mt-2"><%= status_dot "Clean", :success %> at <%= l(@integrity[:ran_at], format: :short) %> UTC, across every shop.</p>
  <% else %>
    <p class="mt-2 font-semibold text-red-800"><%= pluralize(@integrity[:findings].size, "finding") %> at <%= l(@integrity[:ran_at], format: :short) %> UTC. Each is a bug or tampering until shown otherwise.</p>
    <table class="table mt-3 text-sm"><tbody>
      <% @integrity[:findings].each do |finding| %>
        <% shop = across_accounts { Account.find_by(id: finding[:account_id]) } %>
        <tr><td class="w-56"><%= shop ? link_to(shop.name, admin_account_path(shop), class: "link") : "Shop #{finding[:account_id]}" %></td><td class="w-40 font-medium"><%= finding[:check].to_s.humanize %></td><td class="text-gray-700"><%= finding[:detail] %></td></tr>
      <% end %>
    </tbody></table>
  <% end %>
</section>

<% replica = @health.replica %>
<section id="replica" class="card mb-6 <%= "border-red-200" if replica.error || replica.behind? %>">
  <h2 class="mb-1 text-lg font-semibold">Read replica</h2>
  <% if replica.error %>
    <p class="font-semibold text-red-800">Can't reach the replica: <%= replica.error %></p>
    <p class="hint">Reports and exports fail until it's back, or DATABASE_REPLICA_HOST is removed so they read from the primary.</p>
  <% elsif !replica.separate %>
    <p>Reports and exports read from the primary. <span class="hint">Set DATABASE_REPLICA_HOST to move them to a replica (docs/RUNBOOK.md, Scaling out).</span></p>
  <% elsif replica.streaming %>
    <p>Streaming; last change replayed <strong class="<%= "text-red-700" if replica.behind? %>"><%= replica.lag_seconds ? "#{replica.lag_seconds.round(1)} s ago" : "not yet" %></strong>.
      <span class="hint">Reports and exports read from it.</span></p>
  <% else %>
    <p class="font-semibold text-red-800">The replica host answers but isn't replicating (it's not in recovery).</p>
  <% end %>
  <% if (clients = @health.replication_clients).any? %>
    <table class="table mt-3 text-sm"><thead><tr><th>Replica</th><th>State</th><th>Replay lag</th></tr></thead><tbody>
      <% clients.each do |address, state, lag| %><tr><td class="font-mono"><%= address %></td><td><%= state %></td><td><%= lag.presence || "–" %></td></tr><% end %>
    </tbody></table>
  <% end %>
</section>

<% if (long = @health.long_running).any? %>
  <section class="card mb-6 border-red-200">
    <h2 class="mb-3 text-lg font-semibold text-red-800">Running for more than 30 seconds</h2>
    <table class="table"><tbody>
      <% long.each do |pid, duration, state, query| %>
        <tr><td class="font-mono"><%= pid %></td><td><%= duration %></td><td><%= state %></td><td><div class="max-w-xl font-mono text-xs [overflow-wrap:anywhere]"><%= query %></div></td></tr>
      <% end %>
    </tbody></table>
  </section>
<% end %>

<section id="slowest" class="card mb-6">
  <h2 class="mb-1 text-lg font-semibold">Where the database spends its time</h2>
  <% if @health.query_stats? %>
    <p class="hint mb-3">Queries by total time since statistics were last reset.</p>
    <table class="table">
      <thead><tr><th class="text-right">Calls</th><th class="text-right">Total ms</th><th class="text-right">Mean ms</th><th>Query</th></tr></thead>
      <tbody>
        <% @health.slowest_queries.each do |query| %>
          <tr><td class="text-right tabular-nums"><%= number_with_delimiter query.calls %></td><td class="text-right tabular-nums"><%= number_with_delimiter query.total_ms %></td>
            <td class="text-right tabular-nums"><%= query.mean_ms %></td><td><div class="max-w-3xl font-mono text-xs [overflow-wrap:anywhere]"><%= truncate(query.query, length: 300) %></div></td></tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">Needs the pg_stat_statements extension (loaded by config/postgres/postgresql.conf in production).</p>
  <% end %>
</section>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="card">
    <h2 class="mb-3 text-lg font-semibold">Largest tables</h2>
    <table class="table">
      <thead><tr><th>Table</th><th class="text-right">Size</th><th class="text-right">Rows</th><th class="text-right">Dead rows</th><th>Vacuumed</th></tr></thead>
      <tbody>
        <% @health.largest_tables.each do |table, size, live, dead, vacuumed| %>
          <tr><td class="font-mono text-xs"><%= table %></td><td class="text-right tabular-nums"><%= size %></td><td class="text-right tabular-nums"><%= number_with_delimiter live %></td>
            <td class="text-right tabular-nums <%= "text-red-700" if live.to_i.positive? && dead.to_i > live.to_i / 5 %>"><%= number_with_delimiter dead %></td>
            <td class="text-xs text-gray-500"><%= vacuumed ? "#{time_ago_in_words(vacuumed)} ago" : "never" %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2 class="mb-1 text-lg font-semibold">Indexes never used</h2>
    <p class="hint mb-3">Since statistics were last reset. Unused indexes slow down writes; check before dropping (some only serve rare reports).</p>
    <table class="table">
      <tbody>
        <% @health.unused_indexes.each do |table, index, size| %>
          <tr><td class="font-mono text-xs"><%= index %><br><span class="text-gray-500"><%= table %></span></td><td class="text-right tabular-nums"><%= size %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
</div>
