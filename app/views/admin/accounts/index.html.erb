<% content_for :title, "Shops" %>

<h1 class="mb-6 text-xl font-medium">Shops</h1>

<div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="card"><p class="hint">Shops</p><p class="text-2xl font-bold tabular-nums"><%= @status_counts.values.sum %></p></div>
  <div class="card"><p class="hint">Paying (monthly)</p><p class="text-2xl font-bold tabular-nums"><%= money(@monthly_revenue_cents, currency: "KES") %></p></div>
  <div class="card"><p class="hint">Received, last 30 days</p><p class="text-2xl font-bold tabular-nums"><%= money(@paid_last_30_days_cents, currency: "KES") %></p></div>
  <div class="card"><p class="hint">On trial · read-only</p><p class="text-2xl font-bold tabular-nums"><%= @status_counts.fetch("trialing", 0) %> · <%= @status_counts.fetch("read_only", 0) %></p></div>
</div>

<nav class="mb-4 flex flex-wrap gap-1 border-b border-gray-200 text-sm" aria-label="Filter by status">
  <% active = @status.nil? %>
  <%= link_to "All", admin_accounts_path, class: class_names("-mb-px border-b-2 px-3 py-2 hover:text-primary-700", active ? "border-primary-500 font-medium text-gray-900" : "border-transparent text-gray-600"), aria: { current: ("page" if active) } %>
  <% Account::Subscription::STATUSES.each do |status| %>
    <% active = @status == status %>
    <%= link_to admin_accounts_path(status: status), class: class_names("-mb-px border-b-2 px-3 py-2 hover:text-primary-700", active ? "border-primary-500 font-medium text-gray-900" : "border-transparent text-gray-600"), aria: { current: ("page" if active) } do %>
      <%= status_dot "#{status.humanize} (#{@status_counts.fetch(status, 0)})", BillingsHelper::STATUS_TONES.fetch(status, :neutral) %>
    <% end %>
  <% end %>
</nav>

<div class="card overflow-x-auto">
  <table class="table">
    <thead>
      <tr><th>Shop</th><th>Plan</th><th>Status</th><th class="text-right">Staff</th><th class="text-right">Branches</th><th class="text-right">Products</th><th class="text-right">Sales (30 days)</th><th>Opened</th></tr>
    </thead>
    <tbody>
      <% @accounts.each do |account| %>
        <tr id="<%= dom_id(account) %>">
          <td><%= link_to account.name, admin_account_path(account), class: "link" %><br><span class="font-mono text-xs text-gray-500"><%= account.subdomain %></span></td>
          <td><%= account.subscription_plan.name %></td>
          <td><%= subscription_status_badge(account) %></td>
          <td class="text-right tabular-nums"><%= @member_counts.fetch(account.id, 0) %></td>
          <td class="text-right tabular-nums"><%= @branch_counts.fetch(account.id, 0) %></td>
          <td class="text-right tabular-nums"><%= number_with_delimiter @product_counts.fetch(account.id, 0) %></td>
          <td class="text-right tabular-nums"><%= number_with_delimiter @sales_counts.fetch(account.id, 0) %></td>
          <td><%= l(account.created_at.to_date, format: :long) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
