<%= form_with model: [ :admin, announcement ], class: "card max-w-2xl" do |form| %>
  <%= render "shared/errors", model: announcement %>
  <div class="field">
    <%= form.label :title, class: "label" %>
    <%= form.text_field :title, required: true, class: "input", placeholder: "e.g. Maintenance on Sunday 2am to 3am" %>
  </div>
  <div class="field">
    <%= form.label :body, "Details (optional)", class: "label" %>
    <%= form.text_area :body, rows: 3, class: "input" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="field">
      <%= form.label :level, class: "label" %>
      <%= form.select :level, Announcement::LEVELS.map { [ _1.humanize, _1 ] }, {}, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :starts_at, "Show from", class: "label" %>
      <%= form.datetime_field :starts_at, required: true, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :ends_at, "Until (optional)", class: "label" %>
      <%= form.datetime_field :ends_at, class: "input" %>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <%= form.submit "Save", class: "btn-primary" %>
    <%= link_to "Cancel", admin_announcements_path, class: "link" %>
  </div>
<% end %>
