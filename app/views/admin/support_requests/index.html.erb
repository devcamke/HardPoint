<% content_for :title, "Support" %>

<h1 class="mb-6 text-xl font-medium">Support requests</h1>
<p class="hint mb-4">Each one is also emailed to <%= Rails.configuration.x.support[:email] %>; reply from there.</p>

<nav class="mb-4 flex gap-1 border-b border-gray-200 text-sm" aria-label="Filter by status">
  <% %w[ open resolved all ].each do |status| %>
    <% active = @status == status %>
    <%= link_to status.humanize, admin_support_requests_path(status: status), class: class_names("-mb-px border-b-2 px-3 py-2 hover:text-primary-700", active ? "border-primary-500 font-medium text-gray-900" : "border-transparent text-gray-600"), aria: { current: ("page" if active) } %>
  <% end %>
</nav>

<div class="space-y-3">
  <% @support_requests.each do |request| %>
    <article id="<%= dom_id(request) %>" class="card">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="font-semibold"><span class="font-mono text-gray-500"><%= request.reference %></span> <%= request.subject %></p>
          <p class="hint"><%= link_to request.account.name, admin_account_path(request.account), class: "link" %> · <%= request.user.name %> (<%= mail_to request.user.email_address, nil, class: "link" %>) · <%= time_ago_in_words(request.created_at) %> ago<%= " · on #{request.page}" if request.page.present? %></p>
        </div>
        <%= button_to (request.open? ? "Mark resolved" : "Reopen"), admin_support_request_path(request, status: request.open? ? "resolved" : "open"), method: :patch, class: "btn-secondary" %>
      </div>
      <p class="mt-3 whitespace-pre-wrap text-sm"><%= request.body %></p>
    </article>
  <% end %>
  <% if @support_requests.empty? %><p class="text-gray-500">Nothing here.</p><% end %>
</div>
