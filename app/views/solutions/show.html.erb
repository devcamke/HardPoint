<% content_for :title, @page.title %>
<% content_for :description, @page.description %>
<% structured_data seo_software(@plans), seo_faq(@page.faqs), seo_breadcrumbs([ @page.title, solution_url(@page) ]) %>
<% from_price = "KES #{number_with_delimiter(@plans.map(&:price_cents).min / 100)}" %>
<% trial = Plan::TRIAL.inspect %>
<% tick = tag.svg(viewBox: "0 0 22 22", aria: { hidden: true }) { tag.path(d: "M4 11.5l4.5 4.5L18 6") } %>
<%# One job or one market, said plainly, in the public site's look (landing.css): the promise, what it does in two or
    three outlined cards, the questions people ask about it, the guides with the detail, and the door. %>

<div class="lp">
  <%= render "pages/page_head", kicker: @page.title, title: @page.heading, lede: @page.intro do %>
    <div class="lp-cta">
      <%= link_to new_signup_path, class: "lp-btn" do %>Try it free for <%= trial %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg><% end %>
      <%= link_to "From #{from_price} a month", pricing_path, class: "lp-btn lp-btn-ghost" %>
    </div>
  <% end %>

  <section class="lp-wrap pb-[96px]">
    <div class="lp-cards mt-0 <%= "lp-cards-2" if @page.sections.size == 2 %>">
      <% @page.sections.each do |section| %>
        <article class="lp-card lp-solution-card">
          <h2 class="text-[26px] leading-[1.15] tracking-[-0.02em]"><%= section.heading %></h2>
          <ul>
            <% section.points.each do |point| %><li><%= tick %><span><%= point %></span></li><% end %>
          </ul>
        </article>
      <% end %>
    </div>
  </section>

  <section class="lp-section lp-rule"><div class="lp-wrap">
    <div class="lp-faq">
      <div class="lp-head">
        <p class="lp-kicker">Questions</p>
        <h2>What people ask about it.</h2>
        <% if @page.help_articles.any? %>
          <p class="lp-lede">The detail is in the help centre:</p>
          <div class="lp-tiles mt-[18px]">
            <% @page.help_articles.each do |article| %>
              <%= link_to help_article_path(article.slug), class: "lp-tile" do %>
                <span class="lp-tile-title"><%= article.title %> ›</span><span class="lp-tile-text"><%= article.summary %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
      <%= render "pages/faqs", faqs: @page.faqs %>
    </div>

    <div class="lp-also mt-[64px]">
      <span class="lp-also-label">More of what HardPoint does:</span>
      <% SolutionPage.all.excluding(@page).each do |other| %>
        <%= link_to other.title, solution_path(other), class: "lp-chip" %>
      <% end %>
      <%= link_to "Pricing", pricing_path, class: "lp-chip" %>
    </div>
  </div></section>

  <section class="lp-band lp-door"><div class="lp-wrap lp-section">
    <p class="lp-kicker">Ready when you are</p>
    <h2>Try it free for <%= trial %>.</h2>
    <div class="lp-cta">
      <%= link_to new_signup_path, class: "lp-btn lp-btn-marker" do %>Start now, it’s free<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg><% end %>
    </div>
    <p class="lp-door-note">No card needed · your data is yours to export at any time ·
      <%= link_to "ask us on WhatsApp", whatsapp_support_url("Hello HardPoint, I'd like to know more about #{@page.title}."), target: "_blank", rel: "noopener" %></p>
  </div></section>
</div>
