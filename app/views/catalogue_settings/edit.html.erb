<% content_for :title, "Edit #{resource_title.singularize.downcase}" %>

<h1 class="mb-6 text-xl font-medium"><%= link_to "#{resource_title}", { action: :index }, class: "link" %> <span class="text-gray-400">/</span> Edit <%= resource_title.singularize.downcase %></h1>

<div class="card max-w-xl">
  <%= form_with model: @record, url: { action: :update, id: @record } do |form| %>
    <%= render "shared/errors", model: @record %>
    <%= render "fields", form: form %>
    <div class="flex gap-3">
      <%= form.submit "Save", class: "btn-primary" %>
      <%= link_to "Cancel", { action: :index }, class: "btn-secondary" %>
    </div>
  <% end %>
</div>

<%= button_to "Remove", { action: :destroy, id: @record }, method: :delete, class: "btn-danger mt-6",
      form: { data: { turbo_confirm: "Remove this #{resource_title.singularize.downcase}?" } } %>
