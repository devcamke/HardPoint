<%# locals: (dark: false) %>
<%# The HardPoint mark: a hex nut with the H of HardPoint cut through it, drawn the way the public site draws the
    things that matter, with an ink outline and a hard offset shadow, like a sticker. On the teal bars (dark) the nut
    is white, the H teal and the shadow a deeper teal. The wordmark is set in the site's headline face.
    The same mark is public/icon.svg (icon.png is rendered from it) and the fallback in shared/_navigation. %>
<% ink = dark ? "#072D35" : "#0F2327" %>
<span class="inline-flex items-center gap-2.5">
  <svg viewBox="0 0 64 64" class="size-[2.3rem] shrink-0" aria-hidden="true">
    <path d="M30 3 54 17v28L30 59 6 45V17Z" transform="translate(4 4)" fill="<%= ink %>"/>
    <path d="M30 3 54 17v28L30 59 6 45V17Z" fill="<%= dark ? "#FFFFFF" : "#0F5E6E" %>" stroke="<%= ink %>" stroke-width="3.5" stroke-linejoin="round"/>
    <path d="M19 18.5h7.5v9h7v-9H41v24h-7.5v-9h-7v9H19Z" fill="<%= dark ? "#0F5E6E" : "#FFFFFF" %>" stroke="<%= ink %>" stroke-width="2.6" stroke-linejoin="round"/>
  </svg>
  <span class="font-display text-[1.7rem] leading-none font-extrabold tracking-[-0.04em] <%= dark ? "text-white" : "text-[#0F2327]" %>">HardPoint</span>
</span>
