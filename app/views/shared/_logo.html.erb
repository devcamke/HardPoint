<%# locals: (dark: false) %>
<%# The HardPoint mark: a hex nut, flat, with "H." set into it: the H of HardPoint and, after it, the point, in the
    orange of the till's Pay button. On the teal bars (dark) the nut is white and the H teal. The wordmark is Bricolage
    Grotesque ExtraBold. The same mark is public/icon.svg (icon.png is rendered from it) and, with the H in the shop's
    theme colour, the fallback in shared/_navigation. %>
<% nut, letter, word = dark ? %w[ #FFFFFF #0F5E6E text-white ] : %w[ #0F5E6E #FFFFFF text-gray-950 ] %>
<span class="inline-flex items-center gap-2.5">
  <svg viewBox="0 0 64 64" class="size-9 shrink-0" aria-hidden="true">
    <path d="M32 6 54.5 19v26L32 58 9.5 45V19Z" fill="<%= nut %>" stroke="<%= nut %>" stroke-width="5" stroke-linejoin="round"/>
    <path d="M17 20h6.5v9h6.5v-9h6.5v24H30v-9h-6.5v9H17Z" fill="<%= letter %>"/>
    <circle cx="43.4" cy="40.4" r="3.6" fill="#E46F2F"/>
  </svg>
  <span class="font-display text-[1.6rem] leading-none font-extrabold tracking-[-0.03em] <%= word %>">HardPoint</span>
</span>
