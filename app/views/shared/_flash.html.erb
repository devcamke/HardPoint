<% if flash[:notice] %>
  <p id="notice" class="mb-6 rounded-md bg-green-50 px-4 py-2 text-sm font-medium text-green-800"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert] %>
  <p id="alert" class="mb-6 rounded-md bg-red-50 px-4 py-2 text-sm font-medium text-red-800"><%= flash[:alert] %></p>
<% end %>
