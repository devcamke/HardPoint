<nav class="border-b border-stone-200 bg-white">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 text-sm">
    <%= link_to Current.account.name, root_path, class: "text-base font-bold" %>
    <%= link_to "Branches", branches_path, class: "text-stone-600 hover:text-stone-900" %>
    <% if current_membership&.can_manage_staff? %>
      <%= link_to "Staff", memberships_path, class: "text-stone-600 hover:text-stone-900" %>
    <% end %>
    <% if current_membership&.can_manage_account? %>
      <%= link_to "Settings", edit_account_path, class: "text-stone-600 hover:text-stone-900" %>
    <% end %>
    <span class="ml-auto text-stone-500"><%= Current.user.name %> · <%= current_membership&.role&.humanize %></span>
    <%= button_to "Sign out", session_path, method: :delete, class: "text-stone-600 hover:text-stone-900 cursor-pointer" %>
  </div>
</nav>
