<%# locals: (title:, new_button: nil, actions: [], search: nil, filters: [], records: nil) %>
<%# The Odoo-style control panel for list pages. search: { param: :query, placeholder: "…" }, or nil for no text search. %>
<% filters = filters.compact %>
<% query_param = search && (search[:param] || :query).to_s %>
<% facets = search_facets(filters, query_param: query_param) %>
<% range = pager_range(records) %>

<div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2">
  <div class="flex min-w-0 items-center gap-2">
    <% if new_button %><%= link_to new_button[0], new_button[1], class: "btn-primary" %><% end %>
    <h1 class="truncate text-xl font-medium"><%= title %></h1>
    <% if actions.any? %>
      <div class="relative" data-controller="dropdown" data-action="click@window->dropdown#closeOnOutsideClick keydown.esc@window->dropdown#close">
        <button type="button" class="flex size-7 cursor-pointer items-center justify-center rounded text-gray-500 hover:bg-gray-100 hover:text-gray-800"
                aria-label="Actions" title="Actions" aria-expanded="false" data-dropdown-target="toggle" data-action="dropdown#toggle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4" aria-hidden="true"><path d="<%= NavigationHelper::ICONS.fetch(:settings) %>"/></svg>
        </button>
        <div hidden data-dropdown-target="menu" class="absolute top-full left-0 z-30 mt-1 w-52 rounded border border-gray-200 bg-white py-1 shadow-lg">
          <% actions.each do |label, path, options| %>
            <%= link_to label, path, **(options || {}), class: "block px-4 py-1.5 text-sm hover:bg-gray-100" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if search || filters.any? %>
    <%= form_with url: request.path, method: :get, class: "relative order-last w-full lg:order-none lg:mx-auto lg:w-auto lg:max-w-2xl lg:flex-1",
          data: { controller: "search-panel", action: "submit->search-panel#submit click@window->search-panel#closeOnOutsideClick keydown.esc@window->search-panel#close" }, html: { role: "search" } do |form| %>
      <% date_params = filters.select { _1.type == :date }.map(&:param) %>
      <% request.query_parameters.except("page", query_param, *date_params, *filters.flat_map(&:drops)).each do |key, value| %>
        <%= hidden_field_tag key, value unless value.is_a?(Hash) || value.is_a?(Array) %>
      <% end %>
      <%= hidden_field_tag query_param, request.query_parameters[query_param], id: nil, data: { search_panel_target: "query" } if query_param %>

      <div class="flex min-h-9 items-stretch rounded border border-gray-300 bg-white focus-within:border-primary-500">
        <span class="flex items-center pl-2.5 text-gray-400" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </span>
        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-1 px-2 py-1">
          <% facets.each do |text, remove_url| %>
            <span class="inline-flex max-w-full items-center gap-1 rounded bg-gray-100 py-0.5 pr-1 pl-2 text-sm text-gray-800">
              <span class="truncate"><%= text %></span>
              <%= link_to "×", remove_url, class: "rounded px-1 leading-none text-gray-500 hover:bg-gray-200 hover:text-gray-900",
                    aria: { label: "Remove #{text}" }, data: { search_panel_target: "facetRemover" } %>
            </span>
          <% end %>
          <% if query_param %>
            <input type="search" autocomplete="off" placeholder="<%= facets.empty? ? search[:placeholder] || "Search…" : "" %>"
                   aria-label="<%= search[:placeholder] || "Search" %>" <%= "autofocus" if search[:autofocus] %>
                   class="min-w-32 flex-1 border-0 bg-transparent p-0.5 text-sm outline-none focus:ring-0"
                   data-search-panel-target="input" data-action="keydown->search-panel#keydown">
          <% else %>
            <span class="flex-1 p-0.5 text-sm text-gray-400"><%= "Filter" if facets.empty? %></span>
          <% end %>
        </div>
        <% if filters.any?(&:menu) %>
          <button type="button" class="flex cursor-pointer items-center border-l border-gray-200 px-2.5 text-gray-500 hover:bg-gray-50 hover:text-gray-800"
                  data-action="search-panel#toggle" aria-label="Filters" aria-expanded="false" data-search-panel-target="toggle">
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d="M7 10l5 5 5-5z"/></svg>
          </button>
        <% end %>
      </div>

      <% if (menu_filters = filters.select(&:menu)).any? %>
        <% sections = menu_filters.group_by(&:section) %>
        <div hidden data-search-panel-target="dropdown"
             class="<%= class_names("absolute top-full right-0 left-0 z-30 mt-1 grid rounded border border-gray-200 bg-white py-2 text-sm shadow-lg sm:left-auto",
                       "sm:w-80" => sections.size == 1, "sm:w-[36rem] sm:grid-cols-2 sm:divide-x sm:divide-gray-100" => sections.size > 1) %>">
          <% sections.each do |section, section_filters| %>
            <div>
              <p class="flex items-center gap-2 px-4 pb-1 font-semibold text-primary-500">
                <% if section == :group_by %>
                  <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d="M12 3 2 8l10 5 10-5zm-7.6 8L2 12.2l10 5 10-5-2.4-1.2-7.6 3.8zm0 4L2 16.2l10 5 10-5-2.4-1.2-7.6 3.8z"/></svg>Group By
                <% else %>
                  <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4-2v-4z"/></svg>Filters
                <% end %>
              </p>
              <% section_filters.each_with_index do |filter, index| %>
                <div class="<%= "mt-1 border-t border-gray-100 pt-1" if index.positive? %>">
                  <% if filter.label %><p class="px-4 pt-1 text-xs text-gray-500"><%= filter.label %></p><% end %>
                  <% if filter.type == :date %>
                    <div class="px-4 py-1">
                      <input type="date" name="<%= filter.param %>" value="<%= filter.value %>" aria-label="<%= filter.label %>"
                             class="input" data-action="change->search-panel#submitFilters">
                    </div>
                  <% else %>
                    <div class="max-h-60 overflow-y-auto">
                      <% filter.options.each do |value, label| %>
                        <% active = filter.active?(value) %>
                        <%= link_to search_url(filter.param => active ? filter.clear : value),
                              class: class_names("flex items-center gap-2 py-1.5 pr-4 pl-4 hover:bg-gray-100", "text-gray-900" => active),
                              aria: { current: (active ? "true" : nil) } do %>
                          <span class="w-3 text-primary-500"><%= "✓" if active %></span><%= label %>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if range %>
    <div class="ml-auto flex items-center gap-1 text-sm text-gray-600 lg:ml-0">
      <span class="tabular-nums"><%= range %></span>
      <% [ [ "‹", @previous_page, "Previous page" ], [ "›", @next_page, "Next page" ] ].each do |arrow, page, label| %>
        <% if page %>
          <%= link_to arrow, search_url("page" => page), class: "rounded border border-gray-200 bg-white px-2 py-0.5 hover:bg-gray-100", aria: { label: label }, rel: (arrow == "‹" ? "prev" : "next") %>
        <% else %>
          <span class="rounded border border-gray-100 px-2 py-0.5 text-gray-300" aria-hidden="true"><%= arrow %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
