<% content_for :title, "Airtel Money" %>

<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-xl font-medium"><%= link_to "Settings", settings_path, class: "link" %> <span class="text-gray-400">/</span> Airtel Money</h1>
    <p class="hint mt-1 max-w-2xl">Connect your Airtel Money merchant account through Airtel Africa's Open API. Cashiers can then send a prompt to a
      customer's phone to pay with Airtel Money, alongside M-Pesa, and take Airtel Money payments by their transaction ID.</p>
  </div>
  <%= link_to "Add Airtel Money", new_airtel_merchant_path, class: "btn-primary" %>
</div>

<% if @merchants.any? %>
  <div class="space-y-4">
    <% @merchants.each do |merchant| %>
      <section id="<%= dom_id(merchant) %>" class="card flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <h2 class="text-lg font-semibold"><%= merchant.name %>
            <%= status_dot merchant.environment.humanize, merchant.environment == "production" ? :success : :warning, class: "ml-2" %>
            <%= status_dot("Off", :muted, class: "ml-2") unless merchant.active? %></h2>
          <p class="hint mt-1"><%= merchant.branch ? "For #{merchant.branch.name}" : "For every branch without its own" %><%= " · #{merchant.label}" if merchant.merchant_number %></p>
          <p class="mt-2 text-sm">Callback address for Airtel's developer portal:</p>
          <p class="font-mono text-xs break-all"><%= merchant.callback_url %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= button_to "Test connection", airtel_merchant_connection_test_path(merchant), class: "btn-secondary" %>
          <%= link_to "Edit", edit_airtel_merchant_path(merchant), class: "btn-secondary" %>
        </div>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="card"><p class="hint">No Airtel Money account yet.</p></div>
<% end %>
