<% content_for :title, "Approval PIN" %>

<h1 class="mb-2 text-3xl font-bold">Approval PIN</h1>
<p class="hint mb-6">Type this at a cashier's till to approve a big discount, a void or a return. It doesn't sign you in anywhere.</p>

<div class="card max-w-md">
  <%= form_with url: my_approval_pin_path, method: :patch do |form| %>
    <%= render "shared/errors", model: @membership %>
    <div class="field"><%= form.label :approval_pin, "New approval PIN (4–6 digits)", class: "label" %>
      <%= form.password_field :approval_pin, required: true, autofocus: true, inputmode: "numeric", pattern: "\\d{4,6}", maxlength: 6, autocomplete: "off", class: "input font-mono text-xl tracking-[0.4em]" %></div>
    <div class="field"><%= form.label :password, "Your password", class: "label" %><%= form.password_field :password, required: true, autocomplete: "current-password", class: "input" %></div>
    <div class="flex gap-3"><%= form.submit "Save", class: "btn-primary" %><%= link_to "Cancel", my_profile_path, class: "btn-secondary" %></div>
  <% end %>
</div>
