<% content_for :title, "Your account" %>

<h1 class="text-xl font-medium"><%= @user.name %></h1>
<p class="hint mt-1 mb-6"><%= @user.email_address %> · <%= @membership.role.humanize %> at <%= Current.account.name %></p>

<div class="grid gap-6 md:grid-cols-2">
  <section class="card">
    <h2 class="text-lg font-semibold">Password</h2>
    <p class="hint mt-2">The same password signs you in to every shop you work for. Changing it signs you out everywhere else.</p>
    <%= link_to "Change password", edit_my_password_path, class: "btn-secondary mt-4" %>
  </section>

  <section class="card">
    <h2 class="text-lg font-semibold">Signed-in devices</h2>
    <p class="hint mt-2">Every computer and phone you're signed in on here. Sign out one you've stopped using or don't recognise.</p>
    <p class="mt-2"><%= status_dot pluralize(@sessions_count, "device"), :success %></p>
    <%= link_to "See devices", my_devices_path, class: "btn-secondary mt-4" %>
  </section>

  <section class="card">
    <h2 class="text-lg font-semibold">Two-factor sign-in</h2>
    <% if @user.two_factor_enabled? %>
      <p class="mt-2"><%= status_dot "On", :success %> since <%= l(@user.two_factor_enabled_at.to_date, format: :long) %></p>
      <p class="hint mt-2"><%= pluralize(@user.remaining_recovery_codes, "recovery code") %> left.</p>

      <%= form_with url: my_two_factor_path, method: :delete, class: "mt-4" do |form| %>
        <div class="field">
          <%= form.label :password, "Confirm your password to turn it off", class: "label" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", class: "input" %>
        </div>
        <div class="field">
          <%= form.label :code, "and a code from your app, or a recovery code", class: "label" %>
          <%= form.text_field :code, required: true, autocomplete: "one-time-code", class: "input font-mono" %>
        </div>
        <%= form.submit "Turn off two-factor", class: "btn-danger" %>
      <% end %>
    <% else %>
      <p class="hint mt-2">Protect your account with a code from an authenticator app (Google Authenticator, Microsoft Authenticator, 1Password…) as well as your password.</p>
      <%= link_to "Set up two-factor", new_my_two_factor_path, class: "btn-primary mt-4" %>
    <% end %>
  </section>

  <% if @membership.approver? %>
    <section class="card">
      <h2 class="text-lg font-semibold">Approval PIN</h2>
      <p class="hint mt-2">Lets you approve big discounts, voids and returns at a cashier's till without signing them out.</p>
      <p class="mt-2"><%= @membership.approval_pin_digest? ? status_dot("Set", :success) : status_dot("Not set", :muted) %></p>
      <%= link_to (@membership.approval_pin_digest? ? "Change approval PIN" : "Set an approval PIN"), edit_my_approval_pin_path, class: "btn-secondary mt-4" %>
    </section>
  <% end %>

  <% if @membership.can_view_reports? %>
    <% emails = [
         [ "daily_summary", "Daily summary", "Each morning at about 7:15: yesterday's takings in charts, then what's worth a look, from stock that ran out to cash counts that didn't balance." ],
         [ "weekly_summary", "Weekly summary", "Each Monday: the week against the ones before, best sellers and their margin, who owes you, what's due to suppliers and stock that isn't selling." ],
         ([ "alert_emails", "Alerts", "Straight away, when a till closes short, a completed sale is voided or a stock count loses more than the amounts on Shop details." ] if @membership.approver?)
       ].compact %>
    <section class="card">
      <h2 class="text-lg font-semibold">Emails</h2>
      <ul class="mt-1 divide-y divide-gray-100">
        <% emails.each do |key, title, hint| %>
          <% on = @membership.public_send(key) %>
          <li class="flex items-start justify-between gap-4 py-3">
            <div>
              <p class="font-medium"><%= title %> <span class="ml-1 text-sm"><%= on ? status_dot("On", :success) : status_dot("Off", :muted) %></span></p>
              <p class="hint mt-0.5"><%= hint %></p>
            </div>
            <%= button_to (on ? "Turn off" : "Turn on"), my_emails_path, method: :patch, params: { email: key, on: !on }, class: "btn-secondary shrink-0" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @membership.pin_role? %>
    <section class="card">
      <h2 class="text-lg font-semibold">Till PIN</h2>
      <% if @membership.pin_digest? %>
        <p class="mt-2">
          <% if @membership.pin_locked? %>
            <%= status_dot "Locked", :danger %> after too many wrong tries. Set a new PIN to unlock it.
          <% else %>
            <%= status_dot "Set", :success %> Use it to switch in at a till that's already signed in.
          <% end %>
        </p>
        <div class="mt-4 flex gap-3">
          <%= link_to "Change PIN", edit_my_pin_path, class: "btn-secondary" %>
          <%= button_to "Remove PIN", my_pin_path, method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "Remove your till PIN?" } } %>
        </div>
      <% else %>
        <p class="hint mt-2">Set a 4–6 digit PIN to switch in quickly at a shared till.</p>
        <%= link_to "Set a PIN", edit_my_pin_path, class: "btn-primary mt-4" %>
      <% end %>
    </section>
  <% end %>
</div>
