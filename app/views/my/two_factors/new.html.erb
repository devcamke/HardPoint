<% content_for :title, "Set up two-factor sign-in" %>

<h1 class="text-3xl font-bold">Set up two-factor sign-in</h1>

<div class="card mt-6 max-w-2xl">
  <ol class="space-y-6">
    <li>
      <p class="font-semibold">1. Scan this with your authenticator app</p>
      <div class="mt-3 inline-block rounded-lg border border-concrete-200 bg-white p-3">
        <%= qr_code_svg @provisioning_uri, class: "size-48", role: "img", "aria-label": "QR code for your authenticator app" %>
      </div>
      <p class="hint mt-2">Can't scan it? Enter this key instead: <code class="rounded bg-concrete-100 px-1.5 py-0.5 font-mono text-navy-900"><%= @secret.scan(/.{4}/).join(" ") %></code></p>
    </li>
    <li>
      <p class="font-semibold">2. Enter the 6-digit code it shows</p>
      <%= form_with url: my_two_factor_path, class: "mt-3 flex max-w-sm gap-3" do |form| %>
        <%= form.text_field :code, required: true, autocomplete: "one-time-code", inputmode: "numeric", "aria-label": "Code", class: "input text-center font-mono text-xl tracking-widest" %>
        <%= form.submit "Turn on", class: "btn-primary" %>
      <% end %>
    </li>
  </ol>
</div>
