<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md">
  <h1 class="text-xl font-medium">Sign in to <%= Current.account.name %></h1>

  <div class="card mt-6">
    <%= form_with url: session_url do |form| %>
      <div class="field">
        <%= form.label :email_address, class: "label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
      </div>

      <div class="field">
        <%= form.label :password, class: "label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
      </div>

      <div class="flex items-center justify-between">
        <%= form.submit "Sign in", class: "btn-primary" %>
        <%= link_to "Forgot password?", new_password_path, class: "text-sm text-gray-500 underline hover:no-underline" %>
      </div>
    <% end %>

    <% if GoogleSignIn.configured? %>
      <div class="mt-4 border-t border-gray-200 pt-4">
        <%# A plain link, not Turbo: it leaves for accounts.google.com. %>
        <%= link_to "Sign in with Google", new_session_google_path, class: "btn-secondary w-full justify-center", data: { turbo: false } %>
        <p class="hint mt-2">For staff whose HardPoint email address is a Google account.</p>
      </div>
    <% end %>
  </div>
</div>
