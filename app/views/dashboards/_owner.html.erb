<% content_for :head do %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>
<%= turbo_stream_from Current.account, :dashboard, channel: DashboardChannel %>
<% totals = dashboard.totals %>
<% change = dashboard.change_on_last_week_percent %>
<% drawers = dashboard.cash_in_drawers %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1 class="text-xl font-medium">Today<%= " at #{dashboard.branch.name}" if dashboard.branch %></h1>
    <p class="hint"><%= Time.zone.now.strftime("%A %-d %B %Y") %></p>
  </div>
  <%= form_with url: root_path, method: :get, data: { controller: "auto-submit", tour: "branch" } do |form| %>
    <%= form.collection_select :branch_id, @branches, :id, :name, { selected: dashboard.branch&.id, include_blank: "All branches" }, class: "input w-48",
          "aria-label": "Branch", data: { action: "change->auto-submit#submit" } %>
  <% end %>
</div>

<div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-tour="today">
  <%= link_to report_path("sales", preset: "today", branch_id: dashboard.branch&.id), class: "card block p-4 hover:border-primary-300" do %>
    <p class="text-sm text-gray-500">Takings</p>
    <p class="mt-1 whitespace-nowrap text-2xl font-semibold tabular-nums"><%= money(totals[:takings]) %></p>
    <p class="mt-2 text-sm <%= change.nil? ? "text-gray-500" : (change.negative? ? "text-red-700" : "text-green-700") %>">
      <%= change.nil? ? "Nothing on the same day last week" : "#{change.positive? ? "▲ +" : (change.negative? ? "▼ " : "")}#{change}% on last #{Time.zone.today.strftime("%A")}" %></p>
  <% end %>
  <div class="card p-4">
    <p class="text-sm text-gray-500">Sales</p>
    <p class="mt-1 whitespace-nowrap text-2xl font-semibold tabular-nums"><%= number_with_delimiter(totals[:receipts]) %></p>
    <p class="mt-2 text-sm text-gray-500">average <%= money(dashboard.average_sale_cents) %></p>
  </div>
  <%= link_to report_path("profit_and_loss", preset: "today", branch_id: dashboard.branch&.id), class: "card block p-4 hover:border-primary-300" do %>
    <p class="text-sm text-gray-500">Gross margin</p>
    <p class="mt-1 whitespace-nowrap text-2xl font-semibold tabular-nums"><%= money(totals[:margin]) %></p>
    <p class="mt-2 text-sm text-gray-500"><%= totals[:margin_percent] ? "#{number_with_precision(totals[:margin_percent], precision: 1)}% of sales ex tax" : "No sales yet" %></p>
  <% end %>
  <%= link_to shifts_path, class: "card block p-4 hover:border-primary-300" do %>
    <p class="text-sm text-gray-500">Cash in the drawers</p>
    <p class="mt-1 whitespace-nowrap text-2xl font-semibold tabular-nums"><%= money(drawers.sum { _1[:expected_cents] }) %></p>
    <p class="mt-2 text-sm text-gray-500"><%= drawers.any? ? "#{pluralize(drawers.size, "till")} open" : "No tills open" %></p>
  <% end %>
</div>

<% tasks = home_tasks(dashboard) %>
<div class="mt-4 grid items-start gap-3 lg:grid-cols-3">
  <section class="card p-0 lg:col-span-2" aria-labelledby="needs-you" data-tour="needs-you">
    <div class="flex items-center justify-between gap-3 px-4 py-3">
      <h2 id="needs-you" class="font-medium">Needs you today
        <% if tasks.any? %><span class="ml-1 text-gray-500">(<%= tasks.size %>)</span><% end %></h2>
      <% if tasks.any? %><span class="hint hidden sm:inline">Most costly first</span><% end %>
    </div>
    <% if tasks.any? %>
      <ul>
        <% tasks.each_with_index do |task, index| %>
          <li id="task_<%= task.key %>" class="flex items-center gap-3 border-t border-gray-100 px-4 py-3">
            <span class="<%= class_names("flex size-8 shrink-0 items-center justify-center rounded-lg text-sm font-bold",
                  "bg-red-50 text-red-700" => task.tone == :danger, "bg-amber-50 text-amber-700" => task.tone == :warning,
                  "bg-primary-50 text-primary-700" => task.tone == :info) %>" aria-hidden="true"><%= task.tone == :info ? "•" : "!" %></span>
            <div class="min-w-0 flex-1">
              <p class="font-medium text-gray-900"><%= task.title %></p>
              <p class="hint"><%= task.detail %></p>
            </div>
            <%= link_to task.action, tracked_path(task.path, "home:#{task.key}"), class: index.zero? ? "btn-primary" : "btn-secondary" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="border-t border-gray-100 px-4 py-8 text-center text-gray-600">All caught up. Nothing needs you right now.</p>
    <% end %>
  </section>

  <div class="space-y-3">
    <section class="card">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-medium">Last 7 days</h2>
        <%= link_to "Sales report", report_path("sales", preset: "last_30_days", branch_id: dashboard.branch&.id), class: "link text-sm" %>
      </div>
      <%= render "dashboards/bars", title: "Takings over the last 7 days", bars: dashboard.last_seven_days.map { |day, cents| [ day.strftime("%a"), cents ] } %>
    </section>

    <% if (actions = home_quick_actions).any? %>
      <nav class="grid grid-cols-2 gap-3" aria-label="Quick actions">
        <% actions.each do |label, path| %>
          <%= link_to label, tracked_path(path, "quick:#{label.parameterize(separator: "_")}"), class: "card block p-3 text-center font-medium hover:border-primary-300" %>
        <% end %>
      </nav>
    <% end %>
  </div>
</div>

<div class="mt-4 grid items-start gap-3 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <h2 class="mb-3 font-medium">Takings by hour</h2>
    <% hours = dashboard.takings_by_hour %>
    <% if hours.any? %>
      <%= render "dashboards/bars", title: "Takings by hour", bars: hours.map { |hour, cents| [ format("%02d:00", hour), cents ] } %>
    <% else %>
      <p class="hint py-12 text-center">No sales yet today.</p>
    <% end %>
  </section>

  <section class="card">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="font-medium">Best sellers today</h2>
      <%= link_to "All", report_path("sales", preset: "today", by: "product", branch_id: dashboard.branch&.id), class: "link text-sm" %>
    </div>
    <% if (top = dashboard.top_products).any? %>
      <ol class="space-y-2 text-sm">
        <% top.each do |item| %>
          <li class="flex items-baseline justify-between gap-3">
            <span class="truncate"><%= link_to item[:product].record.name, item[:product].record, class: "hover:text-primary-700" %></span>
            <span class="whitespace-nowrap tabular-nums"><%= money(item[:takings]) %></span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="hint">Nothing sold yet today.</p>
    <% end %>

    <% if dashboard.branch.nil? && @branches.size > 1 %>
      <h2 class="mt-5 mb-2 font-medium">By branch</h2>
      <% @branches.each do |branch| %>
        <p class="flex justify-between py-1 text-sm"><%= link_to branch.name, root_path(branch_id: branch.id), class: "hover:text-primary-700" %>
          <span class="tabular-nums"><%= money(dashboard.takings_by_branch.to_h.fetch(branch.name, 0)) %></span></p>
      <% end %>
    <% end %>
  </section>
</div>
