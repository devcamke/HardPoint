<% content_for :title, "Dashboard" %>

<h1 class="text-3xl font-bold">Welcome, <%= Current.user.name %></h1>
<p class="mt-1 text-stone-600"><%= Current.account.name %> · <%= Time.zone.now.to_fs(:long) %></p>

<div class="mt-8 grid gap-4 sm:grid-cols-2">
  <div class="card">
    <p class="text-sm text-stone-500">Branches</p>
    <p class="mt-1 text-3xl font-bold"><%= @branches.size %></p>
    <%= link_to "Manage branches", branches_path, class: "mt-3 inline-block text-sm text-amber-700 underline" %>
  </div>

  <div class="card">
    <p class="text-sm text-stone-500">Staff</p>
    <p class="mt-1 text-3xl font-bold"><%= @memberships.size %></p>
    <% if current_membership.can_manage_staff? %>
      <%= link_to "Manage staff", memberships_path, class: "mt-3 inline-block text-sm text-amber-700 underline" %>
    <% end %>
  </div>
</div>
