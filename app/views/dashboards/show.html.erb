<% content_for :title, "Home" %>

<% if current_membership.owner? && Current.account.onboarding_completed_at.nil? %>
  <%= render "onboardings/card", onboarding: Onboarding.new(Current.account) %>
<% end %>

<% if (current_membership.owner? || current_membership.manager?) && !Current.user.two_factor_enabled? %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded border border-amber-200 bg-amber-50 px-4 py-2 text-sm">
    <p>Two-factor sign-in is off for your account.</p>
    <%= link_to "Turn it on", new_my_two_factor_path, class: "btn-secondary" %>
  </div>
<% end %>

<% if @dashboard %>
  <%= render "dashboards/owner", dashboard: @dashboard %>
<% else %>
  <div class="mx-auto max-w-3xl pt-6 text-center">
    <h1 class="text-2xl font-medium">Hi <%= Current.user.name.split.first %></h1>
    <p class="hint"><%= [ selected_branch&.name, current_till&.name ].compact.join(" · ") %> · <%= Time.zone.now.strftime("%A %-d %B") %></p>

    <% if current_membership.can_sell? %>
      <%= link_to tracked_path(pos_path, "home:start_selling"), class: "mt-8 block rounded-xl bg-[#e46f2f] px-6 py-8 text-white shadow-md transition hover:bg-[#d0611f]" do %>
        <span class="block text-2xl font-bold"><%= current_shift ? "Start selling →" : "Open a shift and start selling →" %></span>
        <span class="mt-1 block text-sm text-white/90"><%= current_shift ? "Your shift on #{current_till.name} is open" : (current_till ? "On #{current_till.name}" : "You'll choose this computer's till first") %></span>
      <% end %>
    <% end %>

    <div class="mt-6 grid gap-3 text-left sm:grid-cols-3">
      <% if current_membership.can_sell? %>
        <%= link_to sales_path, class: "card block p-4 hover:border-primary-300" do %>
          <p class="text-sm text-gray-500">My sales today</p>
          <p class="text-2xl font-semibold tabular-nums"><%= money(@my_sales_today_cents) %></p>
          <p class="text-sm text-gray-500"><%= pluralize(@my_sales_today_count, "sale") %><%= " · #{@parked_count} parked" if @parked_count.positive? %></p>
        <% end %>
        <%= link_to customer_orders_path(status: "ready"), class: "card block p-4 hover:border-primary-300" do %>
          <p class="text-sm text-gray-500">Orders to collect</p>
          <p class="text-2xl font-semibold tabular-nums"><%= @orders_ready_count %></p>
          <p class="text-sm text-gray-500">at <%= selected_branch&.name %></p>
        <% end %>
      <% end %>
      <%= link_to reorder_list_path, class: "card block p-4 hover:border-primary-300" do %>
        <p class="text-sm text-gray-500">Low stock</p>
        <p class="text-2xl font-semibold tabular-nums <%= "text-amber-700" if @low_stock_count.positive? %>"><%= @low_stock_count %></p>
        <p class="text-sm text-gray-500">at <%= selected_branch&.name %></p>
      <% end %>
    </div>

    <% if (actions = home_quick_actions).any? %>
      <nav class="mt-6 flex flex-wrap justify-center gap-2" aria-label="Quick actions">
        <% actions.each do |label, path| %><%= link_to label, tracked_path(path, "quick:#{label.parameterize(separator: "_")}"), class: "btn-secondary" %><% end %>
      </nav>
    <% end %>

    <p class="hint mt-8"><%= link_to "Switch user", new_session_switch_path, class: "link" %><% if current_shift %> · <%= link_to "End my shift", new_shift_closing_path(current_shift), class: "link" %><% end %></p>
  </div>
<% end %>
