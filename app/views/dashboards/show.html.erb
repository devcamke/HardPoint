<% content_for :title, "Dashboard" %>

<h1 class="text-3xl font-bold">Welcome, <%= Current.user.name %></h1>
<p class="mt-1 text-steel-600"><%= Current.account.name %> · <%= Time.zone.now.to_fs(:long) %></p>

<% if (current_membership.owner? || current_membership.manager?) && !Current.user.two_factor_enabled? %>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-safety-200 bg-safety-50 px-4 py-3">
    <p class="text-sm"><span class="font-semibold">Protect your shop:</span> turn on two-factor sign-in for your account.</p>
    <%= link_to "Set it up", new_my_two_factor_path, class: "btn-primary" %>
  </div>
<% end %>

<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
  <% if current_membership.can_sell? %>
    <%= link_to sales_path, class: "card block hover:border-safety-300" do %>
      <p class="text-sm text-steel-600">Sales today</p>
      <p class="mt-1 text-3xl font-bold tabular-nums"><%= money(@sales_today_cents) %></p>
      <p class="mt-3 text-sm link"><%= pluralize(@sales_today_count, "sale") %></p>
    <% end %>
  <% end %>

  <%= link_to products_path, class: "card block hover:border-safety-300" do %>
    <p class="text-sm text-steel-600">Products</p>
    <p class="mt-1 text-3xl font-bold"><%= number_with_delimiter(@products_count) %></p>
    <p class="mt-3 text-sm link">Browse catalogue</p>
  <% end %>

  <%= link_to reorder_list_path, class: "card block hover:border-safety-300" do %>
    <p class="text-sm text-steel-600">Low stock at <%= selected_branch&.name %></p>
    <p class="mt-1 text-3xl font-bold <%= "text-safety-700" if @low_stock_count.positive? %>"><%= @low_stock_count %></p>
    <p class="mt-3 text-sm link">Reorder list</p>
  <% end %>

  <%= link_to branches_path, class: "card block hover:border-safety-300" do %>
    <p class="text-sm text-steel-600">Branches · tills</p>
    <p class="mt-1 text-3xl font-bold"><%= @branches.size %> <span class="text-lg font-semibold text-steel-600">· <%= @registers_count %></span></p>
    <p class="mt-3 text-sm link">Manage branches</p>
  <% end %>

  <div class="card">
    <p class="text-sm text-steel-600">Staff</p>
    <p class="mt-1 text-3xl font-bold"><%= @memberships.size %></p>
    <% if current_membership.can_manage_staff? %>
      <%= link_to "Manage staff", memberships_path, class: "mt-3 inline-block text-sm link" %>
    <% end %>
  </div>
</div>
