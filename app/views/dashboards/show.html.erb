<% content_for :title, "Dashboard" %>

<% if current_membership.owner? && Current.account.onboarding_completed_at.nil? %>
  <%= render "onboardings/card", onboarding: Onboarding.new(Current.account) %>
<% end %>

<% if (current_membership.owner? || current_membership.manager?) && !Current.user.two_factor_enabled? %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded border border-amber-200 bg-amber-50 px-4 py-2 text-sm">
    <p>Two-factor sign-in is off for your account.</p>
    <%= link_to "Turn it on", new_my_two_factor_path, class: "btn-secondary" %>
  </div>
<% end %>

<% if @dashboard %>
  <%= render "dashboards/owner", dashboard: @dashboard %>
<% else %>
  <h1 class="text-xl font-medium">Welcome, <%= Current.user.name %></h1>
  <p class="hint"><%= Current.account.name %> · <%= Time.zone.now.strftime("%A %-d %B %Y") %></p>

  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    <% if current_membership.can_sell? %>
      <%= link_to sales_path, class: "card block p-4 hover:border-primary-300" do %>
        <p class="text-sm text-gray-500">Sales today</p>
        <p class="text-3xl font-semibold tabular-nums"><%= money(@sales_today_cents) %></p>
        <p class="text-sm text-gray-500"><%= pluralize(@sales_today_count, "sale") %></p>
      <% end %>
    <% end %>
    <%= link_to products_path, class: "card block p-4 hover:border-primary-300" do %>
      <p class="text-sm text-gray-500">Active products</p>
      <p class="text-3xl font-semibold tabular-nums"><%= number_with_delimiter(@products_count) %></p>
    <% end %>
    <%= link_to reorder_list_path, class: "card block p-4 hover:border-primary-300" do %>
      <p class="text-sm text-gray-500">Low stock at <%= selected_branch&.name %></p>
      <p class="text-3xl font-semibold tabular-nums <%= "text-amber-700" if @low_stock_count.positive? %>"><%= @low_stock_count %></p>
    <% end %>
  </div>

  <div class="mt-10 grid grid-cols-3 gap-x-4 gap-y-8 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
    <% navigation_apps.reject { _1.key == :dashboard }.each do |app| %>
      <%= link_to app.path, class: "group flex flex-col items-center gap-2 text-center" do %>
        <span class="flex size-16 items-center justify-center rounded-xl text-white shadow-sm transition group-hover:-translate-y-0.5 group-hover:shadow-md" style="background: <%= app.color %>">
          <%= app_icon(app, css: "size-8") %>
        </span>
        <span class="text-sm text-gray-700"><%= app.name %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
