<% content_for :title, "Orders & quotes" %>

<%= render "shared/control_panel",
      title: "Orders & quotes",
      new_button: [ "New", new_customer_order_path ],
      search: { placeholder: "Customer name or phone" },
      filters: [ search_filter(:status, label: "Status", value: @status, clear: "all",
                   options: [ [ "open", "Open orders" ], [ "ready", "Ready to collect" ], [ "quote", "Quotes" ], [ "collected", "Collected" ], [ "cancelled", "Cancelled" ] ]) ],
      records: @customer_orders %>

<div class="card">
  <% if @customer_orders.any? %>
    <table class="table">
      <thead><tr><th>Number</th><th>Customer</th><th>Date</th><th>Needed / valid until</th><th>Status</th><th class="text-right">Deposit</th><th class="text-right">Total</th></tr></thead>
      <tbody>
        <% @customer_orders.each do |order| %>
          <tr>
            <td><%= link_to order.reference, order, class: "link font-mono" %></td>
            <td><%= order.customer.name %></td>
            <td><%= l(order.created_at.to_date, format: :long) %></td>
            <td><%= l(order.quote? ? order.valid_until : order.needed_by, format: :long) if (order.quote? ? order.valid_until : order.needed_by) %></td>
            <td><%= render "customer_orders/status", order: order %> <%= render "customer_orders/source", order: order %></td>
            <td class="text-right tabular-nums"><% deposit = order.deposit_balance_cents %><%= money(deposit) if deposit.positive? %></td>
            <td class="text-right tabular-nums"><%= money(order.total_cents) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">Nothing here yet. Quotes become orders when the customer confirms or pays a deposit, and are collected at the till.</p>
  <% end %>
</div>
