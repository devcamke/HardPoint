<% more_fields = %i[ branch branch_id valid_until needed_by note ] %>
<%= form_with model: customer_order, class: "card max-w-4xl" do |form| %>
  <%= render "shared/errors", model: customer_order %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="field" data-tour="order-customer"><%= form.label :customer_id, "Customer", class: "label" %>
      <%= form.collection_select :customer_id, Current.account.customers.alphabetically, :id, :name, { prompt: "Choose…" }, required: true, class: "input" %>
      <p class="hint mt-1">Not listed? <%= link_to "Add a customer", new_customer_path, class: "link" %> first.</p></div>
    <% jobs = customer_order.customer ? ([ customer_order.job ] + customer_order.customer.jobs.open.alphabetically).compact.uniq : [] %>
    <% if jobs.any? %>
      <div class="field"><%= form.label :job_id, "Job", class: "label" %>
        <%= form.select :job_id, jobs.map { [ _1.label, _1.id ] }, { include_blank: "Not for a job" }, class: "input" %></div>
    <% end %>
    <% if feature?(:fundis) %>
      <% fundis = ([ customer_order.fundi ] + Current.account.fundis.active.alphabetically.to_a).compact.uniq %>
      <div class="field"><%= form.label :fundi_id, "Brought by (fundi)", class: "label" %>
        <%= form.select :fundi_id, fundis.map { [ _1.label, _1.id ] }, { include_blank: "No fundi" }, class: "input" %>
        <p class="hint mt-1">Earns commission when the order is collected and paid.</p></div>
    <% end %>
  </div>

  <p class="label mt-2">Products</p>
  <table class="table mb-2" data-tour="order-lines">
    <% cutting = feature?(:cutting) || customer_order.lines.any?(&:cut_length) %>
    <thead><tr><th>Barcode or SKU</th><th class="text-right">Quantity</th><% if cutting %><th class="text-right">Cut into pieces of</th><% end %><% if current_membership.approver? %><th class="text-right">Unit price (blank = their price)</th><% end %><th class="text-right">Remove</th></tr></thead>
    <tbody>
      <%= form.fields_for :lines do |line| %>
        <tr>
          <td>
            <% if line.object.persisted? %>
              <%= line.hidden_field :id %><%= line.object.description %> <span class="font-mono text-xs text-gray-500"><%= line.object.product.sku %></span>
              <span class="hint">· <%= money(line.object.unit_price_cents) %></span>
            <% else %>
              <%= line.text_field :product_code, value: line.object.product_code || line.object.product&.sku, placeholder: "Scan or type", class: "input py-1.5 font-mono", "aria-label": "Barcode or SKU" %>
            <% end %>
          </td>
          <td class="text-right"><%= line.number_field :quantity, value: plain_number(line.object.quantity), step: "any", min: 0, inputmode: "decimal", class: "input w-24 py-1.5 text-right", "aria-label": "Quantity" %></td>
          <% if cutting %>
            <td class="text-right"><%= line.number_field :cut_length, value: plain_number(line.object.cut_length), step: "any", min: 0, inputmode: "decimal", class: "input w-24 py-1.5 text-right", "aria-label": "Cut into pieces of",
                  disabled: line.object.persisted? && !line.object.product.cut_to_length? %></td>
          <% end %>
          <% if current_membership.approver? %>
            <td class="text-right"><%= line.number_field :unit_price, value: (plain_number(line.object.unit_price) if line.object.unit_price_cents.to_i.positive?), step: "0.01", inputmode: "decimal", min: 0, class: "input w-32 py-1.5 text-right", "aria-label": "Unit price" %></td>
          <% end %>
          <td class="text-right"><%= line.check_box :_destroy, class: "size-4 accent-primary-500", "aria-label": "Remove line" if line.object.persisted? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p class="hint mb-4">Prices are the customer's own (their price list and quantity breaks) and hold once saved.<%= " For steel, pipe and cable cut to length, the quantity is the total and “cut into pieces of” the length of each: 7.5 cut into 2.5 is three pieces." if cutting %></p>

  <% quote = customer_order.new_record? || customer_order.quote? %>
  <%= render "shared/more_options", open: more_fields.any? { customer_order.errors.include?(_1) }, tour: "order-more",
        summary: [ "at #{(customer_order.branch || selected_branch)&.name}",
                   (("valid until #{customer_order.valid_until ? l(customer_order.valid_until, format: :short) : "#{Current.account.quote_validity_days} days from today"}") if quote),
                   (customer_order.needed_by ? "needed by #{l(customer_order.needed_by, format: :short)}" : "no date needed"),
                   (customer_order.note.present? ? "note: #{customer_order.note.truncate(40)}" : "no note") ].compact.join(" · ") do %>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="field"><%= form.label :branch_id, "Branch", class: "label" %>
        <%= form.collection_select :branch_id, branches_for_selection, :id, :name, {}, class: "input" %></div>
      <% if quote %>
        <div class="field"><%= form.label :valid_until, "Quote valid until", class: "label" %><%= form.date_field :valid_until, class: "input" %>
          <p class="hint mt-1">Blank: <%= Current.account.quote_validity_days %> days</p></div>
      <% end %>
      <div class="field"><%= form.label :needed_by, "Needed by", class: "label" %><%= form.date_field :needed_by, class: "input" %></div>
    </div>
    <div class="field"><%= form.label :note, "Note (shown on the quote)", class: "label" %><%= form.text_field :note, class: "input", placeholder: "e.g. delivery to site included" %></div>
  <% end %>
  <div class="flex flex-wrap items-center gap-3" data-tour="order-save">
    <% if customer_order.new_record? %>
      <%= form.submit "Save quote", class: "btn-primary" %>
      <%= form.button "Save as confirmed order", name: "order_now", value: "1", class: "btn-secondary" %>
    <% else %>
      <%= form.submit "Save", class: "btn-primary" %>
    <% end %>
  </div>
<% end %>
