<% classes = { "quote" => "bg-gray-200 text-gray-500", "ordered" => "bg-gray-50 text-gray-700", "ready" => "bg-amber-100 text-amber-800",
               "collected" => "bg-green-50 text-green-800", "cancelled" => "bg-gray-200 text-gray-500 line-through" } %>
<span class="badge <%= classes[order.status] %>"><%= order.expired? ? "Quote expired" : order.status.humanize %></span>
