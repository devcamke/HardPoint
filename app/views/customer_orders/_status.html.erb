<% classes = { "quote" => "bg-concrete-200 text-steel-600", "ordered" => "bg-navy-50 text-navy-700", "ready" => "bg-safety-100 text-safety-800",
               "collected" => "bg-green-50 text-green-800", "cancelled" => "bg-concrete-200 text-steel-600 line-through" } %>
<span class="badge <%= classes[order.status] %>"><%= order.expired? ? "Quote expired" : order.status.humanize %></span>
