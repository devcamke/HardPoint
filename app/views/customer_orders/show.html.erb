<% content_for :title, "#{@customer_order.kind} #{@customer_order.reference}" %>
<% order = @customer_order %>
<% deposit = order.deposit_balance_cents %>

<p class="text-sm"><%= link_to "← Orders & quotes", customer_orders_path, class: "link" %></p>
<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-3xl font-bold"><%= order.kind %> <%= order.reference %> <%= render "customer_orders/status", order: order %></h1>
    <p class="hint mt-1"><%= link_to order.customer.name, order.customer, class: "link" %> · <%= order.branch.name %>
      · created <%= l(order.created_at, format: :short) %> by <%= order.creator&.name %>
      <%= "· valid until #{l(order.valid_until, format: :long)}" if order.quote? && order.valid_until %>
      <%= "· needed by #{l(order.needed_by, format: :long)}" if order.needed_by %></p>
    <%= tag.p("Note: #{order.note}", class: "mt-1 text-sm") if order.note.present? %>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "PDF", customer_order_path(order, format: :pdf), target: "_blank", class: "btn-secondary" %>
    <%= link_to "Edit", edit_customer_order_path(order), class: "btn-secondary" if order.editable? %>
    <%= button_to "Confirm order", customer_order_confirmation_path(order), class: "btn-secondary" if order.quote? %>
    <% if order.ordered? %>
      <%= button_to "Mark ready to collect", customer_order_readiness_path(order), class: "btn-secondary" %>
      <%= button_to "Mark ready and text #{order.customer.name.split.first}", customer_order_readiness_path(order), params: { notify: "1" }, class: "btn-secondary" if Current.account.sms_enabled? && order.customer.phone.present? %>
    <% end %>
    <% if order.collectable? %>
      <% if current_till %>
        <%= button_to "Collect at #{current_till.name}", customer_order_collection_path(order), class: "btn-primary" %>
      <% else %>
        <%= link_to "Set up this device's till to collect", new_pos_till_path, class: "btn-secondary" %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <table class="table">
      <thead><tr><th>Item</th><th class="text-right">Qty</th><th class="text-right">Unit price</th><th class="text-right">Total</th></tr></thead>
      <tbody>
        <% order.lines.includes(product: :unit, product_unit: :unit).each do |line| %>
          <tr>
            <td><%= link_to line.description, line.product, class: "hover:text-safety-700" %> <span class="font-mono text-xs text-steel-600"><%= line.product.sku %></span></td>
            <td class="text-right tabular-nums"><%= quantity(line.quantity, line.unit) %></td>
            <td class="text-right tabular-nums"><%= money(line.unit_price_cents) %></td>
            <td class="text-right tabular-nums"><%= money(line.total_cents) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="ml-auto mt-3 max-w-xs space-y-1 text-sm">
      <div class="flex justify-between text-lg font-bold"><span>Total</span><span class="tabular-nums"><%= money(order.total_cents) %></span></div>
      <div class="flex justify-between text-steel-600"><span>incl. tax</span><span class="tabular-nums"><%= money(order.tax_cents) %></span></div>
      <% if deposit.positive? && !order.collected? %>
        <div class="flex justify-between"><span>Deposit held</span><span class="tabular-nums">−<%= money(deposit) %></span></div>
        <div class="flex justify-between font-semibold"><span>To pay on collection</span><span class="tabular-nums"><%= money(order.balance_to_pay_cents) %></span></div>
      <% end %>
    </div>
  </section>

  <div class="space-y-6">
    <section class="card">
      <div class="mb-2 flex items-center justify-between">
        <h2 class="font-semibold">Deposits</h2>
        <% if order.takes_deposits? %>
          <div class="flex gap-3 text-sm">
            <%= link_to "Take deposit", new_customer_order_deposit_path(order), class: "link" %>
            <%= link_to "Refund", new_customer_order_deposit_path(order, refund: 1), class: "link" if deposit.positive? %>
          </div>
        <% end %>
      </div>
      <% if order.deposits.any? %>
        <% order.deposits.includes(:creator).each do |entry| %>
          <p class="flex justify-between text-sm"><span><%= l(entry.created_at, format: :short) %> · <%= entry.refund? ? "Refund" : "Deposit" %>, <%= entry.tender.humanize.downcase %><%= " · #{entry.reference}" if entry.reference %></span>
            <span class="tabular-nums <%= "text-red-700" if entry.refund? %>"><%= money(entry.amount_cents) %></span></p>
        <% end %>
        <p class="mt-2 flex justify-between border-t border-concrete-200 pt-2 text-sm font-semibold"><span><%= order.collected? ? "Used on collection" : "Held" %></span><span class="tabular-nums"><%= money(order.collected? ? order.deposits_paid_cents : deposit) %></span></p>
      <% else %>
        <p class="hint">None taken.<%= " Taking a deposit confirms the quote." if order.quote? %></p>
      <% end %>
    </section>

    <% if order.sales.any? %>
      <section class="card">
        <h2 class="mb-2 font-semibold">Collection</h2>
        <% order.sales.finished.each do |sale| %>
          <p class="flex justify-between text-sm"><%= link_to sale.receipt_number, sale, class: "link font-mono" %>
            <span><%= l(sale.completed_at, format: :short) %><%= " · voided" if sale.voided? %></span></p>
        <% end %>
      </section>
    <% end %>

    <section class="card">
      <h2 class="mb-2 font-semibold">Email to the customer</h2>
      <%= form_with url: customer_order_email_path(order), class: "flex gap-2" do |form| %>
        <%= form.email_field :email, value: order.customer.email, required: true, class: "input", "aria-label": "Email address" %>
        <%= form.submit "Send", class: "btn-secondary" %>
      <% end %>
    </section>

    <% if order.quote? || order.ordered? || order.ready? %>
      <%= button_to "Cancel #{order.kind.downcase}", customer_order_cancellation_path(order), class: "btn-danger w-full",
            form: { data: { turbo_confirm: deposit.positive? ? "Refund the deposit first. Cancel anyway?" : "Cancel #{order.reference}?" } } %>
    <% end %>
  </div>
</div>
