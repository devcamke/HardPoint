<% content_for :title, "Tools back · #{@hire_agreement.reference}" %>
<p class="text-sm"><%= link_to "← Hire #{@hire_agreement.reference}", @hire_agreement, class: "link" %></p>
<h1 class="mt-2 mb-1 text-3xl font-bold">Tools back</h1>
<p class="mb-6 text-steel-600">Tick what's come back now and check each one over. Charges are worked out to now.</p>

<%= form_with url: hire_agreement_return_path(@hire_agreement), class: "space-y-3" do |form| %>
  <% @hire_agreement.lines.includes(:hire_item).reject(&:returned?).each do |line| %>
    <fieldset id="<%= dom_id(line, :return) %>" class="card">
      <legend class="sr-only"><%= line.hire_item.label %></legend>
      <label class="flex items-center gap-3">
        <%= check_box_tag "returns[#{line.id}][back]", "1", true, class: "size-5" %>
        <span class="text-lg font-semibold"><%= line.hire_item.name %> <span class="font-mono text-sm text-steel-600"><%= line.hire_item.asset_tag %></span></span>
        <span class="ml-auto tabular-nums"><%= HireLine.days_between(@hire_agreement.started_at, Time.current) %> days · <%= money(line.charge_until(Time.current)) %></span>
      </label>
      <div class="mt-3 grid gap-3 sm:grid-cols-3">
        <div><%= label_tag "returns_#{line.id}_condition_note", "Condition", class: "label" %><%= text_field_tag "returns[#{line.id}][condition_note]", nil, class: "input", placeholder: "Clean, working" %></div>
        <div><%= label_tag "returns_#{line.id}_damage", "Damage charge (KES)", class: "label" %><%= text_field_tag "returns[#{line.id}][damage]", nil, inputmode: "decimal", class: "input", placeholder: "0" %></div>
        <div><%= label_tag "returns_#{line.id}_damage_note", "What's damaged", class: "label" %><%= text_field_tag "returns[#{line.id}][damage_note]", nil, class: "input" %></div>
      </div>
      <label class="mt-2 flex items-center gap-2 text-sm"><%= check_box_tag "returns[#{line.id}][needs_repair]", "1", false %> Needs repair before it goes out again</label>
    </fieldset>
  <% end %>
  <%= form.submit "Record return", class: "btn-primary" %>
<% end %>
