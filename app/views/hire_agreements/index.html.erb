<% content_for :title, "Tool hire" %>

<%= render "shared/control_panel",
      title: "Tool hire",
      new_button: [ "New", new_hire_agreement_path ],
      search: { placeholder: "Customer name or phone" },
      filters: [ search_filter(:filter, label: "Status", value: @filter, clear: "all",
                   options: HireAgreementsController::FILTERS.without("all").map { [ _1, _1 == "overdue" && @overdue_count.positive? ? "Overdue (#{@overdue_count})" : _1.humanize ] }) ],
      records: @hire_agreements %>

<div class="card overflow-x-auto">
  <% if @hire_agreements.any? %>
    <table class="table">
      <thead><tr><th>Hire</th><th>Customer</th><th>Tools</th><th>Out</th><th>Due back</th><th>Status</th></tr></thead>
      <tbody>
        <% @hire_agreements.each do |agreement| %>
          <tr id="<%= dom_id(agreement) %>">
            <td><%= link_to agreement.reference, agreement, class: "link font-mono" %></td>
            <td><%= agreement.customer.name %></td>
            <td class="text-sm"><%= agreement.lines.map { _1.hire_item.label }.to_sentence %></td>
            <td class="whitespace-nowrap"><%= l(agreement.started_at, format: :short) %></td>
            <td class="whitespace-nowrap <%= "font-semibold text-red-700" if agreement.overdue? %>"><%= l(agreement.due_back_at, format: :short) %></td>
            <td><%= render "hire_agreements/status", agreement: agreement %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500">No hires here.</p>
  <% end %>
</div>
