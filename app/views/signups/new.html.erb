<% content_for :title, "Open your shop" %>
<% content_for :description, "Open your hardware store on HardPoint: your own web address, till, stock and M-Pesa in minutes. #{Plan::TRIAL.inspect.capitalize} free, no card needed." %>

<section class="bg-white">
<div class="mx-auto max-w-xl px-4 pt-16 pb-20 sm:pt-20 sm:pb-28">
<h1 class="text-center text-4xl font-semibold tracking-tight text-gray-950 sm:text-5xl">Open your shop</h1>
<p class="mt-4 mb-10 text-center text-lg text-gray-600 text-balance">Free for <%= Plan::TRIAL.inspect %>, no card needed. Your shop's data is private to your shop.</p>

<div class="rounded-3xl bg-gray-100 p-6 sm:p-8">
  <%# Turbo can't follow the redirect to the new shop's subdomain (another origin), so submit normally. %>
  <%= form_with model: @signup, url: signup_path, data: { turbo: false, controller: "submit-once", action: "submit->submit-once#submit" } do |form| %>
    <%= render "shared/errors", model: @signup %>

    <div class="field">
      <%= form.label :shop_name, "Business name", class: "label" %>
      <%= form.text_field :shop_name, required: true, autofocus: true, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :subdomain, "Web address", class: "label" %>
      <div class="flex items-center gap-2">
        <%= form.text_field :subdomain, required: true, pattern: "[a-z0-9]+(-[a-z0-9]+)*", class: "input", placeholder: "acme" %>
        <span class="text-gray-500">.<%= request.host %></span>
      </div>
    </div>

    <div class="field">
      <%= form.label :owner_name, "Your name", class: "label" %>
      <%= form.text_field :owner_name, required: true, autocomplete: "name", class: "input" %>
    </div>

    <div class="field">
      <%= form.label :email_address, class: "label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input" %>
    </div>

    <div class="field">
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, minlength: 10, maxlength: 72, autocomplete: "new-password", class: "input" %>
    </div>

    <fieldset class="field">
      <legend class="label">Plan after the trial</legend>
      <div class="grid gap-2 sm:grid-cols-3">
        <% Plan.all.each do |plan| %>
          <label class="flex cursor-pointer flex-col rounded-2xl border border-transparent bg-white p-3 text-sm has-[:checked]:border-primary-500 has-[:checked]:ring-1 has-[:checked]:ring-primary-500">
            <span class="flex items-center gap-2 font-semibold"><%= form.radio_button :plan, plan.key %> <%= plan.name %></span>
            <span class="text-gray-500"><%= plan.price %>/month</span>
          </label>
        <% end %>
      </div>
      <p class="hint mt-1">You can change plan at any time. <%= link_to "Compare plans", pricing_path, class: "link", target: "_blank" %></p>
    </fieldset>

    <div class="field">
      <label class="flex items-start gap-2 text-sm">
        <%= form.check_box :terms_accepted, required: true, class: "mt-1" %>
        <span>I agree to the <%= link_to "terms of service", terms_path, class: "link", target: "_blank" %> and the
          <%= link_to "data processing terms", data_processing_path, class: "link", target: "_blank" %>, and I've read
          <%= link_to "how HardPoint handles data", privacy_path, class: "link", target: "_blank" %>.</span>
      </label>
    </div>

    <%= form.submit "Create my shop", class: "btn-primary w-full rounded-full py-2.5 text-base" %>
  <% end %>
</div>
<p class="mt-8 text-center text-gray-600">Already have a shop? <%= link_to new_shop_lookup_path, class: "font-medium text-accent-600 hover:underline" do %>Sign in <span aria-hidden="true">›</span><% end %></p>
</div>
</section>

<%# Someone opening a shop sees a sale before they've made one: the help centre's walkthrough of the till. %>
<section class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">While you're here</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-gray-950 text-balance sm:text-4xl">See a sale, start to finish.</h2>
      <p class="mt-4 text-lg text-gray-600 text-balance">From the first scan to the receipt, on the real screen. Press play, or tap any number.</p>
    </div>
    <div class="mt-8">
      <%= render "help/walkthrough", tour: HelpTour.find("till"),
            caption: safe_join([ "Every screen has a guide like this one: ", link_to("Selling at the till", help_article_path("selling"), class: "link"), "." ]) %>
    </div>
  </div>
</section>
