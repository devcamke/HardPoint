<% content_for :title, "Open your shop" %>

<section class="mx-auto max-w-xl px-4 py-12">
<h1 class="text-3xl font-bold">Open your shop</h1>
<p class="mt-2 mb-8 text-steel-600">Free for 30 days, no card needed. Your shop's data is private to your shop.</p>

<div class="card">
  <%# Turbo can't follow the redirect to the new shop's subdomain (another origin), so submit normally. %>
  <%= form_with model: @signup, url: signup_path, data: { turbo: false } do |form| %>
    <%= render "shared/errors", model: @signup %>

    <div class="field">
      <%= form.label :shop_name, "Business name", class: "label" %>
      <%= form.text_field :shop_name, required: true, autofocus: true, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :subdomain, "Web address", class: "label" %>
      <div class="flex items-center gap-2">
        <%= form.text_field :subdomain, required: true, pattern: "[a-z0-9]+(-[a-z0-9]+)*", class: "input", placeholder: "acme" %>
        <span class="text-steel-600">.<%= request.host %></span>
      </div>
    </div>

    <div class="field">
      <%= form.label :owner_name, "Your name", class: "label" %>
      <%= form.text_field :owner_name, required: true, autocomplete: "name", class: "input" %>
    </div>

    <div class="field">
      <%= form.label :email_address, class: "label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input" %>
    </div>

    <div class="field">
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, minlength: 10, maxlength: 72, autocomplete: "new-password", class: "input" %>
    </div>

    <fieldset class="field">
      <legend class="label">Plan after the trial</legend>
      <div class="grid gap-2 sm:grid-cols-3">
        <% Plan.all.each do |plan| %>
          <label class="flex cursor-pointer flex-col rounded-md border border-concrete-300 p-3 text-sm has-[:checked]:border-safety-500 has-[:checked]:bg-safety-50">
            <span class="flex items-center gap-2 font-semibold"><%= form.radio_button :plan, plan.key %> <%= plan.name %></span>
            <span class="text-steel-600"><%= plan.price %>/month</span>
          </label>
        <% end %>
      </div>
      <p class="hint mt-1">You can change plan at any time. <%= link_to "Compare plans", pricing_path, class: "link", target: "_blank" %></p>
    </fieldset>

    <%= form.submit "Create my shop", class: "btn-primary w-full" %>
  <% end %>
</div>
<p class="mt-6 text-center text-sm text-steel-600">Already have a shop? <%= link_to "Sign in", new_shop_lookup_path, class: "link" %></p>
</section>
