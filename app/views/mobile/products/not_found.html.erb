<%= turbo_frame_tag "scan_result" do %>
  <div class="card border-l-4 border-red-600">
    <p class="font-semibold">Nothing found for “<%= params[:code] %>”.</p>
    <p class="hint mt-1">Check the code, or search by name below. A new barcode can be added to the product in HardPoint.</p>
    <button type="button" class="btn-secondary mt-3 w-full" data-action="camera-scanner#resume">Scan again</button>
  </div>
<% end %>
