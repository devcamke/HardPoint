<p>Hi <%= @user.name %>,</p>

<p>You've been added to <strong><%= @account.name %></strong> on HardPoint as <%= @membership.role.humanize.downcase %>.</p>

<p>
  <%= link_to "Choose your password", edit_password_url(@user.generate_token_for(:invitation), subdomain: @account.subdomain) %>
  (the link expires in <%= distance_of_time_in_words(0, User::INVITATION_EXPIRES_IN) %>), then sign in at
  <%= link_to new_session_url(subdomain: @account.subdomain), new_session_url(subdomain: @account.subdomain) %>.
</p>
