<% host = { subdomain: @account.subdomain } %>
<% low_count = @low_stock.values.sum(&:size) %>
<% out_count = @out_of_stock.values.sum(&:size) + @low_stock.values.flatten.count { _1.stock_quantity <= 0 } %>
<% content_for :preheader, [ ("#{pluralize(low_count, "product")} at or below the reorder level" if low_count.positive?), ("#{out_count} out of stock" if out_count.positive?) ].compact.join(" · ") %>

<p style="margin:0; font-size:12px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:<%= mail_color(:bar) %>;">Stock to reorder</p>
<h1 style="margin:4px 0 6px; font-size:22px; line-height:1.3; color:<%= mail_color(:ink) %>;">Good morning. Here's what's running low at <%= @account.name %>.</h1>
<p style="margin:0 0 4px; font-size:14px; color:<%= mail_color(:secondary) %>;">Anything at zero can't be sold at the till until the delivery is recorded.</p>

<% @account.branches.alphabetically.each do |branch| %>
  <% low, out = @low_stock[branch].to_a, @out_of_stock[branch].to_a %>
  <% next if low.empty? && out.empty? %>
  <%= mail_section branch.name, [ ("#{pluralize(low.size, "product")} at or below the reorder level" if low.any?), ("#{out.size} more at zero with no reorder level" if out.any?) ].compact.join(", ") + "." %>
  <% if low.any? %>
    <%= mail_list [ "Product", "Left", "On hand", "Reorder at" ], low.map { |product|
          [ safe_join([ product.name, tag.span(" #{product.sku}", style: "color:#{mail_color(:muted)}; font-family:monospace; font-size:11px;") ]),
            mail_meter(product.branch_reorder_level.positive? ? product.stock_quantity / product.branch_reorder_level : 0),
            product.stock_quantity <= 0 ? mail_status(:critical, quantity(product.stock_quantity, product.unit)) : quantity(product.stock_quantity, product.unit),
            quantity(product.branch_reorder_level, product.unit) ] }, align: [ :left, :left, :right, :right ] %>
  <% end %>
  <% if out.any? %>
    <div style="height:10px;"></div>
    <%= mail_callout do %>
      <strong>Out of stock, and not on the reorder list</strong> because they have no reorder level:
      <%= out.map(&:name).to_sentence %>. Give them a reorder level on the product page to have them listed above.
    <% end %>
  <% end %>
<% end %>

<div style="height:28px;"></div>
<%= mail_button "Open the reorder list", reorder_list_url(**host) %>
