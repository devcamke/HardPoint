<% content_for :title, "Expiry" %>

<%= render "shared/control_panel",
      title: "Expiry",
      filters: [ search_filter(:filter, label: "Show", value: @filter, clear: "all",
                   options: [ [ "expiring", "Expired or expiring in #{StockBatch.expiring_within.in_days.to_i} days" ], [ "expired", "Expired" ] ]),
                 search_filter(:branch_id, label: "Branch", value: selected_branch&.id, facet: false,
                   options: branches_for_selection.map { [ _1.id, _1.name ] }) ],
      records: @batches %>

<div class="card overflow-x-auto">
  <% if @batches.any? %>
    <table class="table">
      <thead><tr><th>Product</th><th>Batch</th><th>Expiry</th><th class="text-right">Quantity</th><% if current_membership.can_see_costs? %><th class="text-right">Value at cost</th><% end %></tr></thead>
      <tbody>
        <% @batches.each do |batch| %>
          <tr id="<%= dom_id(batch) %>">
            <td><%= link_to batch.product.name, batch.product, class: "hover:text-primary-700" %></td>
            <td><%= link_to batch.number, batch, class: "link font-mono" %></td>
            <td><%= render "stock_batches/expiry", batch: batch %></td>
            <td class="text-right tabular-nums"><%= quantity(batch.quantity, batch.product.unit) %></td>
            <% if current_membership.can_see_costs? %><td class="text-right tabular-nums"><%= money(batch.value_cents) %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500"><%= @filter == "all" ? "No batches in stock at #{selected_branch.name}." : "Nothing expired or expiring soon at #{selected_branch.name}." %>
      Products are tracked by batch when <strong>Batches and expiry dates</strong> is ticked on the product.</p>
  <% end %>
</div>
<p class="hint mt-3">Sales take stock first-expiring-first, skipping expired batches. Write expired stock off from its batch page so it isn't sold.</p>
