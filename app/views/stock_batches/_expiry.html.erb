<% if batch.expired? %>
  <%= status_dot "Expired #{l(batch.expires_on, format: :long)}", :danger %>
<% elsif batch.expiring? %>
  <%= status_dot "Expires #{l(batch.expires_on, format: :long)}", :warning %>
<% elsif batch.expires_on %>
  <span class="text-sm"><%= l(batch.expires_on, format: :long) %></span>
<% else %>
  <span class="hint">No expiry date</span>
<% end %>
