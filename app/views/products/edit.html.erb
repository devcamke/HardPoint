<% content_for :title, "Edit #{@product.name}" %>

<h1 class="mb-6 text-xl font-medium"><%= link_to "#{@product.name}", @product, class: "link" %> <span class="text-gray-400">/</span> Edit product</h1>

<%= render "form", product: @product %>

<%= button_to "Delete product", @product, method: :delete, class: "btn-danger mt-6",
      form: { data: { turbo_confirm: "Delete #{@product.name}? Products with stock history can only be made inactive." } } %>
