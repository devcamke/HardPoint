<% content_for :title, @product.name %>


<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-4">
  <div class="flex items-start gap-4">
    <% if @product.image.attached? %>
      <%= image_tag @product.image, class: "size-20 rounded-lg border border-gray-200 object-cover", alt: "" %>
    <% end %>
    <div>
      <h1 class="text-xl font-medium"><%= link_to "Products", products_path, class: "link" %> <span class="text-gray-400">/</span> <%= @product.name %></h1>
      <p class="hint mt-1">
        <span class="font-mono"><%= @product.sku %></span>
        <%= " · #{@product.category.full_name}" if @product.category %>
        <%= " · #{@product.brand.name}" if @product.brand %>
        · sold by <%= @product.unit.name.downcase %>
      </p>
      <p class="mt-2 flex flex-wrap gap-1">
        <%= tag.span("Kit", class: "badge") if @product.kit? %>
        <%= tag.span("Serial numbers", class: "badge") if @product.serialized? %>
        <%= status_dot("Stock not tracked", :muted, class: "ml-2") unless @product.track_stock? || @product.kit? %>
        <%= status_dot("Inactive", :muted, class: "ml-2") unless @product.active? %>
      </p>
    </div>
  </div>
  <div class="flex gap-2">
    <%= link_to "Print labels", new_labels_path(product_ids: [ @product.id ]), class: "btn-secondary" %>
    <% if current_membership.can_manage_catalogue? %>
      <%= link_to "Edit", edit_product_path(@product), class: "btn-primary" %>
    <% end %>
  </div>
</div>

<div class="mb-6 grid gap-4 sm:grid-cols-4">
  <div class="card"><p class="hint">Price</p><p class="mt-1 text-2xl font-bold tabular-nums"><%= money(@product.price_cents) %></p><p class="hint">per <%= @product.unit.abbreviation %> · <%= @product.effective_tax_rate&.to_s || "no tax" %></p></div>
  <% if current_membership.can_see_costs? %>
    <div class="card"><p class="hint">Cost</p><p class="mt-1 text-2xl font-bold tabular-nums"><%= money(@product.cost_cents) %></p><p class="hint"><%= "#{@product.margin_percent}% margin" if @product.margin_percent %></p></div>
  <% end %>
  <div class="card"><p class="hint">On hand, all branches</p><p class="mt-1 text-2xl font-bold tabular-nums"><%= @product.kit? ? "—" : quantity(@product.stock_on_hand, @product.unit) %></p></div>
  <div class="card"><p class="hint">Reorder at</p><p class="mt-1 text-2xl font-bold tabular-nums"><%= quantity(@product.reorder_level, @product.unit) %></p></div>
</div>

<% promotions = Current.account.running_promotions.select { _1.covers?(@product) } %>
<% if promotions.any? %>
  <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900">
    On promotion: <%= safe_join(promotions.map { link_to("#{_1.name} (#{_1.offer}, until #{l(_1.ends_on, format: :short)})", _1, class: "link") }, ", ") %>
  </div>
<% end %>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="card">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Stock by branch</h2>
      <% if @product.track_stock? && current_membership.can_manage_stock? %>
        <%= link_to "Adjust stock", new_stock_adjustment_path(product_id: @product.id), class: "btn-secondary" %>
      <% end %>
    </div>
    <% own_levels = @product.track_stock? && current_membership.can_manage_catalogue? %>
    <table class="table">
      <% if own_levels %><thead><tr><th>Branch</th><th class="text-right">On hand</th><th></th><th class="text-right">Reorder at</th></tr></thead><% end %>
      <tbody>
        <% Current.account.branches.alphabetically.each do |branch| %>
          <% level = @levels[branch.id] %>
          <% stock = @product.kit? ? @product.stock_at(branch) : (level&.quantity || 0) %>
          <tr>
            <td><%= branch.name %></td>
            <td class="text-right tabular-nums"><%= quantity(stock, @product.unit) %></td>
            <td class="text-right"><%= stock_badge(@product, stock, branch, reorder_level: level&.reorder_level || @product.reorder_level) %></td>
            <% if own_levels %>
              <td class="text-right">
                <%= form_with url: product_reorder_level_path(@product), method: :patch, class: "flex items-center justify-end gap-1" do |form| %>
                  <%= hidden_field_tag :branch_id, branch.id, id: nil %>
                  <%= number_field_tag :reorder_level, plain_number(level&.reorder_level), id: nil, step: "any", min: 0, inputmode: "decimal", placeholder: plain_number(@product.reorder_level),
                        class: "input w-24 py-1 text-right", "aria-label": "Reorder level at #{branch.name}" %>
                  <%= form.submit "Set", class: "btn-secondary py-1" %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @product.kit? %>
      <p class="hint mt-2">A kit's stock is how many can be made from its parts.</p>
    <% elsif own_levels %>
      <p class="hint mt-2">A branch can reorder at its own level; blank uses the product's (<%= quantity(@product.reorder_level, @product.unit) %>).</p>
    <% end %>
  </section>

  <% if @product.tracks_batches? %>
    <%= render "stock_batches/section", product: @product %>
  <% end %>

  <% if @product.kit? %>
    <%= render "products/components/section", product: @product %>
  <% end %>

  <%= render "products/prices/section", product: @product %>
  <%= render "products/units/section", product: @product %>
  <%= render "products/barcodes/section", product: @product %>

  <% if @product.track_stock? %>
    <section class="card lg:col-span-2">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-lg font-semibold">Recent stock movements</h2>
        <%= link_to "Full history", product_movements_path(@product), class: "link text-sm" %>
      </div>
      <%= render "stock_movements/table", movements: @movements, show_product: false %>
    </section>
  <% end %>
</div>

<% if @product.description.present? %>
  <section class="card mt-6"><h2 class="mb-2 text-lg font-semibold">Description</h2><%= simple_format @product.description, class: "text-sm" %></section>
<% end %>
