<% content_for :title, "Products" %>

<%= render "shared/control_panel",
      title: "Products",
      new_button: ([ "New", new_product_path ] if current_membership.can_manage_catalogue?),
      actions: [ ([ "Import", new_product_import_path ] if current_membership.can_manage_catalogue?),
                 [ "Export CSV", products_path(request.query_parameters.merge(format: :csv)), { data: { turbo: false } } ],
                 [ "Print labels", new_labels_path(query: params[:query], category_id: params[:category_id]) ] ].compact,
      search: { placeholder: "Search name, SKU or scan a barcode", autofocus: true },
      filters: [ search_filter(:category_id, label: "Category", value: params[:category_id],
                   options: Current.account.categories.alphabetically.map { [ _1.id, _1.full_name ] }),
                 search_filter(:include_inactive, options: [ [ "1", "Include inactive" ] ], value: params[:include_inactive]),
                 search_filter(:branch_id, label: "Stock at", value: selected_branch&.id, facet: false,
                   options: branches_for_selection.map { [ _1.id, _1.name ] }) ],
      records: @products %>

<%= turbo_frame_tag "products", data: { turbo_action: "advance" } do %>
  <div class="card overflow-x-auto p-0">
    <% if @products.any? %>
      <table class="table">
        <thead>
          <tr class="[&>th:first-child]:pl-6"><th>Product</th><th>SKU</th><th>Category</th><th class="text-right">Price</th><th class="text-right">Stock at <%= selected_branch&.name %></th><th></th></tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <% stock = product.kit? ? product.stock_at(selected_branch) : @stock.fetch(product.id, 0) %>
            <tr id="<%= dom_id(product) %>" class="[&>td:first-child]:pl-6">
              <td>
                <%= link_to product.name, product, class: "font-medium hover:text-primary-700", data: { turbo_frame: "_top" } %>
                <%= tag.span("Kit", class: "badge ml-1") if product.kit? %>
                <%= tag.span("Inactive", class: "badge ml-1 bg-gray-200 text-gray-500") unless product.active? %>
              </td>
              <td class="font-mono text-xs"><%= product.sku %></td>
              <td><%= product.category&.name %></td>
              <td class="text-right tabular-nums"><%= money(product.price_cents) %></td>
              <td class="text-right tabular-nums"><%= quantity(stock, product.unit) if product.track_stock? || product.kit? %></td>
              <td class="pr-6 text-right"><%= stock_badge(product, stock, selected_branch) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint p-6"><%= params[:query].present? ? "Nothing matches “#{params[:query]}”." : "No products yet. Add one or import a spreadsheet." %></p>
    <% end %>
  </div>
<% end %>
