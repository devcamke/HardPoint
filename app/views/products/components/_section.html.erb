<section class="card">
  <h2 class="mb-3 text-lg font-semibold">Kit contents</h2>
  <table class="table mb-4">
    <tbody>
      <% product.kit_components.includes(component: :unit).each do |part| %>
        <tr>
          <td><%= link_to part.component.name, part.component, class: "hover:text-safety-700" %></td>
          <td class="text-right tabular-nums"><%= quantity(part.quantity, part.component.unit) %></td>
          <td class="text-right"><%= button_to "Remove", product_component_path(product, part), method: :delete, class: "link text-xs" if current_membership.can_manage_catalogue? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if current_membership.can_manage_catalogue? %>
    <%= form_with url: product_components_path(product), scope: :kit_component, class: "flex flex-wrap items-end gap-2" do |form| %>
      <div class="flex-1"><%= form.label :product_code, "Barcode or SKU", class: "label" %><%= form.text_field :product_code, required: true, class: "input font-mono" %></div>
      <div class="w-24"><%= form.label :quantity, class: "label" %><%= form.number_field :quantity, value: 1, step: "any", min: 0, class: "input" %></div>
      <%= form.submit "Add", class: "btn-secondary" %>
    <% end %>
  <% end %>
</section>
