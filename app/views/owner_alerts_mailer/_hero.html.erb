<%# locals: (eyebrow:, headline:, figure:, note: nil) %>
<p style="margin:0; font-size:12px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:<%= mail_color(:critical) %>;"><%= mail_status :critical, eyebrow %></p>
<h1 style="margin:6px 0 14px; font-size:21px; line-height:1.3; color:<%= mail_color(:ink) %>;"><%= headline %></h1>
<p style="margin:0; font-size:34px; line-height:1.15; font-weight:800; color:<%= mail_color(:ink) %>; letter-spacing:-.02em;"><%= figure %></p>
<% if note %><p style="margin:4px 0 0; font-size:13px; color:<%= mail_color(:secondary) %>;"><%= note %></p><% end %>
<div style="height:18px;"></div>
