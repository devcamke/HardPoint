<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%# A light design on purpose: mail apps darken emails in their own ways, and these colours survive it. %>
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <%# Phones: tiles stack and the margins narrow. Mail apps without media queries keep the desktop layout. %>
    <style>
      @media only screen and (max-width: 520px) {
        .mail-outer { padding: 12px 6px !important; }
        .mail-body { padding: 22px 16px !important; }
        .mail-tile { display: block !important; width: auto !important; margin-bottom: 8px !important; }
        .mail-tile-gap { display: none !important; }
      }
    </style>
  </head>

  <body style="margin:0; background:#F3F4F6; font-family:-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#1F2937; line-height:1.5;">
    <% if content_for?(:preheader) %>
      <%# The line a mail app shows beside the subject in the inbox. %>
      <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;"><%= yield :preheader %>&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>
    <% end %>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" class="mail-outer" style="background:#F3F4F6; padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellspacing="0" cellpadding="0" style="max-width:600px; width:100%;">
            <tr>
              <td style="background:#0F5E6E; padding:16px 28px; border-radius:10px 10px 0 0; font-size:20px; font-weight:800; color:#FFFFFF; letter-spacing:-.01em;">
                HardPoint
              </td>
            </tr>
            <tr>
              <td class="mail-body" style="background:#FFFFFF; padding:28px; border:1px solid #E7E5E0; border-top:0; border-radius:0 0 10px 10px; font-size:15px;">
                <%= yield %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
