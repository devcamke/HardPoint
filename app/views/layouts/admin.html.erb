<!DOCTYPE html>
<html>
  <head>
    <title><%= [ content_for(:title), "HardPoint Admin" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-concrete-100 text-navy-900">
    <nav class="bg-navy-950 text-navy-100">
      <div class="mx-auto flex max-w-5xl items-center gap-4 px-4 py-3 text-sm">
        <%= link_to admin_root_path, class: "flex items-center gap-3" do %>
          <%= render "shared/logo", dark: true %>
          <span class="badge bg-safety-500 text-navy-900">Platform admin</span>
        <% end %>
        <% if current_administrator %>
          <%= link_to "Shops", admin_accounts_path, class: "hover:text-white" %>
          <%= link_to "Support", admin_support_requests_path, class: "hover:text-white" %>
          <%= link_to "Announcements", admin_announcements_path, class: "hover:text-white" %>
          <%= link_to "Database", admin_database_path, class: "hover:text-white" %>
          <span class="ml-auto"><%= current_administrator.name %></span>
          <%= button_to "Sign out", admin_session_path, method: :delete, class: "cursor-pointer hover:text-white" %>
        <% end %>
      </div>
    </nav>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
