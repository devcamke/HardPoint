<!DOCTYPE html>
<html lang="en">
  <head>
    <% title = content_for?(:title) ? "#{content_for(:title)} · HardPoint" : "HardPoint · Point of sale and stock control for hardware stores in Kenya" %>
    <% description = content_for(:description) || "Point of sale, stock control, M-Pesa, Airtel Money and KRA eTIMS for hardware stores in Kenya. The till works offline. #{Plan::TRIAL.inspect.capitalize} free, no card needed." %>
    <%# One address per page for search engines: no query strings (help searches, signup's plan, tracking links). %>
    <% canonical = request.base_url + request.path %>
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="<%= canonical %>">
    <% if content_for?(:noindex) %><meta name="robots" content="noindex"><% end %>
    <meta name="theme-color" content="#0F5E6E">

    <%# How a link looks when shared on WhatsApp, Facebook, LinkedIn or X. %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="HardPoint">
    <meta property="og:locale" content="en_KE">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= canonical %>">
    <meta property="og:image" content="<%= image_url("marketing/dashboard.png") %>">
    <meta property="og:image:width" content="1280">
    <meta property="og:image:height" content="800">
    <meta property="og:image:alt" content="The HardPoint dashboard: today's takings, sales, margin and what needs doing">
    <meta name="twitter:card" content="summary_large_image">
    <%= yield :structured_data %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-gray-50 text-gray-900">
    <%= render "shared/staging_banner" %>
    <header class="border-b border-gray-200 bg-white">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4 text-sm font-medium">
        <%= link_to marketing_root_path, aria: { label: "HardPoint home" } do %><%= render "shared/logo" %><% end %>
        <div class="ml-auto flex flex-wrap items-center gap-x-5 gap-y-2">
          <%= link_to "Features", marketing_root_path(anchor: "features"), class: "hover:text-primary-600" %>
          <%= link_to "Pricing", pricing_path, class: "hover:text-primary-600" %>
          <%= link_to "Help", help_path, class: "hover:text-primary-600" %>
          <%= link_to "Sign in", new_shop_lookup_path, class: "hover:text-primary-600" %>
          <%= link_to "Start free trial", new_signup_path, class: "btn-primary" %>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <div class="mx-auto max-w-6xl px-4"><%= render "shared/flash" %></div>
      <%= yield %>
    </main>

    <footer class="border-t border-gray-200 bg-gray-100 text-gray-700">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <%= render "shared/logo" %>
          <p class="mt-3 text-gray-600">Point of sale and stock control for hardware stores in Kenya.</p>
        </div>
        <ul class="space-y-2">
          <li><%= link_to "Pricing", pricing_path, class: "hover:text-primary-600" %></li>
          <li><%= link_to "Help centre", help_path, class: "hover:text-primary-600" %></li>
          <li><%= link_to "API for developers", developer_docs_path, class: "hover:text-primary-600" %></li>
          <li><%= link_to "Service level agreement", sla_path, class: "hover:text-primary-600" %></li>
        </ul>
        <ul class="space-y-2">
          <li><%= link_to "Privacy and your data", privacy_path, class: "hover:text-primary-600" %></li>
          <li><%= link_to "Terms of service", terms_path, class: "hover:text-primary-600" %></li>
          <li><%= link_to "Data processing terms", data_processing_path, class: "hover:text-primary-600" %></li>
        </ul>
        <ul class="space-y-2">
          <li><%= link_to "WhatsApp us", whatsapp_support_url, class: "hover:text-primary-600", target: "_blank", rel: "noopener" %></li>
          <li><%= mail_to Rails.configuration.x.support[:email], nil, class: "hover:text-primary-600" %></li>
          <li class="text-gray-600">© <%= Date.current.year %> HardPoint</li>
        </ul>
      </div>
    </footer>
  </body>
</html>
