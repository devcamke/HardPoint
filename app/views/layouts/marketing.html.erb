<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "HardPoint · Point of sale for hardware stores" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Point of sale, stock control, M-Pesa and KRA eTIMS for Kenyan hardware stores. Works offline. 30-day free trial." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-concrete-50 text-navy-900">
    <header class="border-b border-concrete-200 bg-white">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4 text-sm font-medium">
        <%= link_to marketing_root_path, aria: { label: "HardPoint home" } do %><%= render "shared/logo" %><% end %>
        <div class="ml-auto flex flex-wrap items-center gap-x-5 gap-y-2">
          <%= link_to "Features", marketing_root_path(anchor: "features"), class: "hover:text-safety-600" %>
          <%= link_to "Pricing", pricing_path, class: "hover:text-safety-600" %>
          <%= link_to "Help", help_path, class: "hover:text-safety-600" %>
          <%= link_to "Sign in", new_shop_lookup_path, class: "hover:text-safety-600" %>
          <%= link_to "Start free trial", new_signup_path, class: "btn-primary" %>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <div class="mx-auto max-w-6xl px-4"><%= render "shared/flash" %></div>
      <%= yield %>
    </main>

    <footer class="bg-navy-950 text-navy-200">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm sm:grid-cols-3">
        <div>
          <%= render "shared/logo", dark: true %>
          <p class="mt-3 text-navy-300">Point of sale and stock control for hardware stores in Kenya.</p>
        </div>
        <ul class="space-y-2">
          <li><%= link_to "Pricing", pricing_path, class: "hover:text-white" %></li>
          <li><%= link_to "Help centre", help_path, class: "hover:text-white" %></li>
          <li><%= link_to "Privacy and your data", privacy_path, class: "hover:text-white" %></li>
          <li><%= link_to "API for developers", developer_docs_path, class: "hover:text-white" %></li>
        </ul>
        <ul class="space-y-2">
          <li><%= link_to "WhatsApp us", whatsapp_support_url, class: "hover:text-white", target: "_blank", rel: "noopener" %></li>
          <li><%= mail_to Rails.configuration.x.support[:email], nil, class: "hover:text-white" %></li>
          <li class="text-navy-400">© <%= Date.current.year %> HardPoint</li>
        </ul>
      </div>
    </footer>
  </body>
</html>
