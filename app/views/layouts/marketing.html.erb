<!DOCTYPE html>
<html lang="en-KE">
  <head>
    <% title = content_for?(:title) ? "#{content_for(:title)} · HardPoint" : "HardPoint · Point of sale and stock control for hardware stores in Kenya" %>
    <% description = content_for(:description) || "Point of sale, stock control, M-Pesa, Airtel Money and KRA eTIMS for hardware stores in Kenya. The till works offline. #{Plan::TRIAL.inspect.capitalize} free, no card needed." %>
    <%# One address per page for search engines: no query strings (help searches, signup's plan, tracking links). %>
    <% canonical = request.base_url + request.path %>
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="<%= canonical %>">
    <%# Written for Kenya, and the only version for everyone else too. %>
    <link rel="alternate" hreflang="en-KE" href="<%= canonical %>">
    <link rel="alternate" hreflang="x-default" href="<%= canonical %>">
    <meta name="geo.region" content="KE">
    <meta name="geo.placename" content="Kenya">
    <% if content_for?(:noindex) %><meta name="robots" content="noindex"><% end %>
    <%# The public site follows the device's light or dark setting (landing.css); the app stays light. %>
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0B181B" media="(prefers-color-scheme: dark)">

    <%# How a link looks when shared on WhatsApp, Facebook, LinkedIn or X. %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="HardPoint">
    <meta property="og:locale" content="en_KE">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= canonical %>">
    <meta property="og:image" content="<%= image_url("marketing/dashboard.png") %>">
    <meta property="og:image:width" content="1280">
    <meta property="og:image:height" content="800">
    <meta property="og:image:alt" content="The HardPoint dashboard: today's takings, sales, margin and what needs doing">
    <meta name="twitter:card" content="summary_large_image">
    <%= yield :structured_data %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="lp-site flex min-h-screen flex-col bg-(--lp-page) text-(--lp-ink)">
    <%= render "shared/staging_banner" %>
    <%# The main nav is white, with the logo in teal, the links large and near-black, and the trial as a solid teal button
        lightly shaded top to bottom.
        Logo on the left, the page links centred, sign in and the trial on the right. On a phone it stays one row: the logo, a
        shorter trial button and a menu button that opens the page links and sign in underneath. %>
    <header class="sticky top-0 z-40 border-b border-(--lp-line) bg-(--lp-page) text-(--lp-ink)">
      <nav class="relative mx-auto flex max-w-[1180px] items-center justify-between gap-x-3 px-4 py-3 text-lg font-medium md:grid md:grid-cols-[1fr_auto_1fr] md:gap-x-6"
           data-controller="dropdown" data-action="click@window->dropdown#closeOnOutsideClick keydown.esc@window->dropdown#close">
        <% nav_link = "whitespace-nowrap text-(--lp-body) transition-colors hover:text-(--lp-ink)" %>
        <% menu_link = "block border-b border-(--lp-line) py-3 text-(--lp-body) last:border-0 hover:text-(--lp-teal)" %>
        <%= link_to marketing_root_path, aria: { label: "HardPoint home" }, class: "md:justify-self-start" do %><%= render "shared/logo" %><% end %>
        <div class="flex items-center gap-x-6 max-md:hidden">
          <%= link_to "Features", marketing_root_path(anchor: "features"), class: nav_link %>
          <%= link_to "Pricing", pricing_path, class: nav_link %>
          <%= link_to "Help", help_path, class: nav_link %>
        </div>
        <div class="flex items-center gap-x-2 md:justify-self-end md:gap-x-5 lg:gap-x-8">
          <%= link_to "Sign in", new_shop_lookup_path, class: "#{nav_link} max-md:hidden" %>
          <%= link_to new_signup_path, class: "btn rounded-full border-2 border-(--lp-btn) bg-(--lp-btn) px-4 py-2 text-base font-bold text-white hover:border-(--lp-btn-hover) hover:bg-(--lp-btn-hover) md:px-6 md:py-2.5" do %>
            <span class="md:hidden">Start free</span><span class="max-md:hidden">Start now, it's free</span>
          <% end %>
          <button type="button" class="flex size-11 cursor-pointer items-center justify-center rounded-md text-(--lp-ink) hover:bg-(--lp-card) md:hidden"
                  aria-label="Menu" aria-expanded="false" aria-controls="site-menu" data-dropdown-target="toggle" data-action="dropdown#toggle">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
        <div id="site-menu" hidden data-dropdown-target="menu" data-action="click->dropdown#close"
             class="absolute inset-x-0 top-full border-b border-(--lp-line) bg-(--lp-page) px-4 py-1 shadow-lg md:hidden">
          <%= link_to "Features", marketing_root_path(anchor: "features"), class: menu_link %>
          <%= link_to "Pricing", pricing_path, class: menu_link %>
          <%= link_to "Help", help_path, class: menu_link %>
          <%= link_to "Sign in", new_shop_lookup_path, class: menu_link %>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <div class="mx-auto max-w-[1180px] px-4"><%= render "shared/flash" %></div>
      <%= yield %>
    </main>

    <%# The footer in the landing page's manner: white under a 2 px ink rule, the logo with a handwritten line,
        columns headed in the headline face, ink links underlined on hover, and the year on a rule of its own. %>
    <% footer_link = "inline-block py-1.5 text-(--lp-ink) underline-offset-4 decoration-2 decoration-(--lp-teal) hover:underline sm:py-0.5" %>
    <% footer_heading = "font-display text-lg font-bold tracking-[-0.01em] text-(--lp-ink)" %>
    <footer class="border-t-2 border-(--lp-edge) bg-(--lp-page) text-[15px] text-(--lp-ink)">
      <div class="mx-auto grid max-w-[1180px] grid-cols-2 gap-x-8 gap-y-10 px-4 pt-10 pb-8 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
        <div class="col-span-2 lg:col-span-1">
          <%= render "shared/logo" %>
          <p class="mt-4 max-w-[17rem] font-hand text-xl leading-snug text-(--lp-teal) -rotate-1">Point of sale and stock control for hardware stores in Kenya.</p>
          <%= link_to "Try it free for #{Plan::TRIAL.inspect}", new_signup_path, class: "mt-6 inline-flex items-center gap-2 rounded-full border-2 border-(--lp-btn) bg-(--lp-btn) px-5 py-2.5 text-[15px] font-bold text-white transition hover:-translate-y-0.5 hover:border-(--lp-btn-hover) hover:bg-(--lp-btn-hover) motion-reduce:transition-none motion-reduce:hover:translate-y-0" %>
        </div>
        <nav aria-labelledby="footer-product">
          <h2 id="footer-product" class="<%= footer_heading %>">The product</h2>
          <ul class="mt-3 space-y-1">
            <li><%= link_to "Pricing", pricing_path, class: footer_link %></li>
            <% SolutionPage.all.each do |page| %>
              <li><%= link_to page.label, solution_path(page), class: footer_link %></li>
            <% end %>
            <li><%= link_to "API for developers", developer_docs_path, class: footer_link %></li>
          </ul>
        </nav>
        <nav aria-labelledby="footer-trust">
          <h2 id="footer-trust" class="<%= footer_heading %>">Your data and the fine print</h2>
          <ul class="mt-3 space-y-1">
            <li><%= link_to "Privacy and your data", privacy_path, class: footer_link %></li>
            <li><%= link_to "Data processing terms", data_processing_path, class: footer_link %></li>
            <li><%= link_to "Service level agreement", sla_path, class: footer_link %></li>
            <li><%= link_to "Terms of service", terms_path, class: footer_link %></li>
          </ul>
        </nav>
        <nav aria-labelledby="footer-help" class="col-span-2 sm:col-span-1">
          <h2 id="footer-help" class="<%= footer_heading %>">Talk to a person</h2>
          <ul class="mt-3 space-y-1">
            <li><%= link_to "WhatsApp us", whatsapp_support_url, class: footer_link, target: "_blank", rel: "noopener" %></li>
            <li><%= mail_to Rails.configuration.x.support[:email], nil, class: footer_link %></li>
            <li><%= link_to "Help centre", help_path, class: footer_link %></li>
          </ul>
        </nav>
      </div>
      <div class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-(--lp-line) px-4 py-5 text-sm text-(--lp-muted)">
        <p>© <%= Date.current.year %> HardPoint</p>
        <p class="font-hand text-base text-(--lp-teal)">No card needed · nothing to install · the till keeps selling offline</p>
      </div>
    </footer>
  </body>
</html>
