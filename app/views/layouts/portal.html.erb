<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), Current.account.name ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app %>
    <%= render "shared/theme" %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-800">
    <header class="bg-primary-700 text-white">
      <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-4">
        <% if Current.account.logo.attached? %>
          <%= image_tag Current.account.logo.variant(resize_to_limit: [ 240, 80 ]), alt: "", class: "h-10 w-auto rounded bg-white p-1" %>
        <% end %>
        <div>
          <p class="text-lg font-bold leading-tight"><%= Current.account.name %></p>
          <% if @customer %><p class="text-sm text-white">Account of <%= @customer.name %></p><% end %>
        </div>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-3xl space-y-4 px-4 py-6">
      <% if (message = flash[:alert] || flash[:notice]) %>
        <p role="<%= flash[:alert] ? "alert" : "status" %>" class="rounded border px-4 py-3 text-sm <%= flash[:alert] ? "border-red-200 bg-red-50 text-red-800" : "border-primary-200 bg-primary-50 text-primary-900" %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>

    <footer class="mx-auto max-w-3xl px-4 pb-8 text-sm text-gray-600">
      <% branch = Current.account.branches.alphabetically.first %>
      <p><%= [ Current.account.name, branch&.address, (PhoneNumber.display(branch.phone) if branch&.phone.present?) ].compact_blank.join(" · ") %></p>
      <p class="mt-1">This page is only for you: anyone with the link can open it, so don't share it.</p>
    </footer>
  </body>
</html>
