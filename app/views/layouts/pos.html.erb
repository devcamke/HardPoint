<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), current_till&.name, Current.account.name ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="HardPoint Till">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/favicon" %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <meta name="qz-tray-src" content="<%= asset_path("qz-tray.js") %>">
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= render "shared/theme" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex h-dvh flex-col overflow-hidden bg-gray-100 text-gray-900" data-controller="shortcuts offline-sync" data-action="keydown@window->shortcuts#handle"
        data-offline-sync-catalogue-url-value="<%= pos_catalogue_path %>" data-offline-sync-sales-url-value="<%= pos_offline_sales_path %>"
        data-offline-sync-token-url-value="<%= new_pos_offline_sale_path %>" data-offline-sync-offline-url-value="<%= pos_offline_path %>"
        data-offline-sync-till-url-value="<%= pos_path %>" data-offline-sync-offline-page-value="<%= controller_name == "offlines" %>">
    <header class="flex h-12 shrink-0 items-center gap-3 whitespace-nowrap bg-primary-500 px-3 text-sm text-white/85 sm:gap-4 sm:px-4">
      <%= link_to root_path(home: 1), title: "Back to HardPoint", "aria-label": "Back to HardPoint", class: "max-sm:[&>span>span]:hidden" do %><%= render "shared/logo", dark: true %><% end %>
      <span class="truncate font-semibold text-white"><%= current_till&.name %></span>
      <span class="hidden lg:inline"><%= current_till&.branch&.name %></span>
      <% if current_shift %>
        <%= link_to "Shift", shift_path(current_shift), class: "rounded bg-white/15 px-2 py-1 hover:bg-white/25 hover:text-white" %>
      <% end %>
      <%= link_to "Sales", sales_path, class: "hover:text-white" %>
      <div class="ml-auto flex items-center gap-3 sm:gap-4">
        <%# A dot for the connection, drawn in CSS so it survives the controller rewriting the text. %>
        <span class="inline-flex items-center gap-1.5 text-xs before:size-2 before:rounded-full before:bg-gray-400 data-[state=online]:before:bg-green-400 data-[state=offline]:text-amber-200 data-[state=offline]:before:bg-amber-400"
              data-offline-sync-target="status" role="status" aria-live="polite">Checking…</span>
        <% if current_till&.print_mode == "qz_tray" %>
          <details class="relative" data-controller="receipt-printer"
                   data-receipt-printer-till-value="<%= current_till.slice(:print_mode, :printer_name, :receipt_width).to_json %>"
                   data-receipt-printer-drawer-url-value="<%= pos_drawer_openings_path %>">
            <summary class="cursor-pointer list-none hover:text-white">Open drawer</summary>
            <div class="absolute right-0 z-50 mt-2 w-60 rounded bg-white p-2 text-gray-800 shadow-lg" role="menu">
              <p class="px-2 pb-1 text-xs text-gray-600">Why, without a sale? It's recorded.</p>
              <% Pos::DrawerOpeningsController::REASONS.each do |reason| %>
                <button type="button" role="menuitem" class="block w-full rounded px-2 py-1.5 text-left text-sm hover:bg-gray-100"
                        data-action="receipt-printer#openDrawer" data-receipt-printer-reason-param="<%= reason %>"><%= reason %></button>
              <% end %>
            </div>
          </details>
        <% end %>
        <span class="hidden text-xs text-white/70 xl:inline pointer-coarse:hidden" data-tour="shortcuts">F2 scan · F8 park · F9 pay</span>
        <%= link_to new_session_switch_path, class: "hover:text-white" do %>Switch<span class="hidden sm:inline"> user</span><% end %>
        <span class="hidden font-semibold text-white md:inline"><%= Current.user.name %></span>
      </div>
    </header>
    <%= render "shared/impersonation_banner" if Current.session.impersonated? %>
    <%= render "shared/subscription_banner" %>
    <%= render "shared/announcements" %>
    <%= render "shared/guided_tour" %>
    <div hidden class="bg-amber-300 px-4 py-2 text-sm font-semibold text-gray-900" data-offline-sync-target="banner">
      <% if controller_name == "offlines" %>
        You're back online and every offline sale has been sent. <%= link_to "Go back to the till", pos_path, class: "underline" %>
      <% else %>
        The till can't reach HardPoint. <%= link_to "Keep selling on the offline till", pos_offline_path, class: "underline", data: { turbo: false } %>
      <% end %>
    </div>
    <main class="contents">
      <h1 class="sr-only">Till</h1>
      <%= yield %>
    </main>
  </body>
</html>
