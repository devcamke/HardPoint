<!DOCTYPE html>
<html>
  <head>
    <title><%= [ content_for(:title), current_till&.name, Current.account.name ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="HardPoint Till">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-screen overflow-hidden bg-concrete-100 text-navy-900" data-controller="shortcuts" data-action="keydown@window->shortcuts#handle">
    <header class="flex h-13 items-center gap-4 bg-navy-900 px-4 text-sm text-navy-100">
      <%= link_to root_path, title: "Back to HardPoint" do %><%= render "shared/logo", dark: true %><% end %>
      <span class="font-semibold text-white"><%= current_till&.name %></span>
      <span class="hidden sm:inline"><%= current_till&.branch&.name %></span>
      <% if current_shift %>
        <%= link_to "Shift", shift_path(current_shift), class: "rounded bg-navy-800 px-2 py-1 hover:text-white" %>
      <% end %>
      <%= link_to "Sales", sales_path, class: "hover:text-white" %>
      <div class="ml-auto flex items-center gap-4">
        <span class="hidden text-xs text-navy-300 md:inline">F2 scan · F8 park · F9 pay</span>
        <%= link_to "Switch user", new_session_switch_path, class: "hover:text-white" %>
        <span class="font-semibold text-white"><%= Current.user.name %></span>
      </div>
    </header>
    <%= render "shared/impersonation_banner" if Current.session.impersonated? %>
    <%= yield %>
  </body>
</html>
