<% content_for :title, "Stock movements" %>

<%= render "shared/control_panel",
      title: "Stock movements",
      filters: [ search_filter(:reason, label: "Reason", value: params[:reason],
                   options: StockMovement::REASONS.map { [ _1, _1.humanize ] }),
                 search_filter(:all_branches, options: [ [ "1", "All branches" ] ], value: params[:all_branches]),
                 search_filter(:branch_id, label: "Branch", value: selected_branch&.id, facet: false,
                   options: branches_for_selection.map { [ _1.id, _1.name ] }) ],
      records: @movements %>

<div class="card"><%= render "stock_movements/table", movements: @movements, show_product: true %></div>
