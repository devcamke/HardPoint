<%# The shelf price, or the promotion price with the old one struck through. %>
<% promotion, offer = product.promotion_price %>
<% if promotion %>
  <span class="<%= local_assigns[:size] || "text-lg" %> font-bold tabular-nums text-red-700"><%= money(offer) %></span>
  <s class="text-sm text-steel-600 tabular-nums"><%= money(product.price_cents) %></s>
  <span class="badge ml-1 bg-red-50 text-red-800"><%= promotion.offer %></span>
<% else %>
  <span class="<%= local_assigns[:size] || "text-lg" %> font-bold tabular-nums"><%= money(product.price_cents) %></span>
<% end %>
