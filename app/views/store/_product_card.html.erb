<%# locals: (product:) %>
<% branches = (@collection_branches ||= storefront.collection_branches.to_a) %>
<% status, _, branch = storefront.best_availability(product, branches) %>
<article id="<%= dom_id(product) %>" class="flex flex-col overflow-hidden rounded-lg border border-concrete-200 bg-white">
  <%= link_to store_product_path(product), class: "block aspect-square bg-concrete-100" do %>
    <% if product.image.attached? %>
      <%= image_tag product.image, alt: product.name, loading: "lazy", class: "size-full object-cover" %>
    <% else %>
      <span class="flex size-full items-center justify-center text-4xl font-extrabold text-concrete-300" aria-hidden="true"><%= product.name.first %></span>
    <% end %>
  <% end %>
  <div class="flex flex-1 flex-col p-3">
    <h2 class="text-sm font-semibold leading-snug"><%= link_to product.name, store_product_path(product), class: "hover:text-safety-700" %></h2>
    <p class="mt-1 text-lg font-bold tabular-nums"><%= money(product.price_cents) %> <span class="text-xs font-normal text-steel-600">/ <%= product.unit.name.downcase %></span></p>
    <p class="mt-auto pt-2 text-xs"><%= render "store/availability", product: product, branch: branch %><%= " at #{branch.name}" if branches.many? && status.in?(%i[ in_stock low ]) %></p>
  </div>
</article>
