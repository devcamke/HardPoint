<% content_for :title, "Close shift" %>

<p class="text-sm"><%= link_to "← Shift", shift_path(@shift), class: "link" %></p>
<h1 class="mt-2 mb-2 text-3xl font-bold">Close shift</h1>
<p class="hint mb-6">Count all the cash in the drawer and enter the total. You'll see if it balances after closing.</p>

<%= form_with url: shift_closing_path(@shift), class: "card max-w-md", data: { turbo_confirm: "Close the shift? You won't be able to sell on this till until a new one is opened." } do |form| %>
  <% if flash.now[:alert] %><p id="alert" class="mb-4 rounded-md bg-red-50 px-4 py-2 text-sm text-red-800"><%= flash.now[:alert] %></p><% end %>
  <div class="field">
    <%= form.label :counted_cash, "Cash counted (#{Current.account.currency})", class: "label" %>
    <%= form.number_field :counted_cash, step: "0.01", min: 0, required: true, autofocus: true, class: "input text-2xl" %>
  </div>
  <div class="field">
    <%= form.label :note, class: "label" %>
    <%= form.text_field :note, class: "input", placeholder: "Anything the manager should know" %>
  </div>
  <%= form.submit "Close shift", class: "btn-primary w-full" %>
<% end %>
