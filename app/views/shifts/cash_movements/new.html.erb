<% content_for :title, "Cash drop or payout" %>

<p class="text-sm"><%= link_to "← Shift", shift_path(@shift), class: "link" %></p>
<h1 class="mt-2 mb-6 text-3xl font-bold">Cash in or out of the drawer</h1>

<%= form_with model: @movement, url: shift_cash_movements_path(@shift), class: "card max-w-md" do |form| %>
  <%= render "shared/errors", model: @movement %>
  <fieldset class="field space-y-2">
    <legend class="label">What's happening?</legend>
    <% { "drop" => "Drop to the safe (takings leave the drawer)", "payout" => "Pay out (e.g. transport, a supplier)", "pay_in" => "Pay in (more change for the float)" }.each do |kind, label| %>
      <label class="flex items-center gap-2 text-sm"><%= form.radio_button :kind, kind, class: "accent-safety-500" %> <%= label %></label>
    <% end %>
  </fieldset>
  <div class="field">
    <%= form.label :amount, "Amount (#{Current.account.currency})", class: "label" %>
    <%= form.number_field :amount, step: "0.01", min: 0, required: true, class: "input" %>
  </div>
  <div class="field">
    <%= form.label :reason, class: "label" %>
    <%= form.text_field :reason, required: true, class: "input", placeholder: "e.g. Lunchtime drop, envelope 3" %>
  </div>
  <%= form.submit "Record", class: "btn-primary" %>
<% end %>
