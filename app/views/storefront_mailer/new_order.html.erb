<p><strong><%= @order.customer.name %></strong> (<%= PhoneNumber.display(@order.customer.phone) %><%= ", #{@order.customer.email}" if @order.customer.email.present? %>)
  ordered online for collection at <strong><%= @order.branch.name %></strong>.</p>
<% if @order.note.present? %><p>Note: <em><%= @order.note %></em></p><% end %>
<%= render "lines", order: @order %>
<p style="margin-top:24px;"><%= link_to "Open order #{@order.reference}", customer_order_url(@order, subdomain: @account.subdomain), style: "display:inline-block; background:#F76707; color:#102A43; padding:10px 16px; border-radius:6px; font-weight:700; text-decoration:none;" %></p>
<p>Mark it ready when it's packed and the customer gets a text.</p>
