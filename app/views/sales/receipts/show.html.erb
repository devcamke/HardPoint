<div class="receipt">
  <p class="center bold big"><%= Current.account.name %></p>
  <p class="center"><%= @sale.branch.name %><%= tag.br + @sale.branch.address if @sale.branch.address.present? %><%= tag.br + "Tel #{@sale.branch.phone}" if @sale.branch.phone.present? %></p>
  <hr>
  <div class="row"><span>Receipt</span><span class="bold"><%= @sale.receipt_number %></span></div>
  <div class="row"><span><%= l(@sale.completed_at || @sale.created_at, format: :short) %></span><span><%= @sale.register.name %></span></div>
  <div class="row"><span>Served by</span><span><%= @sale.cashier.name %></span></div>
  <% if @sale.customer %><div class="row"><span>Customer</span><span><%= @sale.customer.name %></span></div><% end %>
  <% if @sale.job %><p>Job: <%= @sale.job.label %></p><% end %>
  <% if @sale.voided? %><p class="center bold">*** VOIDED ***</p><% end %>
  <hr>
  <% @sale.lines.includes(:product, :promotion, product_unit: :unit).each do |line| %>
    <div class="item">
      <div><%= line.description %></div>
      <div class="row muted"><span><%= quantity(line.quantity, line.unit) %> × <%= number_with_precision(line.unit_price_cents / 100.0, precision: 2, delimiter: ",") %></span><span><%= number_with_precision(line.total_cents / 100.0, precision: 2, delimiter: ",") %></span></div>
      <% if line.discount_cents.positive? %><div class="row muted"><span>  discount</span><span>−<%= number_with_precision(line.discount_cents / 100.0, precision: 2, delimiter: ",") %></span></div><% end %>
      <% if line.promotion_discount_cents.positive? %><div class="row muted"><span>  <%= line.promotion&.offer || "promotion" %></span><span>−<%= number_with_precision(line.promotion_discount_cents / 100.0, precision: 2, delimiter: ",") %></span></div><% end %>
      <% if line.serial_number.present? %><div class="muted">  S/N <%= line.serial_number %></div><% end %>
    </div>
  <% end %>
  <hr>
  <% if @sale.discount_cents.positive? %>
    <div class="row"><span>Subtotal</span><span><%= money(@sale.subtotal_cents) %></span></div>
    <div class="row"><span>Discount</span><span>−<%= money(@sale.discount_cents) %></span></div>
  <% end %>
  <div class="row bold big"><span>TOTAL</span><span><%= money(@sale.total_cents) %></span></div>
  <div class="row muted"><span>Incl. tax</span><span><%= money(@sale.tax_cents) %></span></div>
  <% saved = @sale.lines.sum(&:promotion_discount_cents) %>
  <% if saved.positive? %><div class="row bold"><span>You saved</span><span><%= money(saved) %></span></div><% end %>
  <hr>
  <% @sale.payments.each do |payment| %>
    <div class="row"><span><%= payment.label %><%= " #{payment.reference}" if payment.reference %></span><span><%= money(payment.cash? || payment.foreign_cash? ? payment.tendered_cents : payment.amount_cents) %></span></div>
  <% end %>
  <% if @sale.change_cents.positive? %><div class="row bold"><span>Change</span><span><%= money(@sale.change_cents) %></span></div><% end %>
  <% if @sale.completed? && @sale.loyalty_program %>
    <div class="row"><span>Points earned</span><span><%= @sale.points_earned %></span></div>
    <div class="row"><span>Points balance</span><span><%= number_with_delimiter(@sale.customer.points_balance) %></span></div>
  <% end %>
  <% if (submission = @sale.etims_submission) %>
    <hr>
    <% if submission.sent? %>
      <p class="center bold">KRA eTIMS</p>
      <div class="row"><span>SCU ID</span><span><%= submission.device.sdc_id %></span></div>
      <div class="row"><span>CU invoice no.</span><span><%= submission.device.sdc_id %>/<%= submission.receipt_number %></span></div>
      <div class="row"><span>Date</span><span><%= submission.signed_at ? l(submission.signed_at, format: :short) : submission.sdc_date_time %></span></div>
      <div class="muted">Internal data: <%= submission.internal_data.to_s.scan(/.{1,4}/).join("-") %></div>
      <div class="muted">Receipt signature: <%= submission.receipt_signature.to_s.scan(/.{1,4}/).join("-") %></div>
      <p class="center"><%= qr_code_svg submission.verification_url, width: 120, height: 120, role: "img", "aria-label": "KRA eTIMS QR code" %></p>
    <% else %>
      <p class="center">Tax invoice being sent to KRA. Ask for a reprint for the signed copy.</p>
    <% end %>
  <% end %>
  <hr>
  <p class="center"><%= Current.account.receipt_footer.presence || "Thank you for shopping with us" %></p>
  <p class="center"><%= barcode_svg(@sale.receipt_number) if @sale.receipt_number %></p>
</div>
