<%# locals: (status:, date:, branch:, number: nil, account: Current.account) %>
<%# A rectangular rubber stamp for the receipt: the shop across the top, what happened in the middle (PAID, ON
    ACCOUNT, VOID), then the date and receipt number, and the branch along the bottom. Drawn in one colour so a
    thermal printer gets crisp black, and tilted a little, as a stamp pressed by hand is. Long names get a smaller
    size rather than being clipped: a bold capital is about 0.7 of its size wide, and a regular one about 0.6. %>
<% top = account.name.upcase
   bottom = [ branch.name, branch.phone.presence ].compact.join(" · ").upcase
   detail = [ date, number ].compact.join(" · ")
   fit = ->(text, width, max, ratio: 0.7) { (width / ([ text.length, 1 ].max * ratio)).clamp(4.5, max).round(1) } %>
<svg class="stamp" viewBox="0 0 172 104" role="img" aria-label="<%= [ status, number, date ].compact.join(", ") %>">
  <g transform="translate(6 7) rotate(-3 80 45)" fill="currentColor" stroke="currentColor" font-family="Arial, Helvetica, sans-serif" font-weight="700" text-anchor="middle">
    <rect x="1" y="1" width="158" height="88" rx="4" fill="none" stroke-width="2.6"/>
    <rect x="6" y="6" width="148" height="78" rx="2" fill="none" stroke-width="1"/>
    <text x="80" y="21" stroke="none" font-size="<%= fit.(top, 136, 12) %>" letter-spacing="0.5"><%= top %></text>
    <line x1="14" y1="27" x2="146" y2="27" stroke-width="0.8"/>
    <text x="80" y="50" stroke="none" font-size="<%= fit.(status, 130, 21, ratio: 0.75) %>" letter-spacing="1.5"><%= status %></text>
    <line x1="14" y1="57" x2="146" y2="57" stroke-width="0.8"/>
    <text x="80" y="67" stroke="none" font-size="<%= fit.(detail, 136, 7.5, ratio: 0.6) %>" font-weight="400"><%= detail %></text>
    <text x="80" y="78" stroke="none" font-size="<%= fit.(bottom, 136, 7, ratio: 0.68) %>" letter-spacing="0.4"><%= bottom %></text>
  </g>
</svg>
