<% content_for :title, "Sales" %>

<%= render "shared/control_panel",
      title: "Sales",
      new_button: [ "Go to till", pos_path ],
      search: { placeholder: "Receipt number, e.g. #{(@branch || branches_for_selection.first)&.code}-000123" },
      filters: [ search_filter(:date, label: "Date", type: :date, value: (@date if params[:date].present?)),
                 search_filter(:branch_id, label: "Branch", value: (@branch&.id if params[:branch_id].present?), options: branches_for_selection.map { [ _1.id, _1.name ] }) ],
      records: @sales %>

<div class="card">
  <% if @sales.any? %>
    <table class="table">
      <thead><tr><th>Receipt</th><th>Time</th><th>Customer</th><th>Cashier</th><th class="text-right">Total</th><th></th></tr></thead>
      <tbody>
        <% @sales.each do |sale| %>
          <tr>
            <td><%= link_to sale.receipt_number, sale, class: "link font-mono" %></td>
            <td><%= l(sale.completed_at, format: :short) %></td>
            <td><%= sale.customer&.name || "Walk-in" %></td>
            <td><%= sale.cashier.name %></td>
            <td class="text-right tabular-nums <%= "line-through text-gray-400" if sale.voided? %>"><%= money(sale.total_cents) %></td>
            <td><%= tag.span("Voided", class: "badge bg-red-50 text-red-800") if sale.voided? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">No sales <%= params[:query].present? ? "with that receipt number" : "on #{l(@date, format: :long)}" %>.</p>
  <% end %>
</div>
