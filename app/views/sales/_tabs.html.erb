<nav class="mb-6 flex flex-wrap gap-x-6 gap-y-2 border-b border-concrete-200 text-sm">
  <% tabs = []
     tabs += [ [ "Sales", sales_path ], [ "Orders & quotes", customer_orders_path ], [ "Deliveries", delivery_notes_path ], [ "Returns", returns_path ], [ "Shifts", shifts_path ] ] if current_membership.can_sell?
     tabs << [ "Customers", customers_path ]
     tabs << [ "Jobs", jobs_path ]
     tabs << [ "Who owes us", receivables_path ] if current_membership.can_manage_receivables? %>
  <% tabs.each do |name, path| %>
    <% active = request.path == path || request.path.start_with?("#{path}/") %>
    <%= link_to name, path, class: class_names("-mb-px border-b-2 pb-2", "border-safety-500 font-semibold text-navy-900" => active, "border-transparent text-steel-600 hover:text-navy-900" => !active) %>
  <% end %>
</nav>
