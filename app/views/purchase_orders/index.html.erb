<% content_for :title, "Purchase orders" %>

<%= render "shared/control_panel",
      title: "Purchase orders",
      new_button: [ "New", new_purchase_order_path ],
      actions: [ [ "Returns to suppliers", supplier_returns_path ], ([ "Supplier invoices", supplier_invoices_path ] if current_membership.can_manage_payables?) ].compact,
      search: { placeholder: "Supplier" },
      filters: [ search_filter(:status, label: "Status", value: params[:status],
                   options: [ [ "draft", "Drafts" ], [ "open", "Waiting for delivery" ], [ "sent", "Sent" ], [ "partially_received", "Partly received" ],
                              [ "received", "Received" ], [ "cancelled", "Cancelled" ] ]),
                 search_filter(:supplier_id, label: "Supplier", value: params[:supplier_id], menu: false,
                   options: Current.account.suppliers.where(id: params[:supplier_id]).pluck(:id, :name)),
                 search_filter(:group_by, label: "Group by", value: @group_by, section: :group_by, options: PurchaseOrdersController::GROUPINGS.to_a) ],
      records: (@purchase_orders unless @groups) %>

<% if @groups %>
  <%= render "shared/list_groups", groups: @groups, param: @group_by == "supplier" ? :supplier_id : :status %>
<% else %>
<%= turbo_frame_tag list_frame || "list", target: "_top" do %>
<div class="<%= list_frame ? "px-4 pb-2" : "card" %>">
  <% if @purchase_orders.any? %>
    <table class="table">
      <thead><tr><th>Order</th><th>Supplier</th><th>Deliver to</th><th>Created</th><th>Expected</th><th class="text-right">Total</th><th>Status</th></tr></thead>
      <tbody>
        <% @purchase_orders.each do |order| %>
          <tr>
            <td><%= link_to order.reference, order, class: "link font-mono" %></td>
            <td><%= order.supplier.name %></td>
            <td><%= order.branch.name %></td>
            <td><%= l(order.created_at.to_date, format: :short) %></td>
            <td class="<%= "text-red-700" if order.expected_on&.past? && order.receivable? %>"><%= order.expected_on ? l(order.expected_on, format: :short) : "—" %></td>
            <td class="text-right tabular-nums"><%= money(order.total_cents, currency: order.currency) %></td>
            <td><%= render "purchasing/status", order: order %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">No purchase orders<%= " here" if params[:status] %>. Start one, or let <%= link_to "Reorder", reorder_list_path, class: "link" %> draft them for you.</p>
  <% end %>
</div>
<%= render "shared/group_more" %>
<% end %>
<% end %>
