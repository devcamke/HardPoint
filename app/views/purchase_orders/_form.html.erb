<% more_fields = %i[ branch branch_id expected_on note ] %>
<%= form_with model: purchase_order, class: "card max-w-4xl" do |form| %>
  <%= render "shared/errors", model: purchase_order %>

  <div class="field max-w-md" data-tour="po-supplier"><%= form.label :supplier_id, "Supplier", class: "label" %>
    <%= form.collection_select :supplier_id, Current.account.suppliers.active.alphabetically, :id, :name, { prompt: "Choose…" }, required: true, class: "input" %></div>

  <p class="label mt-2">Products</p>
  <table class="table mb-4" data-tour="po-lines">
    <thead><tr><th>Barcode or SKU</th><th class="text-right">Quantity</th><th class="text-right">Unit cost (blank = supplier's price)</th><th class="text-right">Remove</th></tr></thead>
    <tbody>
      <%= form.fields_for :lines do |line| %>
        <tr>
          <td>
            <% if line.object.persisted? %>
              <%= line.hidden_field :id %><%= line.object.product.name %> <span class="font-mono text-xs text-gray-500"><%= line.object.product.sku %></span>
            <% else %>
              <%= line.text_field :product_code, value: line.object.product_code || line.object.product&.sku, placeholder: "Scan or type", class: "input py-1.5 font-mono", "aria-label": "Barcode or SKU" %>
            <% end %>
          </td>
          <td class="text-right"><%= line.number_field :quantity, value: plain_number(line.object.quantity), step: "any", min: 0, inputmode: "decimal", class: "input w-24 py-1.5 text-right", "aria-label": "Quantity" %></td>
          <td class="text-right"><%= line.number_field :unit_cost, value: (plain_number(line.object.unit_cost) if line.object.unit_cost_cents.to_i.positive?), step: "0.01", inputmode: "decimal", min: 0, class: "input w-32 py-1.5 text-right", "aria-label": "Unit cost" %></td>
          <td class="text-right"><%= line.check_box :_destroy, class: "size-4 accent-primary-500", "aria-label": "Remove line" if line.object.persisted? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "shared/more_options", open: more_fields.any? { purchase_order.errors.include?(_1) }, tour: "po-more",
        summary: [ "deliver to #{(purchase_order.branch || selected_branch)&.name}",
                   (purchase_order.expected_on ? "expected by #{l(purchase_order.expected_on, format: :short)}" : "no expected date"),
                   (purchase_order.note.present? ? "note: #{purchase_order.note.truncate(40)}" : "no note") ].join(" · ") do %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field"><%= form.label :branch_id, "Deliver to", class: "label" %>
        <%= form.collection_select :branch_id, branches_for_selection, :id, :name, {}, class: "input" %></div>
      <div class="field"><%= form.label :expected_on, "Expected by", class: "label" %><%= form.date_field :expected_on, class: "input" %></div>
    </div>
    <div class="field"><%= form.label :note, "Note to the supplier", class: "label" %><%= form.text_field :note, class: "input", placeholder: "e.g. deliver to the back gate before 10am" %></div>
  <% end %>
  <%= form.submit purchase_order.new_record? ? "Save draft" : "Save", class: "btn-primary", data: { tour: "po-save" } %>
<% end %>
