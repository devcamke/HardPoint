<%= form_with model: purchase_order, class: "card max-w-4xl" do |form| %>
  <%= render "shared/errors", model: purchase_order %>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="field"><%= form.label :supplier_id, "Supplier", class: "label" %>
      <%= form.collection_select :supplier_id, Current.account.suppliers.active.alphabetically, :id, :name, { prompt: "Choose…" }, required: true, class: "input" %></div>
    <div class="field"><%= form.label :branch_id, "Deliver to", class: "label" %>
      <%= form.collection_select :branch_id, branches_for_selection, :id, :name, {}, class: "input" %></div>
    <div class="field"><%= form.label :expected_on, "Expected by", class: "label" %><%= form.date_field :expected_on, class: "input" %></div>
  </div>

  <p class="label mt-2">Products</p>
  <table class="table mb-4">
    <thead><tr><th>Barcode or SKU</th><th class="text-right">Quantity</th><th class="text-right">Unit cost (blank = supplier's price)</th><th class="text-right">Remove</th></tr></thead>
    <tbody>
      <%= form.fields_for :lines do |line| %>
        <tr>
          <td>
            <% if line.object.persisted? %>
              <%= line.hidden_field :id %><%= line.object.product.name %> <span class="font-mono text-xs text-steel-600"><%= line.object.product.sku %></span>
            <% else %>
              <%= line.text_field :product_code, value: line.object.product_code || line.object.product&.sku, placeholder: "Scan or type", class: "input py-1.5 font-mono", "aria-label": "Barcode or SKU" %>
            <% end %>
          </td>
          <td class="text-right"><%= line.number_field :quantity, value: plain_number(line.object.quantity), step: "any", min: 0, class: "input w-24 py-1.5 text-right", "aria-label": "Quantity" %></td>
          <td class="text-right"><%= line.number_field :unit_cost, value: (plain_number(line.object.unit_cost) if line.object.unit_cost_cents.to_i.positive?), step: "0.01", min: 0, class: "input w-32 py-1.5 text-right", "aria-label": "Unit cost" %></td>
          <td class="text-right"><%= line.check_box :_destroy, class: "size-4 accent-safety-500", "aria-label": "Remove line" if line.object.persisted? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="field"><%= form.label :note, "Note to the supplier", class: "label" %><%= form.text_field :note, class: "input", placeholder: "e.g. deliver to the back gate before 10am" %></div>
  <%= form.submit purchase_order.new_record? ? "Save draft" : "Save", class: "btn-primary" %>
<% end %>
