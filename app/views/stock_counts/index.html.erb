<% content_for :title, "Stock takes" %>

<%= render "shared/control_panel",
      title: "Stock takes",
      new_button: ([ "New", new_stock_count_path ] if current_membership.can_manage_stock?),
      records: @counts %>

<div class="card">
  <% if @counts.any? %>
    <table class="table">
      <thead><tr><th>Branch</th><th>Scope</th><th>Started</th><th>Status</th></tr></thead>
      <tbody>
        <% @counts.each do |count| %>
          <tr>
            <td><%= link_to count.branch.name, count, class: "link" %></td>
            <td><%= count.category&.name || "All products" %></td>
            <td><%= l(count.created_at, format: :short) %> · <%= count.creator&.name %></td>
            <td><%= render "stock_counts/status", count: count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">No stock takes yet. Count everything once a year, or one category at a time (a cycle count) every week.</p>
  <% end %>
</div>
