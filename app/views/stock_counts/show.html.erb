<% content_for :title, "Stock take" %>

<p class="text-sm"><%= link_to "← Stock takes", stock_counts_path, class: "link" %></p>
<% counted, total = @count.progress %>
<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-3xl font-bold">Stock take <%= render "stock_counts/status", count: @count %></h1>
    <p class="hint mt-1"><%= @count.name %> · started by <%= @count.creator&.name %><%= " · approved by #{@count.approver.name}" if @count.approved? %></p>
    <p class="mt-2 text-sm"><strong><%= counted %></strong> of <%= total %> counted
      <% if current_membership.can_see_costs? && counted.positive? %> · difference at cost <strong class="<%= @count.variance_value_cents.negative? ? "text-red-700" : "" %>"><%= money(@count.variance_value_cents) %></strong><% end %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if (@count.counting? || @count.submitted?) && current_membership.can_manage_stock? %>
      <%= button_to "Cancel", stock_count_cancellation_path(@count), class: "btn-danger", form: { data: { turbo_confirm: "Cancel this stock take? Nothing will change." } } %>
    <% end %>
    <% if @count.counting? && current_membership.can_manage_stock? %>
      <%= button_to "Submit for approval", stock_count_submission_path(@count), class: "btn-primary",
            form: { data: { turbo_confirm: ("#{total - counted} products aren't counted and will be left as they are. Submit anyway?" if counted < total) } } %>
    <% end %>
    <% if @count.submitted? && current_membership.can_approve_stock_counts? %>
      <%= button_to "Approve and correct stock", stock_count_approval_path(@count), class: "btn-primary",
            form: { data: { turbo_confirm: "Post the differences to stock at #{@count.branch.name}?" } } %>
    <% end %>
  </div>
</div>

<% if @count.counting? && current_membership.can_manage_stock? %>
  <%= form_with url: stock_count_scan_path(@count), class: "card mb-4 flex flex-wrap items-end gap-3 p-4" do |form| %>
    <div class="flex-1"><%= form.label :code, "Scan a barcode or type a SKU", class: "label" %><%= form.text_field :code, required: true, autofocus: true, class: "input font-mono" %></div>
    <div class="w-32"><%= form.label :counted_quantity, "Counted", class: "label" %><%= form.number_field :counted_quantity, required: true, step: "any", min: 0, class: "input" %></div>
    <%= form.submit "Record", class: "btn-primary" %>
  <% end %>
<% end %>

<div class="mb-3 flex flex-wrap items-center gap-4 text-sm">
  <% [ [ "All", nil ], [ "Not counted", "uncounted" ], [ "Differences", "variances" ] ].each do |label, filter| %>
    <%= link_to label, stock_count_path(@count, filter: filter, query: params[:query]), class: params[:filter] == filter ? "font-semibold text-navy-900" : "link" %>
  <% end %>
  <%= form_with url: stock_count_path(@count), method: :get, class: "ml-auto", data: { controller: "auto-submit" } do |form| %>
    <%= form.hidden_field :filter, value: params[:filter] %>
    <%= form.search_field :query, value: params[:query], placeholder: "Find a product", class: "input py-1.5", data: { action: "input->auto-submit#debouncedSubmit" } %>
  <% end %>
</div>

<div class="card overflow-x-auto">
  <table class="table">
    <thead><tr><th>Product</th><th class="text-right">Expected</th><th class="text-right">Counted</th><th class="text-right">Difference</th></tr></thead>
    <tbody>
      <% @lines.each do |line| %>
        <%= render "stock_counts/line", line: line, count: @count %>
      <% end %>
    </tbody>
  </table>
</div>
<%= render "shared/pagination" %>
