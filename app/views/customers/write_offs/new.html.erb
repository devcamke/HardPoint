<% content_for :title, "Write off" %>
<h1 class="mb-2 text-xl font-medium"><%= link_to "#{@customer.name}", @customer, class: "link" %> <span class="text-gray-400">/</span> Write off a debt</h1>
<p class="hint mb-6">They owe <%= money(@customer.balance_cents) %>. Writing off takes the amount off what they owe without any money changing hands;
  it stays on their statement and in Activity with the reason and who approved it.</p>

<%= form_with model: @write_off, url: customer_write_offs_path(@customer), class: "card max-w-xl" do |form| %>
  <%= render "shared/errors", model: @write_off %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="field"><%= form.label :amount, "Amount (#{Current.account.currency})", class: "label" %><%= form.number_field :amount, value: plain_number(@write_off.amount), step: "0.01", inputmode: "decimal", min: 0, required: true, autofocus: true, class: "input" %></div>
    <div class="field"><%= form.label :paid_on, "Written off on", class: "label" %><%= form.date_field :paid_on, required: true, class: "input" %></div>
  </div>
  <div class="field"><%= form.label :reason, class: "label" %><%= form.text_field :reason, required: true, placeholder: "Why the shop is giving up on this", class: "input" %></div>
  <%= render "customers/payments/allocations", customer: @customer, entry: @write_off, verb: "write off" %>
  <% unless current_membership.approves_own_actions? %>
    <div class="field"><%= label_tag :approval_pin, "Manager approval PIN", class: "label" %><%= password_field_tag :approval_pin, nil, inputmode: "numeric", autocomplete: "off", required: true, class: "input w-40" %></div>
  <% end %>
  <%= form.submit "Write off", class: "btn-primary" %>
<% end %>
