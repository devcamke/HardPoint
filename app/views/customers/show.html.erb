<% content_for :title, @customer.name %>

<p class="text-sm"><%= link_to "← Customers", customers_path, class: "link" %></p>
<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-3xl font-bold"><%= @customer.name %></h1>
    <p class="hint mt-1"><%= [ @customer.phone, @customer.email, @customer.address, ("PIN #{@customer.tax_pin}" if @customer.tax_pin.present?) ].compact_blank.join(" · ") %></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if current_membership.can_sell? %>
      <%= link_to "Edit", edit_customer_path(@customer), class: "btn-secondary" %>
      <%= link_to "New quote", new_customer_order_path(customer_id: @customer.id), class: "btn-secondary" %>
      <%= link_to "Add a job", new_job_path(customer_id: @customer.id), class: "btn-secondary" %>
    <% end %>
    <%= link_to "Statement", customer_statement_path(@customer), class: "btn-secondary" if current_membership.can_manage_receivables? %>
    <% if current_membership.can_manage_receivables? && Current.account.sms_enabled? && @customer.phone.present? && @customer.balance_cents.positive? %>
      <%= button_to "Text a reminder", customer_balance_reminder_path(@customer), class: "btn-secondary" %>
    <% end %>
    <%= link_to "Record payment", new_customer_payment_path(@customer), class: "btn-primary" if @customer.balance_cents.positive? %>
  </div>
</div>

<div class="mb-6 grid gap-4 sm:grid-cols-4">
  <div class="card"><p class="hint">Prices</p><p class="mt-1 text-xl font-bold"><%= @customer.price_list&.name || "Retail" %></p></div>
  <div class="card"><p class="hint">Owes on account</p><p class="mt-1 text-xl font-bold tabular-nums"><%= money(@customer.balance_cents) %></p>
    <% overdue = @customer.overdue_cents %><%= tag.p("#{money(overdue)} overdue", class: "text-sm font-semibold text-red-700") if overdue.positive? %></div>
  <div class="card"><p class="hint">Credit left</p><p class="mt-1 text-xl font-bold tabular-nums"><%= @customer.buys_on_account? ? money(@customer.available_credit_cents) : "Cash only" %></p>
    <% if @customer.buys_on_account? %><p class="hint">of <%= money(@customer.credit_limit_cents) %></p><% end %></div>
  <div class="card"><p class="hint">Pays within</p><p class="mt-1 text-xl font-bold"><%= pluralize(@customer.payment_terms_days, "day") %></p></div>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="card">
    <h2 class="mb-3 text-lg font-semibold">Unpaid account sales</h2>
    <% if @open_invoices.any? %>
      <table class="table">
        <thead><tr><th>Sale</th><th>Due</th><th class="text-right">On account</th><th class="text-right">Still owed</th></tr></thead>
        <tbody>
          <% @open_invoices.each do |open| %>
            <tr>
              <td><%= link_to open.sale.receipt_number, open.sale, class: "link font-mono" %></td>
              <td class="<%= "font-semibold text-red-700" if open.days_overdue.positive? %>"><%= tag.span(l(open.due_date, format: :long), class: "whitespace-nowrap") %><%= tag.span(" · #{pluralize(open.days_overdue, "day")} late", class: "whitespace-nowrap") if open.days_overdue.positive? %></td>
              <td class="text-right tabular-nums"><%= money(open.amount_cents) %></td>
              <td class="text-right tabular-nums"><%= money(open.outstanding_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">Nothing owed.</p>
    <% end %>
  </section>

  <section class="card">
    <h2 class="mb-3 text-lg font-semibold">Payments on account</h2>
    <% if @payments.any? %>
      <table class="table">
        <tbody>
          <% @payments.each do |payment| %>
            <tr><td class="whitespace-nowrap"><%= l(payment.paid_on, format: :long) %></td><td><%= payment.payment_method.humanize %><%= " · #{payment.reference}" if payment.reference.present? %></td>
              <td class="text-steel-600"><%= payment.creator&.name %></td><td class="text-right tabular-nums"><%= money(payment.amount_cents) %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">No payments yet.</p>
    <% end %>
  </section>

  <% if @loyalty %>
    <section class="card" id="loyalty_points">
      <div class="mb-3 flex items-baseline justify-between">
        <h2 class="text-lg font-semibold">Loyalty points</h2>
        <p><strong class="text-xl tabular-nums"><%= number_with_delimiter(balance = @customer.points_balance) %></strong> <span class="hint">worth <%= money(@loyalty.value_cents(balance)) %></span></p>
      </div>
      <% if @points.any? %>
        <table class="table text-sm">
          <tbody>
            <% @points.each do |entry| %>
              <tr><td class="whitespace-nowrap"><%= l(entry.created_at, format: :short) %></td><td><%= entry.description %></td>
                <td class="text-right tabular-nums <%= entry.points.negative? ? "text-red-700" : "text-green-700" %>"><%= "+" if entry.points.positive? %><%= entry.points %></td></tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="hint">No points yet. They're earned on sales in <%= @customer.name %>'s name.</p>
      <% end %>
      <% if current_membership.approver? %>
        <details class="mt-3">
          <summary class="link cursor-pointer text-sm">Adjust points</summary>
          <%= form_with url: customer_loyalty_adjustments_path(@customer), class: "mt-2 flex flex-wrap items-end gap-2" do |form| %>
            <div><%= form.label :points, "Points (+ or −)", class: "label" %><%= form.number_field :points, step: 1, required: true, class: "input w-28" %></div>
            <div class="flex-1"><%= form.label :note, "Reason", class: "label" %><%= form.text_field :note, required: true, class: "input", placeholder: "e.g. apology for a late delivery" %></div>
            <%= form.submit "Adjust", class: "btn-secondary" %>
          <% end %>
        </details>
      <% end %>
    </section>
  <% end %>

  <% if @jobs.any? %>
    <section class="card">
      <h2 class="mb-3 text-lg font-semibold">Open jobs</h2>
      <table class="table">
        <tbody>
          <% @jobs.each do |job| %>
            <tr><td><%= link_to job.label, job, class: "link" %><%= tag.p(job.site, class: "hint") if job.site %></td>
              <td class="text-right tabular-nums"><%= money(@job_spend[job.id]) %></td>
              <td class="w-40"><%= render "jobs/budget", job: job, spent: @job_spend[job.id] %></td></tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>

  <% if @orders.any? %>
    <section class="card">
      <h2 class="mb-3 text-lg font-semibold">Quotes and orders</h2>
      <table class="table">
        <tbody>
          <% @orders.each do |order| %>
            <tr><td><%= link_to order.reference, order, class: "link font-mono" %></td><td><%= render "customer_orders/status", order: order %></td>
              <td class="text-right tabular-nums"><%= money(order.total_cents) %></td></tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>

  <section class="card">
    <h2 class="mb-3 text-lg font-semibold">Recent purchases</h2>
    <% if @sales.any? %>
      <table class="table">
        <tbody>
          <% @sales.each do |sale| %>
            <tr><td><%= link_to sale.receipt_number, sale, class: "link font-mono" %></td><td><%= l(sale.completed_at, format: :short) %></td>
              <td class="text-right tabular-nums <%= "line-through" if sale.voided? %>"><%= money(sale.total_cents) %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">No purchases yet.</p>
    <% end %>
  </section>
</div>
