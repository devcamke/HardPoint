<% content_for :title, @customer.name %>

<div class="mt-2 mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-xl font-medium"><%= link_to "Customers", customers_path, class: "link" %> <span class="text-gray-400">/</span> <%= @customer.name %></h1>
    <p class="hint mt-1" data-tour="customer-details"><%= [ @customer.phone, @customer.email, @customer.address, ("PIN #{@customer.tax_pin}" if @customer.tax_pin.present?) ].compact_blank.join(" · ") %> <%= email_status(@customer.email) %></p>
    <%= tag.p "Has asked not to be texted: no receipts, order texts or reminders go to this number.", class: "hint mt-1 font-semibold" if @customer.sms_opt_out? %>
  </div>
  <div class="flex flex-wrap gap-2" data-tour="customer-actions">
    <% if current_membership.can_sell? %>
      <%= link_to "Edit", edit_customer_path(@customer), class: "btn-secondary" %>
      <%= link_to "New quote", new_customer_order_path(customer_id: @customer.id), class: "btn-secondary" %>
      <%= link_to "Add a job", new_job_path(customer_id: @customer.id), class: "btn-secondary" if feature?(:jobs) %>
    <% end %>
    <%= link_to "Statement", customer_statement_path(@customer), class: "btn-secondary" if current_membership.can_manage_receivables? %>
    <% if feature?(:whatsapp_messages) && current_membership.can_manage_receivables? && @customer.phone.present? && @customer.balance_cents.positive? %>
      <%= button_to "Remind on WhatsApp", whatsapp_messages_path, params: { kind: "statement", id: @customer.id, reminder: 1 }, class: "btn-secondary",
            form: { data: { turbo_confirm: "Send #{@customer.name} a reminder of the #{money(@customer.balance_cents)} owed, with their statement, on WhatsApp?" } } %>
    <% end %>
    <% if current_membership.can_manage_receivables? && Current.account.sms_enabled? && @customer.phone.present? && @customer.balance_cents.positive? && !@customer.sms_opt_out? %>
      <%= button_to "Text a reminder", customer_balance_reminder_path(@customer), class: "btn-secondary" %>
    <% end %>
    <%= link_to "Write off", new_customer_write_off_path(@customer), class: "btn-secondary" if current_membership.can_manage_receivables? && @customer.balance_cents.positive? %>
    <%= link_to "Refund credit", new_customer_payment_path(@customer, refund: 1), class: "btn-secondary" if @customer.balance_cents.negative? %>
    <%= link_to "Record payment", new_customer_payment_path(@customer), class: "btn-primary" if @customer.balance_cents.positive? %>
  </div>
</div>

<%= shared_links @customer if current_membership.can_manage_receivables? %>

<div class="mb-6 grid gap-4 sm:grid-cols-4" data-tour="customer-account">
  <div class="card"><p class="hint">Prices</p><p class="mt-1 text-xl font-bold"><%= @customer.price_list&.name || "Retail" %></p></div>
  <div class="card"><p class="hint"><%= @customer.balance_cents.negative? ? "Credit on account" : "Owes on account" %></p><p class="mt-1 text-xl font-bold tabular-nums"><%= money(@customer.balance_cents.abs) %></p>
    <% overdue = @customer.overdue_cents(invoices: @open_invoices) %><%= tag.p("#{money(overdue)} overdue", class: "text-sm font-semibold text-red-700") if overdue.positive? %></div>
  <div class="card"><p class="hint">Credit left</p><p class="mt-1 text-xl font-bold tabular-nums"><%= @customer.buys_on_account? ? money(@customer.available_credit_cents) : "Cash only" %></p>
    <% if @customer.buys_on_account? %><p class="hint">of <%= money(@customer.credit_limit_cents) %></p><% end %></div>
  <div class="card"><p class="hint">Pays within</p><p class="mt-1 text-xl font-bold"><%= pluralize(@customer.payment_terms_days, "day") %></p></div>
</div>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="card" data-tour="customer-unpaid">
    <h2 class="mb-3 text-lg font-semibold">Unpaid account sales</h2>
    <% if @open_invoices.any? %>
      <table class="table">
        <thead><tr><th>Sale</th><th>Due</th><th class="text-right">On account</th><th class="text-right">Still owed</th></tr></thead>
        <tbody>
          <% @open_invoices.each do |open| %>
            <tr>
              <td><%= link_to open.sale.receipt_number, open.sale, class: "link font-mono" %></td>
              <td class="<%= "font-semibold text-red-700" if open.days_overdue.positive? %>"><%= tag.span(l(open.due_date, format: :long), class: "whitespace-nowrap") %><%= tag.span(" · #{pluralize(open.days_overdue, "day")} late", class: "whitespace-nowrap") if open.days_overdue.positive? %></td>
              <td class="text-right tabular-nums"><%= money(open.amount_cents) %></td>
              <td class="text-right tabular-nums"><%= money(open.outstanding_cents) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">Nothing owed.</p>
    <% end %>
  </section>

  <section class="card">
    <h2 class="mb-3 text-lg font-semibold">Payments on account</h2>
    <% if @payments.any? %>
      <table class="table">
        <tbody>
          <% @payments.each do |payment| %>
            <tr><td class="whitespace-nowrap"><%= l(payment.paid_on, format: :long) %></td><td><%= payment.description %><%= " · #{payment.reference}" if payment.reference.present? %></td>
              <td class="text-gray-500"><%= payment.write_off? ? "approved by #{payment.approver&.name}" : payment.creator&.name %></td>
              <td class="text-right tabular-nums <%= "text-red-700" if payment.refund? %>"><%= money(payment.amount_cents) %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">No payments yet.</p>
    <% end %>
  </section>

  <% if feature?(:customer_portal) && current_membership.can_manage_receivables? %>
    <section class="card" id="portal">
      <h2 class="text-lg font-semibold">Customer portal</h2>
      <p class="hint mt-1">A link to <%= @customer.name %>'s own page: what they owe, their invoices, quotes and statements<%= ", and Pay with M-Pesa" if Current.account.portal_payments? %>. No sign-in, for 90 days.</p>
      <% if (link = @customer.portal_links.current.newest_first.first) %>
        <div class="mt-3 flex gap-2" data-controller="copy">
          <input type="text" readonly value="<%= link.url %>" aria-label="Portal link" class="input min-w-0 flex-1 font-mono text-xs" data-copy-target="source">
          <button type="button" class="btn-secondary" data-copy-target="button" data-action="copy#copy">Copy</button>
        </div>
        <p class="hint mt-2">Opened <%= pluralize(link.opened_count, "time") %><%= ", last #{time_ago_in_words(link.last_opened_at)} ago" if link.last_opened_at %> · works until <%= l(link.expires_at.to_date, format: :long) %></p>
      <% end %>
      <div class="mt-3 flex flex-wrap gap-2">
        <% if @customer.phone.present? %>
          <%= button_to "Send on WhatsApp", customer_portal_link_path(@customer, send: "whatsapp"), class: "btn-primary", form: { target: "_blank", data: { turbo: false } } %>
        <% end %>
        <%= button_to "Make a link", customer_portal_link_path(@customer), class: "btn-secondary" unless link %>
        <%= button_to "Stop the link", customer_portal_link_path(@customer), method: :delete, class: "btn-secondary", form: { data: { turbo_confirm: "The link already sent will stop opening. Stop it?" } } if link %>
      </div>
    </section>
  <% end %>

  <% if @jobs.any? %>
    <section class="card">
      <h2 class="mb-3 text-lg font-semibold">Open jobs</h2>
      <table class="table">
        <tbody>
          <% @jobs.each do |job| %>
            <tr><td><%= link_to job.label, job, class: "link" %><%= tag.p(job.site, class: "hint") if job.site %></td>
              <td class="text-right tabular-nums"><%= money(@job_spend[job.id]) %></td>
              <td class="w-40"><%= render "jobs/budget", job: job, spent: @job_spend[job.id] %></td></tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>

  <% if @orders.any? %>
    <section class="card">
      <h2 class="mb-3 text-lg font-semibold">Quotes and orders</h2>
      <table class="table">
        <tbody>
          <% @orders.each do |order| %>
            <tr><td><%= link_to order.reference, order, class: "link font-mono" %></td><td><%= render "customer_orders/status", order: order %></td>
              <td class="text-right tabular-nums"><%= money(order.total_cents) %></td></tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>

  <section class="card" data-tour="customer-purchases">
    <h2 class="mb-3 text-lg font-semibold">Recent purchases</h2>
    <% if @sales.any? %>
      <table class="table">
        <tbody>
          <% @sales.each do |sale| %>
            <tr><td><%= link_to sale.receipt_number, sale, class: "link font-mono" %></td><td><%= l(sale.completed_at, format: :short) %></td>
              <td class="text-right tabular-nums <%= "line-through" if sale.voided? %>"><%= money(sale.total_cents) %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">No purchases yet.</p>
    <% end %>
  </section>
</div>
