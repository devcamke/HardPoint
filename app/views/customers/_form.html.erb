<% more_fields = %i[ email tax_pin address price_list_id payment_terms_days notes ] %>
<%= form_with model: customer, class: "card max-w-xl" do |form| %>
  <%= hidden_field_tag :for_till, "1" if params[:for_till].present? %>
  <%= render "shared/errors", model: customer %>
  <div class="field"><%= form.label :name, class: "label" %><%= form.text_field :name, required: true, autofocus: true, class: "input" %></div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="field"><%= form.label :phone, class: "label" %><%= form.telephone_field :phone, class: "input" %>
      <p class="hint mt-1">For finding them at the till and texting receipts</p></div>
    <% if current_membership.approver? %>
      <div class="field"><%= form.label :credit_limit, "Credit limit (#{Current.account.currency})", class: "label" %><%= form.number_field :credit_limit, value: plain_number(customer.credit_limit), step: "0.01", inputmode: "decimal", min: 0, class: "input" %>
        <p class="hint mt-1">0 means cash only; above 0 lets them buy on account.</p></div>
    <% end %>
  </div>

  <%= render "shared/more_options", open: more_fields.any? { customer.errors.include?(_1) },
        summary: [ (customer.price_list ? "#{customer.price_list.name} prices" : "retail prices"),
                   ("pays within #{customer.payment_terms_days} days" if customer.payment_terms_days.to_i.positive?),
                   (customer.tax_pin.present? ? "tax PIN #{customer.tax_pin}" : "no tax PIN"),
                   ("email #{customer.email}" if customer.email.present?) ].compact.join(" · ") do %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="field"><%= form.label :email, class: "label" %><%= form.email_field :email, class: "input" %></div>
      <div class="field"><%= form.label :tax_pin, "Tax PIN (for tax invoices)", class: "label" %><%= form.text_field :tax_pin, class: "input uppercase" %></div>
      <div class="field sm:col-span-2"><%= form.label :address, "Address (for deliveries and statements)", class: "label" %><%= form.text_field :address, class: "input" %></div>
      <% if current_membership.approver? %>
        <div class="field"><%= form.label :price_list_id, "Prices", class: "label" %><%= form.collection_select :price_list_id, Current.account.price_lists.alphabetically, :id, :name, { include_blank: "Retail" }, class: "input" %></div>
        <div class="field"><%= form.label :payment_terms_days, "Pays within (days)", class: "label" %><%= form.number_field :payment_terms_days, min: 0, step: 1, class: "input" %></div>
      <% end %>
    </div>
    <div class="field"><%= form.label :notes, class: "label" %><%= form.text_area :notes, rows: 2, class: "input" %></div>
  <% end %>

  <div class="flex gap-3">
    <%= form.submit customer.new_record? ? (params[:for_till].present? ? "Add and use on this sale" : "Add customer") : "Save", class: "btn-primary" %>
    <%= link_to "Back to the till", pos_path, class: "btn-secondary" if params[:for_till].present? %>
  </div>
<% end %>
