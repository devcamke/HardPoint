<% content_for :title, "Staff" %>

<%= render "shared/control_panel",
      title: "Staff",
      new_button: [ "New", new_membership_path ] %>

<div class="card">
  <table class="table">
    <thead>
      <tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr>
    </thead>
    <tbody>
      <% @memberships.each do |membership| %>
        <tr id="<%= dom_id(membership) %>">
          <td class="font-medium"><%= membership.user.name %></td>
          <td><%= membership.user.email_address %></td>
          <td><%= membership.role.humanize %></td>
          <td class="text-right"><%= link_to "Edit", edit_membership_path(membership), class: "link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
