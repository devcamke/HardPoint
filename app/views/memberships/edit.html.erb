<% content_for :title, "Edit #{@membership.user.name}" %>

<h1 class="mb-6 text-xl font-medium"><%= @membership.user.name %></h1>

<div class="card max-w-xl">
  <%= form_with model: @membership do |form| %>
    <%= render "shared/errors", model: @membership %>
    <p class="mb-4 text-sm text-gray-500"><%= @membership.user.email_address %></p>

    <%= render "role_field", form: form %>

    <div class="flex gap-3">
      <%= form.submit "Save", class: "btn-primary" %>
      <%= link_to "Cancel", memberships_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>

<% if current_membership.can_manage_account? && @membership.user != Current.user && @membership.user.two_factor_enabled? %>
  <section class="card mt-6 max-w-xl">
    <h2 class="font-semibold">Two-factor sign-in</h2>
    <p class="hint mt-1">If <%= @membership.user.name %> has lost their phone and their recovery codes, turn two-factor off so they can sign in
      with their password and set it up again. They're signed out everywhere and emailed.</p>
    <% if @membership.two_factor_resettable_by_shop? %>
      <%= form_with url: membership_two_factor_reset_path(@membership), class: "mt-3 flex flex-wrap items-end gap-2" do |form| %>
        <div><%= form.label :password, "Your password", class: "label" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", class: "input" %></div>
        <%= form.submit "Reset two-factor", class: "btn-danger", data: { turbo_confirm: "Turn off two-factor sign-in for #{@membership.user.name}?" } %>
      <% end %>
    <% else %>
      <p class="hint mt-2"><%= @membership.user.name %> also uses HardPoint with another shop, so ask HardPoint support (Contact support) to reset it.</p>
    <% end %>
  </section>
<% end %>

<% unless @membership.user == Current.user %>
  <%= button_to "Remove from shop", membership_path(@membership), method: :delete, class: "btn-danger mt-6",
        form: { data: { turbo_confirm: "Remove #{@membership.user.name}'s access?" } } %>
<% end %>
