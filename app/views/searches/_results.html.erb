<%# locals: (query:, groups:) %>
<%= turbo_frame_tag "search_results", target: "_top" do %>
  <% if query.length < 2 %>
    <p class="hint px-4 py-6 text-center">Type a product, customer, supplier, receipt number or page. Scanning a barcode works too.</p>
  <% elsif groups.empty? %>
    <p class="px-4 py-6 text-center text-gray-600">Nothing matches “<%= query %>”.</p>
  <% else %>
    <% groups.each do |heading, results| %>
      <section>
        <h2 class="px-4 pt-3 pb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase"><%= heading %></h2>
        <ul>
          <% results.each do |result| %>
            <li>
              <%= link_to result.path, class: "flex items-baseline justify-between gap-4 px-4 py-2 hover:bg-primary-50 focus:bg-primary-50 focus:outline-none aria-selected:bg-primary-50",
                    data: { search_result: true, command_palette_target: "result" } do %>
                <span class="min-w-0 truncate font-medium text-gray-900"><%= result.label %></span>
                <span class="hint shrink-0 truncate"><%= result.detail %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
<% end %>
