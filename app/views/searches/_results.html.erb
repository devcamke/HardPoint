<%# locals: (query:, groups:) %>
<%= turbo_frame_tag "search_results", target: "_top" do %>
  <% if query.length < 2 %>
    <p class="hint px-4 py-6 text-center">Type a product, customer, supplier, receipt number or page. Scanning a barcode works too.</p>
  <% elsif groups.empty? %>
    <p class="px-4 py-6 text-center text-gray-600">Nothing matches “<%= query %>”.</p>
  <% else %>
    <% groups.each do |heading, results| %>
      <% group_id = "search_group_#{search_group_key(heading).parameterize}" %>
      <section role="presentation">
        <h2 id="<%= group_id %>" class="px-4 pt-3 pb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase"><%= heading %></h2>
        <ul role="group" aria-labelledby="<%= group_id %>">
          <% results.each do |result| %>
            <li role="presentation">
              <%= link_to tracked_path(result.path, "search:#{search_group_key(heading)}"), class: "flex items-baseline justify-between gap-4 px-4 py-2 hover:bg-primary-50 focus:bg-primary-100 focus:outline-hidden focus-visible:shadow-[inset_3px_0_0_0_var(--color-primary-600)] aria-selected:bg-primary-100 aria-selected:shadow-[inset_3px_0_0_0_var(--color-primary-600)]",
                    role: "option", data: { search_result: true, command_palette_target: "result" } do %>
                <span class="min-w-0 truncate font-medium text-gray-900"><%= result.label %></span>
                <span class="hint shrink-0 truncate"><%= result.detail %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
<% end %>
