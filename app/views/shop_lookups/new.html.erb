<% content_for :title, "Sign in" %>
<% content_for :noindex, true %>
<%# Finding your shop in the public site's look (landing.css): one boxed field on an outlined panel. %>

<div class="lp">
  <%= render "pages/page_head", kicker: "Welcome back", title: "Sign in to your shop",
        lede: safe_join([ "Every shop has its own web address, like ", tag.span("yourshop.#{request.host}", class: "font-mono text-base text-(--lp-ink)"), "." ]) %>

  <div class="lp-wrap pb-[96px]">
    <div class="lp-panel max-w-[520px] mx-auto">
      <%= form_with url: shop_lookup_path, class: "lp-form", data: { turbo: false, controller: "submit-once", action: "submit->submit-once#submit" } do |form| %>
        <div class="field">
          <%= form.label :subdomain, "Your shop's web address", class: "label" %>
          <div class="lp-suffix">
            <%= form.text_field :subdomain, value: params[:subdomain], required: true, autofocus: true, autocapitalize: "none", class: "input", placeholder: "yourshop" %>
            <span>.<%= request.host %></span>
          </div>
        </div>
        <%= form.submit "Continue", class: "lp-btn" %>
      <% end %>
    </div>
    <p class="lp-fine lp-center mt-[28px]">New to HardPoint? <%= link_to "Start a free #{Plan::TRIAL.inspect} trial ›", new_signup_path %></p>
  </div>
</div>
