<% content_for :title, "Shop preferences" %>
<h1 class="mb-2 text-xl font-medium"><%= link_to "Settings", settings_path, class: "link" %> <span class="text-gray-400">/</span> Shop preferences</h1>
<p class="hint mb-6">Tune HardPoint to the way your shop works. Anything you leave as it is keeps HardPoint's usual setting.</p>

<%= form_with model: @account, url: preferences_path, method: :patch, class: "max-w-3xl space-y-6" do |form| %>
  <%= render "shared/errors", model: @account %>

  <section class="card">
    <h2 class="text-lg font-semibold">Selling</h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      <div class="field"><%= form.label :quote_validity_days, "Quotes are valid for (days)", class: "label" %>
        <%= form.number_field :quote_validity_days, min: 1, max: 365, class: "input w-32" %>
        <p class="hint mt-1">Each quote can still have its own date.</p></div>
      <div class="field"><%= form.label :customer_payment_terms_days, "New customers on account pay within (days)", class: "label" %>
        <%= form.number_field :customer_payment_terms_days, min: 0, max: 365, class: "input w-32" %>
        <p class="hint mt-1">0 means on delivery. Each customer can have their own.</p></div>
    </div>
    <fieldset class="field mt-2">
      <legend class="label">Payment buttons at the till</legend>
      <p class="hint mb-2">Cash is always there. Hide what you don't take, so cashiers can't press it by mistake. Deposits and foreign notes show by themselves when they apply.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <label class="flex items-center gap-2 text-sm text-gray-500"><input type="checkbox" checked disabled class="size-4"> Cash</label>
        <% Account::Preferences::TILL_TENDERS.each do |tender, name| %>
          <label class="flex items-center gap-2 text-sm">
            <%= check_box_tag "account[till_tenders][]", tender, @account.till_tenders.include?(tender), id: "till_tender_#{tender}", class: "size-4 accent-primary-500" %> <%= name %>
          </label>
        <% end %>
      </div>
    </fieldset>
  </section>

  <section class="card" id="credit-control">
    <h2 class="text-lg font-semibold">Credit control</h2>
    <p class="hint mt-1">For customers who buy on account.</p>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      <div class="field"><%= form.label :credit_hold_after_days, "Put an account on hold when an invoice is overdue by more than (days)", class: "label" %>
        <%= form.number_field :credit_hold_after_days, min: 0, max: 365, class: "input w-32" %>
        <p class="hint mt-1">0 means never. On hold, nothing more goes on account without a manager's PIN. Paying the late invoices takes the hold off.</p></div>
      <div class="field"><%= form.label :weekly_reminders, "Every Monday, remind customers with overdue invoices", class: "label" %>
        <%= form.select :weekly_reminders, [ [ "Don't", "off" ], [ "By SMS", "sms" ], [ "On WhatsApp, with their statement", "whatsapp" ] ], {}, class: "input" %>
        <p class="hint mt-1">At 9 in the morning, to those with a phone number who haven't asked not to be texted<%= ". With the customer portal on, the text links to it" if feature?(:customer_portal) %>.</p></div>
    </div>
  </section>

  <section class="card">
    <h2 class="text-lg font-semibold">Stock</h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      <div class="field"><%= form.label :expiry_warning_days, "Warn about batches expiring within (days)", class: "label" %>
        <%= form.number_field :expiry_warning_days, min: 1, max: 365, class: "input w-32" %>
        <p class="hint mt-1">For paint, adhesives and chemicals with expiry dates.</p></div>
      <div class="field"><%= form.label :dead_stock_days, "Stock is \"not selling\" after (days)", class: "label" %>
        <%= form.number_field :dead_stock_days, min: 14, max: 730, class: "input w-32" %>
        <p class="hint mt-1">For the dead stock report and the Monday email.</p></div>
      <div class="field"><%= form.label :reorder_lookback_days, "Reorder list looks at sales over (days)", class: "label" %>
        <%= form.number_field :reorder_lookback_days, min: 7, max: 365, class: "input w-32" %>
        <p class="hint mt-1">Longer evens out a busy week; shorter follows the season.</p></div>
      <div class="field"><%= form.label :supplier_lead_time_days, "Suppliers usually deliver in (days)", class: "label" %>
        <%= form.number_field :supplier_lead_time_days, min: 0, max: 180, class: "input w-32" %>
        <p class="hint mt-1">For suppliers without a lead time of their own.</p></div>
    </div>
  </section>

  <section class="card">
    <h2 class="text-lg font-semibold">Quotes, invoices and statements</h2>
    <div class="field mt-3"><%= form.label :payment_details, "How to pay", class: "label" %>
      <%= form.text_area :payment_details, rows: 3, maxlength: 500, class: "input", placeholder: "M-Pesa Paybill 123456, account: your phone number. Equity Bank, Moi Avenue, account 0123456789." %>
      <p class="hint mt-1">Printed at the end of quotes, invoices and statements.</p></div>
    <div class="field"><%= form.label :document_terms, "Terms", class: "label" %>
      <%= form.text_area :document_terms, rows: 4, maxlength: 1000, class: "input", placeholder: "Prices valid while the quote is. Goods remain the shop's until paid for in full. Deliveries within Nairobi only." %></div>
  </section>

  <div class="flex items-center gap-3">
    <%= form.submit "Save preferences", class: "btn-primary" %>
    <%= link_to "Cancel", settings_path, class: "link" %>
  </div>
<% end %>
<p class="hint mt-6">More ways to make HardPoint yours: <%= link_to "Appearance", edit_appearance_path, class: "link" %> (colours and logo),
  <%= link_to "Features", features_path, class: "link" %> (what's switched on), <%= link_to "Shop details", edit_account_path, class: "link" %> (discount and payout limits, alerts, the receipt footer).</p>
