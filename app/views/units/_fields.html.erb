<div class="field">
  <%= form.label :name, class: "label" %>
  <%= form.text_field :name, required: true, placeholder: "Kilogram", class: "input" %>
</div>
<div class="field">
  <%= form.label :abbreviation, class: "label" %>
  <%= form.text_field :abbreviation, required: true, placeholder: "kg", class: "input" %>
</div>
<div class="field flex items-start gap-2">
  <%= form.check_box :fractional, class: "mt-1 size-4 accent-safety-500" %>
  <div>
    <%= form.label :fractional, "Sold in parts (e.g. 2.5 kg)", class: "text-sm font-medium text-navy-800" %>
    <p class="hint">Leave unticked for things counted in whole numbers.</p>
  </div>
</div>
<div class="field">
  <%= form.label :etims_code, "KRA eTIMS quantity unit (optional)", class: "label" %>
  <%= form.text_field :etims_code, placeholder: "U", maxlength: 3, class: "input w-24 font-mono uppercase" %>
  <p class="hint mt-1">KRA's unit code, e.g. U (pieces), KG, M, L, BG (bag). Blank means U.</p>
</div>
