<% content_for :title, "Transfers" %>

<%= render "shared/control_panel",
      title: "Transfers",
      new_button: ([ "New", new_stock_transfer_path ] if current_membership.can_manage_stock?),
      records: @transfers %>

<div class="card">
  <% if @transfers.any? %>
    <table class="table">
      <thead><tr><th>#</th><th>From</th><th>To</th><th>Lines</th><th>Sent</th><th>Status</th></tr></thead>
      <tbody>
        <% @transfers.each do |transfer| %>
          <tr>
            <td><%= link_to "##{transfer.id}", transfer, class: "link" %></td>
            <td><%= transfer.from_branch.name %></td>
            <td><%= transfer.to_branch.name %></td>
            <td><%= transfer.lines.size %></td>
            <td><%= l(transfer.sent_at, format: :short) %> · <%= transfer.sender&.name %></td>
            <td><%= render "stock_transfers/status", transfer: transfer %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">No transfers yet. Use one to move stock between branches.</p>
  <% end %>
</div>
