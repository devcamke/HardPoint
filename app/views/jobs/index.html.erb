<% content_for :title, "Jobs" %>

<%= render "shared/control_panel",
      title: "Jobs",
      new_button: ([ "New", new_job_path ] if current_membership.can_sell?),
      search: { placeholder: "Job, site or customer" },
      filters: [ search_filter(:filter, label: "Status", value: @filter, clear: "all",
                   options: JobsController::FILTERS.without("all").map { [ _1, _1.humanize ] }) ],
      records: @jobs %>

<div class="card overflow-x-auto">
  <% if @jobs.any? %>
    <table class="table">
      <thead><tr><th>Job</th><th>Customer</th><th>Site</th><th class="text-right">Spent</th><th class="w-48">Budget</th></tr></thead>
      <tbody>
        <% @jobs.each do |job| %>
          <tr id="<%= dom_id(job) %>">
            <td><%= link_to job.name, job, class: "link font-semibold" %><%= tag.span(job.reference, class: "ml-1 font-mono text-xs text-gray-500") if job.reference %>
              <%= tag.span("Closed", class: "badge ml-1") if job.closed? %></td>
            <td><%= job.customer.name %></td>
            <td class="text-sm"><%= job.site %></td>
            <td class="text-right tabular-nums"><%= money(@spent[job.id]) %></td>
            <td><%= render "jobs/budget", job: job, spent: @spent[job.id] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500">No jobs here. Add a job for a contractor's project, then choose it at the till when they buy for it.</p>
  <% end %>
</div>
