<%# Nothing to pay (a sale discounted to nothing, a free item on its own): there's no payment to complete it through,
    so an owner or manager completes it here, at the till or by approval PIN. Takes the place of the payment pane. %>
<div class="border-t border-gray-200 bg-gray-50 px-4 py-3 @lg:px-6">
  <%= form_with url: pos_completion_path do |form| %>
    <p class="mb-2 text-sm">Nothing to pay on this sale.<%= " Completing it needs a manager's approval PIN." unless current_membership.approver? %></p>
    <% unless current_membership.approver? %>
      <div class="field">
        <%= form.label :approval_pin, "Manager PIN", class: "label" %>
        <%= form.password_field :approval_pin, inputmode: "numeric", autocomplete: "off", required: true, class: "input w-40" %>
      </div>
    <% end %>
    <%= form.submit "Complete sale, nothing to pay", class: "btn-primary w-full py-2.5 text-lg" %>
  <% end %>
</div>
