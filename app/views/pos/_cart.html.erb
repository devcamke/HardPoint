<div id="cart" class="flex min-h-0 flex-1 flex-col">
  <%# The lines scroll; on a short screen they keep a few rows and the whole panel scrolls instead, so payment stays reachable.
      Phones scroll the whole sale as one page. %>
  <div class="flex items-center justify-between gap-2 border-b border-gray-200 px-4 py-2 @lg:px-6" data-tour="customer">
    <div class="flex min-w-0 items-baseline gap-2">
      <p class="shrink-0 text-xs uppercase tracking-wide text-gray-500">Customer</p>
      <p class="truncate font-semibold"><%= sale.customer&.name || "Walk-in" %>
        <%= tag.span(sale.customer.price_list.name, class: "badge ml-1") if sale.customer&.price_list %>
        <%= tag.span("Order #{sale.customer_order.reference}", class: "badge ml-1") if sale.customer_order %></p>
    </div>
    <details class="relative<%= " hidden" if sale.customer_order %>">
      <summary class="btn-secondary cursor-pointer list-none py-1.5 select-none">Change</summary>
      <div class="absolute right-0 z-10 mt-2 w-[min(20rem,calc(100vw-2rem))] rounded-lg border border-gray-200 bg-white p-3 shadow-lg">
        <%= form_with url: pos_customers_path, method: :get, data: { turbo_frame: "customer_results", controller: "auto-submit" } do |form| %>
          <%= form.search_field :query, placeholder: "Name or phone", class: "input py-1.5", "aria-label": "Find customer", data: { action: "input->auto-submit#debouncedSubmit" } %>
        <% end %>
        <%= turbo_frame_tag "customer_results", src: pos_customers_path, loading: :lazy %>
        <% if sale.customer %>
          <%= button_to "Walk-in customer", pos_customer_path, method: :patch, params: { customer_id: "" }, class: "link mt-2 text-sm" %>
        <% end %>
      </div>
    </details>
  </div>
  <% jobs = sale.customer ? sale.customer.jobs.open.alphabetically.to_a : [] %>
  <% if jobs.any? || sale.job %>
    <%= form_with url: pos_job_path, method: :patch, class: "flex items-center gap-2 border-b border-gray-200 bg-gray-50 px-4 py-2 @lg:px-6", data: { controller: "auto-submit" } do |form| %>
      <%= form.label :job_id, "Job", class: "text-xs uppercase tracking-wide text-gray-500" %>
      <%= form.select :job_id, options_for_select(([ sale.job ] + jobs).compact.uniq.map { [ _1.label, _1.id ] }, sale.job_id), { include_blank: "Not for a job" },
            class: "input py-1 text-sm", disabled: sale.customer_order&.job.present?, data: { action: "change->auto-submit#submit" } %>
      <% if sale.job&.budget_cents %>
        <% left = sale.job.budget_left_cents %>
        <%= tag.span(left.negative? ? "#{money(-left)} over budget" : "#{money(left)} left", class: "whitespace-nowrap text-xs #{left.negative? ? "font-semibold text-red-700" : "text-gray-500"}") %>
      <% end %>
    <% end %>
  <% end %>

  <div class="min-h-32 flex-1 overflow-y-auto overscroll-contain max-md:flex-none max-md:overflow-visible" data-tour="lines">
    <% if sale.lines.any? %>
      <ul class="divide-y divide-gray-100">
        <% sale.lines.includes(product: [ :unit, :product_units ], product_unit: :unit).each do |line| %>
          <%= render "pos/line", line: line %>
        <% end %>
      </ul>
    <% else %>
      <p class="p-8 text-center text-gray-500 @lg:px-6">Scan or tap products to start a sale.</p>
      <button type="button" class="btn-secondary mx-auto flex md:hidden" data-pane="products" data-action="till-panes#show">Choose products</button>
    <% end %>
  </div>

  <%# Kept short so the lines above get the height: items and tax share a quiet row. %>
  <div class="border-t border-gray-200 px-4 py-2 text-sm leading-snug @lg:px-6" data-tour="totals">
    <div class="flex justify-between text-gray-500"><span>Items <span class="tabular-nums text-gray-900"><%= quantity(sale.item_count) %></span></span><span>incl. tax <span class="tabular-nums"><%= money(sale.tax_cents) %></span></span></div>
    <div class="mt-0.5 flex justify-between"><span>Subtotal</span><span class="tabular-nums"><%= money(sale.subtotal_cents) %></span></div>
    <details class="group">
      <summary class="flex cursor-pointer list-none justify-between select-none pointer-coarse:py-2">
        <span class="link">Discount</span><span class="tabular-nums"><%= sale.discount_cents.positive? ? "−#{money(sale.discount_cents)}" : "—" %></span>
      </summary>
      <%= form_with url: pos_discount_path, method: :patch, class: "mt-2 flex gap-2" do |form| %>
        <%= form.text_field :discount, value: (plain_number(sale.discount) if sale.discount_cents.positive?), placeholder: "500 or 10%", class: "input py-1", "aria-label": "Sale discount" %>
        <%= form.password_field :approval_pin, inputmode: "numeric", placeholder: "Manager PIN", class: "input w-32 py-1", "aria-label": "Manager approval PIN", autocomplete: "off" %>
        <%= form.submit "Apply", class: "btn-secondary py-1" %>
      <% end %>
    </details>
    <div class="mt-0.5 flex items-baseline justify-between text-2xl font-extrabold"><span>Total</span><span class="tabular-nums"><%= money(sale.total_cents) %></span></div>
  </div>

  <% if sale.lines.any? %>
    <%= render(sale.total_cents.zero? ? "pos/free_completion" : "pos/payment", sale: sale) %>
  <% end %>
</div>
