<%# Airtel Money at the till: send a prompt to the customer's phone, or use a payment that arrived after the till stopped waiting. %>
<div class="mt-3 hidden space-y-3 border-t border-gray-200 pt-3" data-payment-target="airtelFields">
  <%= form_with url: pos_airtel_requests_path, class: "flex items-end gap-2" do |form| %>
    <div class="flex-1">
      <%= form.label :phone, "Send a prompt to pay #{money(((due + 99) / 100) * 100)} with #{merchant.label}", class: "label" %>
      <%= form.telephone_field :phone, value: PhoneNumber.display(sale.customer&.phone), placeholder: "0733 000 111", required: true,
            autocomplete: "off", inputmode: "tel", class: "input" %>
    </div>
    <%= form.submit "Send prompt", class: "btn-secondary py-2.5" %>
  <% end %>

  <% received = sale.account.airtel_requests.unused.usable_by(current_membership, at: sale.register).where(created_at: 1.day.ago..).order(created_at: :desc).limit(5) %>
  <% if received.any? %>
    <div>
      <p class="label">Received on Airtel Money, not used yet</p>
      <ul class="divide-y divide-gray-200 rounded-md border border-gray-200 bg-white text-sm">
        <% received.each do |request| %>
          <li class="flex items-center justify-between gap-2 px-2 py-1.5">
            <span class="min-w-0"><span class="font-mono"><%= request.airtel_money_id %></span>
              <span class="block truncate text-xs text-gray-500"><%= l(request.resolved_at, format: "%H:%M") %> · <%= PhoneNumber.display(request.phone) %></span></span>
            <span class="flex items-center gap-2 whitespace-nowrap tabular-nums"><%= money(request.whole_shillings * 100) %>
              <%= button_to "Use", pos_airtel_matches_path, params: { request_id: request.id }, class: "btn-secondary px-2 py-1 text-xs" %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
