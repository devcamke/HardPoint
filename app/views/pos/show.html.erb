<% content_for :title, "Till" %>

<div class="grid h-[calc(100vh-3.25rem)] grid-cols-1 lg:grid-cols-[minmax(0,1fr)_30rem]">
  <section class="flex min-h-0 flex-col gap-4 overflow-y-auto p-4">
    <% if @completed_sale %>
      <%= render "pos/completed", sale: @completed_sale %>
    <% end %>
    <% if notice || alert %>
      <%= render "pos/message", message: notice, alert: alert %>
    <% else %>
      <%= render "pos/message", message: nil, alert: nil %>
    <% end %>

    <%= form_with url: pos_lines_path, class: "flex gap-2", data: { controller: "scanner", scanner_search_url_value: pos_products_path,
          action: "turbo:submit-end->scanner#reset" } do |form| %>
      <%= form.search_field :code, autofocus: true, autocomplete: "off", placeholder: "Scan a barcode, or type to search products",
            class: "input py-3 text-lg", "aria-label": "Scan or search", data: { scanner_target: "input", shortcuts_target: "scanner",
            action: "input->scanner#search keydown.esc->scanner#clear" } %>
      <%= form.submit "Add", class: "btn-secondary px-5" %>
    <% end %>

    <%= turbo_frame_tag "search_results", src: pos_products_path, loading: :eager do %>
      <p class="hint">Loading…</p>
    <% end %>

    <div class="mt-auto flex flex-wrap gap-2 text-sm">
      <%= link_to "Parked sales (#{current_shift.sales.parked.count})", pos_parked_sales_path, class: "btn-secondary" %>
      <%= link_to "Collect an order", customer_orders_path(status: "open"), class: "btn-secondary" %>
      <% if feature?(:deliveries) %>
      <details class="relative">
        <summary class="btn-secondary cursor-pointer list-none">Add transport</summary>
        <%= form_with url: pos_transport_path, class: "absolute bottom-full left-0 z-10 mb-2 w-72 space-y-2 rounded-lg border border-gray-200 bg-white p-3 shadow-lg" do |form| %>
          <div><%= form.label :amount, "Transport (#{Current.account.currency})", class: "label" %>
            <%= form.number_field :amount, step: "0.01", min: 0, required: true, class: "input py-1.5" %></div>
          <div><%= form.label :destination, "To", class: "label" %>
            <%= form.text_field :destination, value: @sale.customer&.address, placeholder: "Site or area", class: "input py-1.5" %></div>
          <%= form.submit "Add to sale", class: "btn-primary w-full" %>
        <% end %>
      </details>
      <% end %>
      <%= button_to "Park this sale", pos_parking_path, class: "btn-secondary", form: { data: { shortcuts_target: "park" } } %>
      <%= button_to "Clear sale", pos_discard_path, class: "btn-danger", form: { data: { turbo_confirm: "Clear everything in this sale?" } } %>
    </div>
  </section>

  <aside class="flex min-h-0 flex-col border-l border-gray-200 bg-white">
    <%= render "pos/cart", sale: @sale %>
  </aside>
</div>
