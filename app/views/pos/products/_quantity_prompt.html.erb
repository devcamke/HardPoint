<%# Asks how many before a tapped tile goes on the sale (quantity_prompt_controller). %>
<% step = "flex size-12 shrink-0 cursor-pointer items-center justify-center rounded-md border border-gray-300 bg-white text-2xl font-semibold text-gray-700 select-none hover:bg-gray-50 active:bg-primary-50" %>
<dialog data-quantity-prompt-target="dialog" data-action="click->quantity-prompt#closeOnBackdrop" aria-labelledby="quantity_prompt_name"
        class="m-auto w-[min(24rem,calc(100vw-2rem))] rounded-lg bg-white p-0 text-gray-800 shadow-2xl backdrop:bg-gray-900/40">
  <%= form_with url: pos_lines_path, class: "space-y-4 p-5", data: { quantity_prompt_target: "form", turbo_frame: "_top",
        action: "turbo:submit-end->quantity-prompt#submitted" } do |form| %>
    <%= hidden_field_tag :product_id, nil, id: nil, data: { quantity_prompt_target: "productId" } %>
    <%= hidden_field_tag :product_unit_id, nil, id: nil, data: { quantity_prompt_target: "productUnitId" } %>

    <div class="text-center">
      <h2 id="quantity_prompt_name" class="text-lg font-semibold leading-snug" data-quantity-prompt-target="name"></h2>
      <p class="text-sm text-gray-500"><span data-quantity-prompt-target="price"></span> each</p>
    </div>

    <div>
      <label for="quantity_prompt_quantity" class="sr-only">Quantity</label>
      <div class="flex items-center justify-center gap-3">
        <button type="button" class="<%= step %>" data-action="quantity-prompt#less" aria-label="One less">−</button>
        <%= number_field_tag :quantity, 1, id: "quantity_prompt_quantity", min: 1, step: 1, required: true, inputmode: "decimal", autocomplete: "off",
              class: "input w-32 py-2.5 text-center text-2xl font-semibold tabular-nums [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none", data: { quantity_prompt_target: "quantity" } %>
        <button type="button" class="<%= step %>" data-action="quantity-prompt#more" aria-label="One more">+</button>
      </div>
      <p class="mt-1.5 text-center text-sm text-gray-500" data-quantity-prompt-target="unit"></p>
    </div>

    <div class="flex gap-2">
      <button type="button" class="btn-secondary flex-1 py-2.5" data-action="quantity-prompt#close">Cancel</button>
      <%= form.submit "Add to sale", class: "btn-primary flex-1 py-2.5" %>
    </div>
  <% end %>
</dialog>
