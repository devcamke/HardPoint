<% due = sale.balance_due_cents %>
<div class="border-t border-gray-200 bg-gray-50 px-4 py-3" data-controller="payment" data-payment-due-value="<%= due %>">
  <% if sale.payments.any? %>
    <ul class="mb-2 space-y-1 text-sm">
      <% sale.payments.each do |payment| %>
        <li class="flex items-center justify-between">
          <span><%= payment.label %><%= " · #{payment.reference}" if payment.reference %></span>
          <span class="flex items-center gap-2 tabular-nums"><%= money(payment.amount_cents) %>
            <%= button_to "✕", pos_payment_path(payment), method: :delete, class: "text-gray-400 hover:text-red-700", "aria-label": "Remove payment" %></span>
        </li>
      <% end %>
    </ul>
    <p class="mb-2 flex justify-between font-semibold"><span>Still due</span><span class="tabular-nums"><%= money(due) %></span></p>
  <% end %>

  <% if (waiting = sale.stk_requests.pending.last) %>
    <%= render "pos/mpesa_waiting", stk_request: waiting %>
  <% end %>

  <%= form_with url: pos_payments_path, data: { action: "turbo:submit-end->payment#reset" } do |form| %>
    <% tenders = [ [ "cash", "Cash" ], [ "mobile_money", "M-Pesa" ], [ "card", "Card" ], [ "on_account", "Account" ] ]
       deposit = sale.deposit_available_cents
       tenders << [ "deposit", "Deposit" ] if deposit.positive?
       foreign = Current.account.currencies.at_till.alphabetically.to_a
       tenders << [ "foreign_cash", "Foreign" ] if foreign.any?
       # After a refused payment (e.g. over the credit limit), the same tender stays chosen.
       chosen_tender = params[:tender].presence_in(tenders.map(&:first)) || "cash" %>
    <% if deposit.positive? %>
      <p class="mb-2 text-sm"><%= sale.customer_order.reference %> has a <strong><%= money(deposit) %></strong> deposit to use.</p>
    <% end %>
    <fieldset class="mb-2 grid <%= { 4 => "grid-cols-4", 5 => "grid-cols-5", 6 => "grid-cols-3" }.fetch(tenders.size, "grid-cols-4") %> gap-1 text-sm" data-action="change->payment#switchTender">
      <legend class="sr-only">Payment method</legend>
      <% tenders.each do |value, label| %>
        <label class="cursor-pointer rounded-md border border-gray-300 bg-white py-2 text-center font-semibold select-none pointer-coarse:py-3 has-checked:border-primary-500 has-checked:bg-primary-500 has-checked:text-white">
          <%= form.radio_button :tender, value, checked: value == chosen_tender, class: "sr-only" %><%= label %>
        </label>
      <% end %>
    </fieldset>

    <div class="flex items-end gap-2">
      <div class="flex-1" data-payment-target="cashFields">
        <%= form.label :tendered, "Cash received", class: "label" %>
        <%= form.number_field :tendered, step: "0.01", min: 0, placeholder: plain_number(BigDecimal(due) / 100), class: "input text-lg tabular-nums",
              data: { payment_target: "tendered", shortcuts_target: "pay", action: "input->payment#showChange focus->payment#openKeypad" } %>
      </div>
      <div class="hidden flex-1" data-payment-target="otherFields">
        <%= form.label :amount, "Amount", class: "label" %>
        <%= form.number_field :amount, step: "0.01", min: 0, value: plain_number(BigDecimal(due) / 100), class: "input text-lg tabular-nums", data: { payment_target: "amount", action: "focus->payment#openKeypad", deposit: (plain_number(BigDecimal([ deposit, due ].min) / 100) if deposit.positive?) } %>
      </div>
      <% if foreign.any? %>
        <div class="hidden flex-1" data-payment-target="foreignFields">
          <%= form.label :foreign_tendered, "Notes received", class: "label" %>
          <div class="flex gap-1">
            <%= form.select :currency, foreign.map { [ _1.code, _1.code, { data: { rate: _1.rate.to_s, decimals: Currency.decimals(_1.code) } } ] }, {},
                  class: "input w-24", "aria-label": "Currency", data: { payment_target: "currency", action: "change->payment#showChange" } %>
            <%= form.number_field :foreign_tendered, step: "0.01", min: 0, class: "input text-lg tabular-nums", "aria-label": "Foreign amount received",
                  data: { payment_target: "foreignTendered", action: "input->payment#showChange focus->payment#openKeypad" } %>
          </div>
        </div>
      <% end %>
      <div class="hidden flex-1" data-payment-target="referenceField">
        <%= form.label :reference, "Code", class: "label" %>
        <%= form.text_field :reference, autocomplete: "off", placeholder: "e.g. SJK4H7T2QP", class: "input font-mono uppercase" %>
      </div>
      <% unless current_membership.approver? %>
        <div class="hidden w-32" data-payment-target="approvalField">
          <%= form.label :approval_pin, "Manager PIN", class: "label", title: "Needed to go over the customer's credit limit" %>
          <%= form.password_field :approval_pin, inputmode: "numeric", autocomplete: "off", placeholder: "Over limit", class: "input" %>
        </div>
      <% end %>
      <button type="button" class="btn-secondary hidden size-11 shrink-0 p-0 pointer-coarse:inline-flex aria-expanded:border-primary-500 aria-expanded:bg-primary-50" title="Number pad"
              aria-label="Number pad" aria-expanded="false" data-payment-target="keypadToggle" data-action="payment#toggleKeypad">
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true"><% [ 5, 12, 19 ].product([ 5, 12, 19 ]).each do |x, y| %><circle cx="<%= x %>" cy="<%= y %>" r="2.2"/><% end %></svg>
      </button>
    </div>

    <div class="mt-2 flex flex-wrap gap-1" data-payment-target="quickCash">
      <% [ due, *[ 100_00, 500_00, 1000_00 ].map { |step| ((due + step - 1) / step) * step } ].uniq.select(&:positive?).first(4).each do |amount| %>
        <button type="button" class="btn-secondary px-2 py-1 text-xs select-none active:bg-primary-100" data-action="payment#fill" data-amount="<%= plain_number(BigDecimal(amount) / 100) %>"><%= money(amount) %></button>
      <% end %>
    </div>
    <%# A number pad for touch screens, typing into whichever amount the chosen tender uses. It opens when the amount is
        tapped, or with the button beside it, and each till remembers whether it was left open. %>
    <div class="mt-2 hidden grid-cols-4 gap-1.5" data-payment-target="keypad" aria-label="Number pad">
      <% key = "btn-secondary min-h-11 text-lg tabular-nums select-none active:bg-primary-100" %>
      <% [ *%w[ 7 8 9 ], [ "⌫", "back", "Delete a digit" ], *%w[ 4 5 6 ], [ "C", "clear", "Clear" ], *%w[ 1 2 3 00 ] ].each do |label, value, name| %>
        <button type="button" class="<%= key %>" data-action="payment#press" data-key="<%= value || label %>" aria-label="<%= name || label %>"><%= label %></button>
      <% end %>
      <button type="button" class="<%= key %> col-span-2" data-action="payment#press" data-key="0">0</button>
      <button type="button" class="<%= key %>" data-action="payment#press" data-key=".">.</button>
      <button type="button" class="<%= key %> text-sm" data-action="payment#press" data-key="exact" data-payment-target="exactKey" title="The amount due">Exact</button>
    </div>
    <p class="mt-1 h-5 text-sm font-semibold text-green-800" data-payment-target="change"></p>

    <%= form.submit "Take payment", class: "btn-primary mt-1 w-full py-3 text-lg" %>
  <% end %>

  <% if (shortcode = Mpesa::Shortcode.for_branch(sale.branch)) && !waiting %>
    <%= render "pos/mpesa", sale: sale, shortcode: shortcode, due: due %>
  <% end %>
</div>
