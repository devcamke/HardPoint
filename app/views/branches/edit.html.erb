<% content_for :title, "Edit #{@branch.name}" %>

<h1 class="mb-6 text-xl font-medium">Edit <%= @branch.name %></h1>

<div class="card max-w-xl">
  <%= render "form", branch: @branch %>
</div>

<% unless current_membership.bound_to_branch? %>
  <%= button_to "Remove branch", branch_path(@branch), method: :delete, class: "btn-danger mt-6",
        form: { data: { turbo_confirm: "Remove #{@branch.name}?" } } %>
<% end %>
