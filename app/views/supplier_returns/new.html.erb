<% content_for :title, "Return goods" %>
<% supplier_return = @supplier_return %>
<% receipt = supplier_return.goods_receipt %>

<p class="text-sm"><%= link_to receipt ? "← #{receipt.reference}" : "← Returns", receipt || supplier_returns_path, class: "link" %></p>
<h1 class="mt-2 mb-2 text-3xl font-bold">Return goods<%= " to #{supplier_return.supplier.name}" if supplier_return.supplier %></h1>
<p class="hint mb-6 max-w-3xl">The goods come out of stock now, and a debit note for what they cost, with VAT, comes off what you owe the supplier.
  Note the supplier's credit note number when it arrives.</p>

<%= form_with model: supplier_return, class: "card max-w-4xl" do |form| %>
  <%= render "shared/errors", model: supplier_return %>
  <%= form.hidden_field :goods_receipt_id %>

  <div class="grid gap-4 sm:grid-cols-3">
    <% if receipt %>
      <div class="field"><p class="label">Supplier</p><p class="py-2"><%= receipt.supplier.name %></p></div>
      <div class="field"><p class="label">From</p><p class="py-2"><%= receipt.branch.name %> · delivery <%= receipt.reference %></p></div>
    <% else %>
      <div class="field"><%= form.label :supplier_id, "Supplier", class: "label" %><%= form.collection_select :supplier_id, Current.account.suppliers.active.alphabetically, :id, :name, { prompt: "Choose…" }, required: true, class: "input" %></div>
      <div class="field"><%= form.label :branch_id, "From", class: "label" %><%= form.collection_select :branch_id, branches_for_selection, :id, :name, {}, class: "input" %></div>
    <% end %>
    <div class="field"><%= form.label :reason, class: "label" %><%= form.select :reason, SupplierReturn::REASONS.map { [ _1.humanize, _1 ] }, {}, class: "input" %></div>
  </div>

  <table class="table mb-4">
    <thead><tr><th>Product</th><% if receipt %><th class="text-right">Received</th><% end %><th class="text-right">Going back</th><th class="text-right">Unit cost (blank: as paid)</th><th>Batch</th></tr></thead>
    <tbody>
      <%= form.fields_for :lines do |line| %>
        <% product = line.object.product %>
        <tr>
          <td>
            <% if receipt && product %>
              <%= line.hidden_field :product_id %><%= product.name %> <span class="font-mono text-xs text-steel-600"><%= product.sku %></span>
            <% else %>
              <%= line.text_field :product_code, value: line.object.product_code || product&.sku, placeholder: "Scan or type", class: "input py-1.5 font-mono", "aria-label": "Barcode or SKU" %>
            <% end %>
          </td>
          <% if receipt %><td class="text-right tabular-nums"><%= quantity(receipt.lines.find { _1.product_id == product&.id }&.quantity) %></td><% end %>
          <td class="text-right"><%= line.number_field :quantity, value: plain_number(line.object.quantity), step: "any", min: 0, class: "input w-24 py-1.5 text-right", "aria-label": "Quantity going back" %></td>
          <td class="text-right"><%= line.number_field :unit_cost, value: (plain_number(line.object.unit_cost) if line.object.unit_cost_cents), step: "0.01", min: 0, class: "input w-32 py-1.5 text-right", "aria-label": "Unit cost" %></td>
          <td>
            <% if product&.tracks_batches? %>
              <%= line.select :stock_batch_id, product.stock_batches.in_stock.where(branch: supplier_return.branch).by_expiry.map { [ "#{_1.number} (#{plain_number(_1.quantity)})", _1.id ] },
                    { include_blank: "First to expire" }, class: "input py-1.5", "aria-label": "Batch" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="field"><%= form.label :note, "Note (on the debit note)", class: "label" %><%= form.text_field :note, class: "input", placeholder: "e.g. 3 bags split in delivery, photos sent on WhatsApp" %></div>
  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit "Record return", class: "btn-primary", data: { turbo_confirm: "Take these goods out of stock and raise the debit note?" } %>
    <% if supplier_return.supplier&.email.present? || supplier_return.supplier.nil? %>
      <label class="flex items-center gap-2 text-sm"><%= check_box_tag :email, "1", true, class: "size-4 accent-safety-500" %> Email the debit note to the supplier</label>
    <% end %>
  </div>
<% end %>
