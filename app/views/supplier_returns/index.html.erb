<% content_for :title, "Returns to suppliers" %>

<%= render "shared/control_panel",
      title: "Returns to suppliers",
      new_button: ([ "New", new_supplier_return_path ] if current_membership.can_purchase?),
      search: { placeholder: "Supplier" },
      filters: [ search_filter(:filter, label: "Status", value: (@filter == "awaiting" ? nil : "all"), clear: nil,
                   options: [ [ "all", "Include credited returns" ] ]) ],
      records: @supplier_returns %>

<div class="card overflow-x-auto">
  <% if @supplier_returns.any? %>
    <table class="table">
      <thead><tr><th>Debit note</th><th>Supplier</th><th>From</th><th>Date</th><th>Reason</th><th class="text-right">Amount</th><th>Credit note</th></tr></thead>
      <tbody>
        <% @supplier_returns.each do |supplier_return| %>
          <tr id="<%= dom_id(supplier_return) %>">
            <td><%= link_to supplier_return.reference, supplier_return, class: "link font-mono" %></td>
            <td><%= supplier_return.supplier.name %></td>
            <td><%= supplier_return.branch.name %></td>
            <td class="whitespace-nowrap"><%= l(supplier_return.created_at.to_date, format: :short) %></td>
            <td><%= supplier_return.reason.humanize %></td>
            <td class="text-right tabular-nums"><%= money(supplier_return.total_cents, currency: supplier_return.currency) %></td>
            <td><%= supplier_return.credited? ? tag.span(supplier_return.credit_note_number, class: "font-mono text-sm") : status_dot("Waiting", :warning) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500"><%= @filter == "awaiting" ? "Every return has its credit note." : "Nothing sent back to suppliers yet." %>
      Damaged or wrong goods go back with a debit note, from the delivery they came on or by scanning them.</p>
  <% end %>
</div>
