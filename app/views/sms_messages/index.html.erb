<% content_for :title, "Texts sent" %>
<h1 class="mb-6 text-xl font-medium"><%= link_to "Shop details", edit_account_path(anchor: "sms"), class: "link" %> <span class="text-gray-400">/</span> Texts sent</h1>

<div class="card">
  <% if @messages.any? %>
    <table class="table">
      <thead><tr><th>When</th><th>To</th><th>What</th><th>Message</th><th>By</th><th>Status</th></tr></thead>
      <tbody>
        <% @messages.each do |message| %>
          <tr>
            <td class="whitespace-nowrap"><%= l(message.created_at, format: :short) %></td>
            <td class="whitespace-nowrap"><%= PhoneNumber.display(message.recipient) %></td>
            <td><%= message.purpose.humanize %></td>
            <td class="max-w-md text-sm"><%= message.body %></td>
            <td><%= message.sender&.name %></td>
            <td><span class="badge <%= { "sent" => "bg-green-50 text-green-800", "failed" => "bg-red-50 text-red-800" }[message.status] %>" title="<%= message.error %>"><%= message.status.humanize %></span>
              <%= tag.span(message.cost, class: "block text-xs text-gray-500") if message.cost %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="hint">No texts yet.</p>
  <% end %>
</div>
<%= render "shared/pagination" %>
