<% content_for :title, "Help centre" %>
<% content_for :description, "Guides to running a hardware store on HardPoint: selling at the till, M-Pesa, KRA eTIMS, stock takes, buying from suppliers, customer accounts, reports and more." %>
<% content_for :noindex, true if @query.present? %>
<%# The help centre in the public site's look (landing.css): a big search box on its shadow, the walkthroughs as
    picture tiles, then every guide by section as outlined tiles that lift when pointed at. %>

<div class="lp">
  <%= render "pages/page_head", kicker: "Help centre", title: "How can we help?",
        lede: "Guides to setting up and running your shop on HardPoint, written for the counter." do %>
    <%= form_with url: help_path, method: :get, class: "lp-search mt-[32px]" do |form| %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <%= form.search_field :q, value: @query, placeholder: "Printer, M-Pesa, import…", aria: { label: "Search the help centre" } %>
      <%= form.submit "Search", class: "lp-btn", name: nil %>
    <% end %>
  <% end %>

  <div class="lp-wrap lp-mid pb-[96px]">
  <% if @query.present? %>
    <p class="lp-fine mb-[18px]">
      <%= @articles.empty? ? "No guides mention \"#{@query}\"." : "#{pluralize(@articles.size, "guide")} #{@articles.one? ? "mentions" : "mention"} \"#{@query}\"." %>
      <%= link_to "Show all guides", help_path %>
    </p>
    <% if @articles.empty? %>
      <p class="lp-lede mt-[0]">Try a shorter word (printer, M-Pesa, import, VAT), or <%= link_to "ask us on WhatsApp", whatsapp_support_url("Hello HardPoint, I need help with: #{@query}"), class: "lp-link", target: "_blank", rel: "noopener" %>.</p>
    <% end %>
    <div class="lp-tiles lp-tiles-2">
      <%= render partial: "help/article_card", collection: @articles, as: :article, locals: { show_section: true } %>
    </div>
  <% else %>
    <div class="lp-panel">
      <p class="lp-kicker mb-[6px]">New to HardPoint?</p>
      <p class="m-0 text-[18px] leading-[1.55]">
        Start with <%= link_to "Setting up your shop", help_article_path("getting-started"), class: "lp-link" %>, then
        <%= link_to "Finding your way around", help_article_path("getting-around"), class: "lp-link" %> and
        <%= link_to "Selling at the till", help_article_path("selling"), class: "lp-link" %>. Each guide ends with what to read next.
      </p>
    </div>

    <h2 class="mt-[72px] text-[clamp(30px,_4vw,_44px)]">Show me how.</h2>
    <p class="lp-lede mt-[10px]">Walkthroughs of real screens: press a number on the picture to see what that button does.</p>
    <div class="lp-tiles lp-tiles-3 mt-[26px]">
      <% HelpTour.all.sort_by { HelpArticle::SECTIONS.index(_1.section) }.each do |tour| %>
        <%= link_to help_article_path(tour.article, anchor: "walkthrough-#{tour.id}"), class: "lp-tile p-[0] overflow-hidden" do %>
          <span class="relative block border-b-2 border-(--lp-edge)">
            <%= image_tag tour.image, alt: "", width: tour.image_size[0], height: tour.image_size[1], loading: "lazy", class: "block aspect-[16/10] w-full object-cover object-top" %>
            <span class="absolute right-2 bottom-2 rounded-full bg-(--lp-deep) px-2.5 py-0.5 text-xs font-semibold text-white"><%= pluralize(tour.placed_steps.size, "step") %></span>
          </span>
          <span class="block p-[14px_18px_16px]">
            <span class="lp-tile-title"><%= tour.title %></span>
            <span class="lp-tile-text"><%= tour.summary %></span>
          </span>
        <% end %>
      <% end %>
    </div>

    <% HelpArticle::SECTIONS.each do |section| %>
      <% articles = @articles.select { _1.section == section } %>
      <% next if articles.empty? %>
      <h2 class="mt-[72px] mx-0 mb-[22px] text-[clamp(30px,_4vw,_44px)]"><%= section %>.</h2>
      <div class="lp-tiles lp-tiles-2">
        <%= render partial: "help/article_card", collection: articles, as: :article, locals: { show_section: false } %>
      </div>
    <% end %>
  <% end %>

  <div class="lp-panel-quiet mt-[72px]">
    <h2 class="text-[28px]">Still stuck?</h2>
    <p class="mt-[10px] mx-0 mb-[0] text-(--lp-muted)">Signed in to your shop, open your name in the top right and choose <strong class="text-(--lp-ink)">Contact support</strong>: we’ll see which page you were on.</p>
    <%= link_to whatsapp_support_url, class: "lp-btn lp-btn-ghost lp-btn-small mt-[18px]", target: "_blank", rel: "noopener" do %>Chat with us on WhatsApp<% end %>
  </div>
  </div>
</div>
