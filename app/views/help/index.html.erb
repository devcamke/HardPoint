<% content_for :title, "Help centre" %>

<section class="bg-primary-500 text-white">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold">Help centre</h1>
    <p class="mt-2 text-white/90">Guides to setting up and running your shop on HardPoint.</p>
    <%= form_with url: help_path, method: :get, class: "mt-6 flex gap-2" do |form| %>
      <%= form.search_field :q, value: @query, placeholder: "Search the guides, e.g. printer, M-Pesa, import", class: "input flex-1 rounded! border-0! bg-white! px-3! text-gray-900", aria: { label: "Search the help centre" } %>
      <%= form.submit "Search", class: "btn bg-white text-primary-600 hover:bg-gray-100", name: nil %>
    <% end %>
  </div>
</section>

<section class="mx-auto max-w-3xl px-4 py-12">
  <% if @query.present? %>
    <p class="mb-4 text-sm text-gray-500">
      <%= @articles.empty? ? "No guides mention \"#{@query}\"." : "#{pluralize(@articles.size, "guide")} #{@articles.one? ? "mentions" : "mention"} \"#{@query}\"." %>
      <%= link_to "Show all guides", help_path, class: "link" %>
    </p>
    <% if @articles.empty? %>
      <p class="text-gray-700">Try a shorter word (printer, M-Pesa, import, VAT), or <%= link_to "ask us on WhatsApp", whatsapp_support_url("Hello HardPoint, I need help with: #{@query}"), class: "link", target: "_blank", rel: "noopener" %>.</p>
    <% end %>
    <div class="space-y-3">
      <%= render partial: "help/article_card", collection: @articles, as: :article, locals: { show_section: true } %>
    </div>
  <% else %>
    <div class="rounded-lg border border-primary-200 bg-primary-50 p-5">
      <p class="font-semibold">New to HardPoint?</p>
      <p class="mt-1 text-sm text-gray-700">
        Start with <%= link_to "Setting up your shop", help_article_path("getting-started"), class: "link" %>, then
        <%= link_to "Finding your way around", help_article_path("getting-around"), class: "link" %> and
        <%= link_to "Selling at the till", help_article_path("selling"), class: "link" %>. Each guide ends with what to read next.
      </p>
    </div>

    <% HelpArticle::SECTIONS.each do |section| %>
      <% articles = @articles.select { _1.section == section } %>
      <% next if articles.empty? %>
      <h2 class="mt-10 mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500"><%= section %></h2>
      <div class="space-y-3">
        <%= render partial: "help/article_card", collection: articles, as: :article, locals: { show_section: false } %>
      </div>
    <% end %>
  <% end %>

  <div class="mt-12 rounded-lg border border-amber-200 bg-amber-50 p-5">
    <p class="font-semibold">Still stuck?</p>
    <p class="mt-1 text-sm text-gray-700">Signed in to your shop, open your name in the top right and choose <strong>Contact support</strong>: we'll see which page you were on. Or chat with us on <%= link_to "WhatsApp", whatsapp_support_url, class: "link", target: "_blank", rel: "noopener" %>.</p>
  </div>
</section>
