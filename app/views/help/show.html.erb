<% content_for :title, @article.title %>

<article class="mx-auto max-w-3xl px-4 py-12">
  <p class="text-sm"><%= link_to "← Help centre", help_path, class: "link" %> · <span class="text-gray-500"><%= @article.section %></span></p>
  <h1 class="mt-3 text-3xl font-semibold"><%= @article.title %></h1>
  <p class="mt-2 text-lg text-gray-500"><%= @article.summary %></p>

  <div class="help-article mt-8 space-y-4 leading-relaxed text-gray-700">
    <%= render @article.partial %>
  </div>

  <div class="mt-12 border-t border-gray-200 pt-6 text-sm text-gray-500">
    Didn't answer your question? <%= link_to "Chat with us on WhatsApp", whatsapp_support_url("Hello HardPoint, about \"#{@article.title}\": "), class: "link", target: "_blank", rel: "noopener" %>.
  </div>
</article>
