<% content_for :title, "#{@article.title} · Help centre" %>
<% content_for :description, @article.summary %>
<% structured_data(*seo_help_article(@article)) %>
<%# One guide in the public site's look (landing.css): the article in .lp-doc's reading type, then what to read next
    as an outlined panel, related guides as tiles, and a person to ask. %>

<div class="lp">
  <article>
    <%= render "pages/page_head", title: @article.title, lede: @article.summary, center: false,
          crumb: safe_join([ link_to(safe_join([ tag.span("‹", aria: { hidden: true }), " Help centre" ]), help_path), tag.span("·", aria: { hidden: true }), @article.section ], " ") %>

    <div class="lp-wrap pb-[64px]">
      <div class="lp-head max-w-[760px]">
        <div class="help-article lp-doc">
          <%= render @article.partial %>
        </div>

        <% if (next_article = @article.next_article) %>
          <%= link_to help_article_path(next_article), class: "lp-tile mt-[44px] p-[20px_22px]" do %>
            <span class="lp-tile-eyebrow">Next in <%= @article.section %></span>
            <span class="lp-tile-title text-[20px]"><%= next_article.title %> ›</span>
            <span class="lp-tile-text"><%= next_article.summary %></span>
          <% end %>
        <% end %>

        <% related = @article.related_articles - [ next_article ] %>
        <% if related.any? %>
          <h2 class="mt-[36px] mx-0 mb-[14px] text-[22px]">Related guides</h2>
          <div class="lp-tiles">
            <%= render partial: "help/article_card", collection: related, as: :article, locals: { show_section: false } %>
          </div>
        <% end %>

        <p class="lp-fine mt-[48px] pt-[20px] border-t-2 border-(--lp-edge)">
          Didn’t answer your question? <%= link_to "Chat with us on WhatsApp", whatsapp_support_url("Hello HardPoint, about \"#{@article.title}\": "), target: "_blank", rel: "noopener" %>,
          or, signed in to your shop, choose <strong>Contact support</strong> under your name in the top right.
        </p>
      </div>
    </div>
  </article>
</div>
