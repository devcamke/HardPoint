<% content_for :title, @article.title %>

<article class="mx-auto max-w-3xl px-4 py-12">
  <p class="text-sm"><%= link_to "← Help centre", help_path, class: "link" %> · <span class="text-gray-500"><%= @article.section %></span></p>
  <h1 class="mt-3 text-3xl font-semibold"><%= @article.title %></h1>
  <p class="mt-2 text-lg text-gray-500"><%= @article.summary %></p>

  <div class="help-article mt-8 space-y-4 leading-relaxed text-gray-700">
    <%= render @article.partial %>
  </div>

  <% if (next_article = @article.next_article) %>
    <%= link_to help_article_path(next_article), class: "card mt-12 block hover:border-primary-300" do %>
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Next in <%= @article.section %></p>
      <p class="mt-1 font-semibold"><%= next_article.title %> →</p>
      <p class="mt-1 text-sm text-gray-500"><%= next_article.summary %></p>
    <% end %>
  <% end %>

  <% related = @article.related_articles - [ next_article ] %>
  <% if related.any? %>
    <div class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">Related guides</h2>
      <ul class="mt-2 space-y-1">
        <% related.each do |article| %>
          <li><%= link_to article.title, help_article_path(article), class: "link" %> <span class="text-sm text-gray-500">· <%= article.summary %></span></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-12 border-t border-gray-200 pt-6 text-sm text-gray-500">
    Didn't answer your question? <%= link_to "Chat with us on WhatsApp", whatsapp_support_url("Hello HardPoint, about \"#{@article.title}\": "), class: "link", target: "_blank", rel: "noopener" %>,
    or, signed in to your shop, choose <strong>Contact support</strong> under your name in the top right.
  </div>
</article>
