<%# locals: (rebalancing:, branch:) %>
<%# Stock another branch can spare, before ordering more: one card per branch it would come from. %>
<% incoming = rebalancing.into(branch) %>
<% if incoming.any? %>
  <section class="card mb-6 border-primary-200 bg-primary-50/40">
    <h2 class="text-lg font-semibold">Move from another branch first</h2>
    <p class="hint mt-1 mb-3">These are short here but another branch has more than it needs. Moving them is quicker than ordering, and leaves
      the other branch with enough of its own.</p>
    <% incoming.each do |from, moves| %>
      <div class="mt-3 rounded-lg border border-gray-200 bg-white p-3">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <p class="font-medium">From <%= from.name %> <span class="hint font-normal">· <%= pluralize(moves.size, "product") %> · about <%= money(moves.sum(&:value_cents)) %> at cost</span></p>
          <% if current_membership.can_manage_stock? && visible_branches.include?(from) %>
            <%= link_to "Prepare the transfer", new_stock_transfer_path(from_branch_id: from.id, to_branch_id: branch.id,
                  lines: moves.map { { product_id: _1.product.id, quantity: _1.quantity } }), class: "btn-primary" %>
          <% end %>
        </div>
        <ul class="divide-y divide-gray-100 text-sm">
          <% moves.each do |move| %>
            <li class="flex flex-wrap items-baseline justify-between gap-2 py-1.5">
              <span><%= link_to move.product.name, move.product, class: "hover:text-primary-700" %> <span class="hint">· <%= move.reason %></span></span>
              <span class="font-semibold tabular-nums"><%= quantity(move.quantity, move.product.unit) %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>
<% end %>
