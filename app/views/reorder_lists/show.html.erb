<% content_for :title, "Reorder" %>

<% if @suggestion %>
  <% ready = @suggestion.by_supplier.select { |supplier, _| supplier } %>
  <div class="mb-2 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-xl font-medium">Reorder</h1>
    <div class="flex flex-wrap items-center gap-2">
      <%= render "shared/branch_picker" %>
      <% suggested = @suggestion.rows.count(&:suggested_level) %>
      <% if suggested.positive? && current_membership.can_manage_catalogue? %>
        <%= button_to "Use #{pluralize(suggested, "suggested level")}", suggested_reorder_levels_path, params: { branch_id: selected_branch.id }, class: "btn-secondary",
              form: { data: { turbo_confirm: "Set #{pluralize(suggested, "product")}'s reorder level at #{selected_branch.name} to what its sales suggest?" } } %>
      <% end %>
      <% if ready.size > 1 %>
        <%= button_to "Draft #{ready.size} purchase orders", purchase_orders_path, params: { from_suggestions: 1, supplier_id: "all", branch_id: selected_branch.id }, class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <p class="hint mb-4 max-w-3xl">At <%= selected_branch&.name %>: products at or below their reorder level, or selling fast enough to run out before a delivery could arrive.
    Each suggestion learns from this branch: sales over the last <%= Current.account.reorder_lookback_days %> days plus what the till turned away,
    this time last year once there's a year of history, a margin for busy days, and how long each supplier really takes to deliver once it has.
    It covers the lead time plus two weeks, less what's on hand, on order or on its way, rounded up to the supplier's minimum.
    Owners, managers and stock clerks also get the low-stock list by email each morning.</p>

  <%= render "reorder_lists/moves", rebalancing: @rebalancing, branch: selected_branch if @rebalancing && selected_branch %>
  <% incoming_moves = @rebalancing && selected_branch ? @rebalancing.into(selected_branch).values.flatten.group_by(&:product) : {} %>

  <% if @suggestion.rows.empty? %>
    <div class="card"><p class="hint">Nothing needs ordering for this branch right now.</p></div>
  <% end %>

  <% @suggestion.by_supplier.each do |supplier, rows| %>
    <section class="card mb-6">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold"><%= supplier ? link_to(supplier.name, supplier, class: "hover:text-primary-700") : "No supplier set yet" %>
          <span class="hint font-normal">· <%= pluralize(rows.size, "product") %> · about <%= money(rows.sum(&:cost_cents), currency: supplier&.currency_code || Current.account.currency) %></span></h2>
        <% if supplier %>
          <%= button_to "Draft an order for #{supplier.name}", purchase_orders_path, params: { from_suggestions: 1, supplier_id: supplier.id, branch_id: selected_branch.id }, class: ready.size > 1 ? "btn-secondary" : "btn-primary" %>
        <% else %>
          <span class="hint">Add these to a supplier to order them in one click.</span>
        <% end %>
      </div>
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th>Product</th><th class="text-right">On hand</th><th class="text-right">On order</th><th class="text-right">Sold (<%= Current.account.reorder_lookback_days %> days)</th><th class="text-right">Reorder at</th><th class="text-right">Lead time</th><th class="text-right">Order</th><th class="text-right">Cost</th></tr></thead>
          <tbody>
            <% rows.each do |row| %>
              <tr>
                <td><%= link_to row.product.name, row.product, class: "hover:text-primary-700" %>
                  <% if (notes = row.forecast.notes).any? %><span class="block text-xs text-gray-500"><%= notes.join(" · ") %></span><% end %></td>
                <td class="text-right tabular-nums <%= "text-red-700" unless row.on_hand.positive? %>"><%= quantity(row.on_hand, row.product.unit) %>
                  <% if row.held.positive? %><span class="block text-xs font-normal text-gray-600"><%= quantity(row.held) %> held for orders</span><% end %></td>
                <td class="text-right tabular-nums"><%= quantity(row.on_order) %></td>
                <td class="text-right tabular-nums"><%= quantity(row.sold) %></td>
                <td class="text-right tabular-nums"><%= quantity(row.reorder_level) %>
                  <% if row.suggested_level && current_membership.can_manage_catalogue? %>
                    <%= button_to product_reorder_level_path(row.product), method: :patch, params: { branch_id: selected_branch.id, reorder_level: row.suggested_level, return_to: "reorder_list" },
                          class: "mt-0.5 block w-full cursor-pointer text-right text-xs font-normal text-primary-700 hover:underline", form: { class: "inline" },
                          title: "What sales here suggest: enough to last the lead time, plus a margin for busy days" do %>suggest <%= quantity(row.suggested_level) %> · Use<% end %>
                  <% end %></td>
                <td class="text-right"><%= row.lead_time %> days<% if row.forecast.lead_time_measured %><span class="block text-xs text-gray-500">measured</span><% end %></td>
                <td class="text-right font-semibold tabular-nums"><%= quantity(row.quantity, row.product.unit) %>
                  <% if (move = incoming_moves[row.product]) %><span class="block text-xs font-normal text-primary-700">or move <%= quantity(move.sum(&:quantity), row.product.unit) %> first</span><% end %></td>
                <td class="text-right tabular-nums"><%= money(row.cost_cents, currency: supplier&.currency_code || Current.account.currency) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
<% else %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-xl font-medium">Reorder</h1>
    <%= render "shared/branch_picker" %>
  </div>
  <%= render "reorder_lists/moves", rebalancing: @rebalancing, branch: selected_branch if @rebalancing && selected_branch %>

  <p class="hint mb-4">Products at or below their reorder level at <%= selected_branch&.name %>, most urgent first.</p>

  <div class="card">
    <% if @products.any? %>
      <table class="table">
        <thead><tr><th>Product</th><th>SKU</th><th>Category</th><th class="text-right">On hand</th><th class="text-right">Reorder at</th><th class="text-right">Short by</th></tr></thead>
        <tbody>
          <% @products.each do |product| %>
            <tr>
              <td><%= link_to product.name, product, class: "font-medium hover:text-primary-700" %></td>
              <td class="font-mono text-xs"><%= product.sku %></td>
              <td><%= product.category&.name %></td>
              <td class="text-right tabular-nums <%= "text-red-700" if product.stock_quantity <= 0 %>"><%= quantity(product.stock_quantity, product.unit) %></td>
              <td class="text-right tabular-nums"><%= quantity(product.branch_reorder_level, product.unit) %></td>
              <td class="text-right tabular-nums font-semibold"><%= quantity(product.branch_reorder_level - product.stock_quantity, product.unit) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">Nothing is below its reorder level here.</p>
    <% end %>
  </div>
<% end %>
