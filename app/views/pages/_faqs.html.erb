<%# locals: (faqs:) %>
<%# Questions that open on a tap, between ink rules. The + is drawn by CSS so the summary's text is just the question. %>
<div class="lp-qa">
  <% faqs.each do |question, answer| %>
    <details><summary><%= question %></summary><p><%= answer %></p></details>
  <% end %>
</div>
