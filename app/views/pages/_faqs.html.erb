<%# locals: (faqs:) %>
<%# Questions that open on a tap. The + is drawn by CSS so the summary's text is just the question. %>
<div class="space-y-3">
  <% faqs.each do |question, answer| %>
    <details class="group rounded-2xl bg-gray-100 px-6 py-4 open:pb-6">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-gray-950 marker:content-none after:shrink-0 after:text-xl after:text-gray-400 after:transition-transform after:content-['+'] group-open:after:rotate-45 [&::-webkit-details-marker]:hidden"><%= question %></summary>
      <p class="mt-3 leading-relaxed text-gray-600"><%= answer %></p>
    </details>
  <% end %>
</div>
