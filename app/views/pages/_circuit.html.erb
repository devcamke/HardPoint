<%# Decoration: circuit-board traces fanning out of a corner, fading as they leave it. Drawn for the top-left corner;
    the caller flips it into the others (-scale-x-100, -scale-y-100) and positions it. Takes its colour from the text colour. %>
<svg class="pointer-events-none absolute [mask-image:radial-gradient(circle_at_0_0,black_15%,transparent_72%)] <%= classes %>" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <%# Traces in from the left edge. %>
  <path d="M0 60H70L100 90H170"/>
  <path d="M0 100H50L80 130V200"/>
  <path d="M0 140H30L50 160V250L80 280H130"/>
  <path d="M0 200H20V330"/>
  <%# Traces down from the top edge. %>
  <path d="M160 0V30L190 60H260L280 80V120"/>
  <path d="M200 0V20L220 40H310"/>
  <path d="M110 0V40"/>
  <path d="M340 0V16L360 36V80"/>
  <%# A chip and its pins. %>
  <rect x="120" y="130" width="60" height="60" rx="6"/>
  <rect x="134" y="144" width="32" height="32" rx="3" opacity="0.5"/>
  <path d="M120 150H80M140 130V90M180 150H230L250 170V230M180 175H215L235 195M150 190V230L170 250H210"/>
  <%# Solder points: where traces end, and where they join. %>
  <g fill="currentColor" stroke="none">
    <circle cx="170" cy="90" r="3.5"/><circle cx="80" cy="200" r="3.5"/><circle cx="130" cy="280" r="3.5"/><circle cx="20" cy="330" r="3.5"/>
    <circle cx="280" cy="120" r="3.5"/><circle cx="310" cy="40" r="3.5"/><circle cx="110" cy="40" r="3.5"/><circle cx="360" cy="80" r="3.5"/>
    <circle cx="250" cy="230" r="3.5"/><circle cx="235" cy="195" r="3.5"/><circle cx="210" cy="250" r="3.5"/>
    <circle cx="80" cy="150" r="2.5"/><circle cx="140" cy="90" r="2.5"/>
  </g>
  <circle cx="280" cy="120" r="8"/><circle cx="130" cy="280" r="8"/><circle cx="310" cy="40" r="8"/><circle cx="250" cy="230" r="8"/>
</svg>
