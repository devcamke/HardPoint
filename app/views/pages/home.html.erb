</section>

<%# Odoo's "Enterprise software done right": short bold claims, a line each, a link. The two that sell a hardware
    shop in Kenya, M-Pesa and eTIMS, get wide tinted cards; the rest sit in a row of four. Each card wears the
    same tile icon as the grid above, so the page reads as one set. Then everything else as a row of links. %>
<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">The rest of the shop</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Everything a hardware store does. Nothing it doesn’t.</h2>
    </div>

    <dl class="mx-auto mt-14 grid max-w-4xl gap-8 text-center sm:grid-cols-3">
      <div>
        <dt class="text-5xl font-bold tracking-tight text-primary-600 tabular-nums">20,000</dt>
        <dd class="mt-2 text-gray-600">products imported from a spreadsheet in about twelve seconds.</dd>
      </div>
      <div>
        <dt class="text-5xl font-bold tracking-tight text-primary-600">3 keys</dt>
        <dd class="mt-2 text-gray-600">F2 scan, F8 park, F9 pay. Or finger-sized buttons on a touch screen.</dd>
      </div>
      <div>
        <dt class="text-5xl font-bold tracking-tight text-primary-600">Every sale</dt>
        <dd class="mt-2 text-gray-600">signed by KRA eTIMS, with the QR code on the receipt.</dd>
      </div>
    </dl>

    <% claims = [
         [ :mpesa, "M-Pesa", "Money that finds its own sale.", "Send a prompt to the customer’s phone from the till, or let a payment to your Paybill or Till find its sale. Airtel Money, card, foreign notes and cash with change too.", "M-Pesa at the till", "mpesa" ],
         [ :etims, "KRA eTIMS", "The taxman, handled.", "Every sale, void and return signed by KRA, with the QR code on the receipt. Queued and retried if KRA is down, so the queue never stops for the taxman.", "How eTIMS works", "etims" ],
         [ :stock, "Stock", "Never sell what isn’t there.", "Every morning, a list of what customers asked for and couldn’t get. One branch short and another full? It suggests the move before you order.", "Stock and stock takes", "stock-and-stock-takes" ],
         [ :customers, "Customers", "Accounts that get paid.", "Credit limits, statements and a list of who owes you. Accounts too long overdue go on hold, and Monday reminders go out by SMS or WhatsApp.", "Customer accounts", "customer-accounts" ],
         [ :calculator, "Contractors", "A quote before they finish asking.", "A 40 m wall or a 10 × 8 slab becomes stones, cement, sand, ballast and steel at your prices, and one press makes the quote. Each job’s purchases kept together.", "The material calculator", "material-calculator" ],
         [ :fundi, "Fundis", "Fundis’ commission, kept for you.", "The masons, plumbers and electricians who bring you customers earn their commission when the sale is paid, and you pay it out in cash or by M-Pesa.", "Fundis and commission", "fundis" ]
       ] %>
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <% claims.each.with_index do |(icon, label, title, body, link_text, slug), i| %>
        <% featured = i < 2 %>
        <div class="flex flex-col rounded-3xl p-7 <%= featured ? "bg-primary-50 sm:p-8 lg:col-span-2" : "border border-gray-200" %>">
          <div class="flex items-center gap-3">
            <span class="flex size-12 items-center justify-center rounded-xl <%= featured ? "bg-primary-500 text-white" : "bg-primary-100 text-primary-700" %>"><%= render "pages/icon", name: icon, classes: "size-6" %></span>
            <p class="text-sm font-semibold tracking-wide text-primary-700 uppercase"><%= label %></p>
          </div>
          <h3 class="mt-5 font-bold tracking-tight text-gray-950 text-balance <%= featured ? "text-2xl sm:text-3xl" : "text-xl" %>"><%= title %></h3>
          <p class="mt-3 text-gray-600 <%= "text-sm" unless featured %>"><%= body %></p>
          <%= link_to help_article_path(slug), class: "mt-auto pt-5 inline-block font-medium text-accent-600 hover:underline" do %><%= link_text %> <span aria-hidden="true">›</span><% end %>
        </div>
      <% end %>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-3 gap-y-3 text-sm">
      <span class="font-semibold text-gray-950">And the rest:</span>
      <% [ [ :staff, "Staff and roles", "staff-and-roles" ], [ :shifts, "Shifts and cash", "shifts-and-cash" ],
           [ :purchasing, "Buying from suppliers", "buying-from-suppliers" ], [ :promotions, "Promotions", "promotions" ],
           [ :deliveries, "Deliveries", "deliveries" ], [ :returns, "Returns", "returns-and-refunds" ],
           [ :online_store, "Online store", "online-store" ], [ :whatsapp, "WhatsApp", "whatsapp" ],
           [ :quickbooks, "QuickBooks", "quickbooks" ] ].each do |icon, label, slug| %>
        <%= link_to help_article_path(slug), class: "inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-3.5 py-1.5 font-medium text-gray-700 hover:border-primary-300 hover:text-primary-700" do %><span class="text-primary-600"><%= render "pages/icon", name: icon, classes: "size-4" %></span><%= label %><% end %>
      <% end %>
      <%= link_to help_path, class: "font-medium text-accent-600 hover:underline" do %>All the guides <span aria-hidden="true">›</span><% end %>
    </div>
  </div>
</section>

<%# The five setup steps as a path you can walk: numbered tabs on a progress line, and a browser frame showing each
    step's real screen (setup_steps_controller.js). It plays through on its own until touched. %>
<section class="border-y border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Getting started</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Up and running in an afternoon.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">A <strong class="font-semibold text-gray-900">Set up your shop</strong> checklist walks you through it, and each screen shows you
        around the first time you open it. Rather we did it? <%= link_to "Ask about a setup visit", pricing_path(anchor: "setup"), class: "link" %>.</p>
    </div>

    <% steps = [
         [ "Create your shop", "Choose a web address and set up the owner's login. #{trial.capitalize} free, no card needed.",
           [ "Your shop at its own address", "The owner's login, ready to go", "#{trial.capitalize} free, no card needed" ], "home", "yourshop.hardpoint.app" ],
         [ "Name your branches and tills", "Check your tax rates and switch on only the features you use.",
           [ "Branches and yards", "Tills and receipt printers", "Tax rates, and only the features you use" ], "settings", "yourshop.hardpoint.app/settings" ],
         [ "Bring in your products", "Import a spreadsheet of thousands in seconds, or add them one at a time.",
           [ "A spreadsheet of thousands in seconds", "Categories, units and barcodes", "Change prices later the same way" ], "products", "yourshop.hardpoint.app/products" ],
         [ "Invite your staff", "Owner, manager, cashier, stock clerk or accountant, each seeing only their work.",
           [ "Owner, manager, cashier, stock clerk, accountant", "Each sees only their own work", "On a touch screen, tablet or phone" ], "staff", "yourshop.hardpoint.app/memberships/new" ],
         [ "Connect and sell", "Print a test receipt, connect M-Pesa and KRA eTIMS, and open the till.",
           [ "Print a test receipt", "Connect M-Pesa and KRA eTIMS", "Open the till" ], "till", "yourshop.hardpoint.app/pos" ]
       ] %>
    <div class="setup-steps mt-14 rounded-3xl bg-primary-50 px-5 py-8 sm:px-10 sm:py-10" data-controller="setup-steps"
         data-action="keydown->setup-steps#keydown mouseenter->setup-steps#pause mouseleave->setup-steps#resume focusin->setup-steps#pause focusout->setup-steps#resume">
      <div class="relative" role="tablist" aria-label="Setting up your shop">
        <div class="absolute top-5 right-[10%] left-[10%] h-0.5 -translate-y-px bg-primary-200" aria-hidden="true"></div>
        <div class="setup-fill absolute top-5 left-[10%] h-0.5 w-0 -translate-y-px bg-primary-500" data-setup-steps-target="fill" aria-hidden="true"></div>
        <div class="relative grid grid-cols-5 gap-x-2">
          <% steps.each.with_index do |(title, *), i| %>
            <button type="button" id="setup-tab-<%= i + 1 %>" class="setup-tab group flex cursor-pointer flex-col items-center gap-3 text-center focus-visible:outline-hidden" role="tab"
                    aria-selected="<%= i.zero? %>" aria-controls="setup-panel-<%= i + 1 %>" data-setup-steps-target="tab" data-index="<%= i %>" data-action="setup-steps#select">
              <span class="setup-tab-disc group-focus-visible:ring-4 group-focus-visible:ring-primary-400">
                <span class="setup-tab-number"><%= i + 1 %></span>
                <svg class="setup-tab-check size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-8"/></svg>
              </span>
              <span class="setup-tab-title text-sm font-medium text-gray-600 text-balance max-md:sr-only"><%= title %></span>
            </button>
          <% end %>
        </div>
      </div>

      <div class="mt-10 grid items-center gap-8 lg:mt-12 lg:grid-cols-5 lg:gap-12">
        <div class="lg:col-span-2">
          <p class="text-sm font-semibold text-primary-600" data-setup-steps-target="count">Five steps</p>
          <% steps.each.with_index do |(title, body, points, *), i| %>
            <div id="setup-panel-<%= i + 1 %>" class="setup-panel" role="tabpanel" aria-labelledby="setup-tab-<%= i + 1 %>" data-setup-steps-target="panel">
              <h3 class="mt-2 text-2xl font-bold tracking-tight text-gray-950 text-balance sm:text-3xl"><%= title %></h3>
              <p class="mt-3 text-gray-600"><%= body %></p>
              <ul class="mt-5 space-y-2 text-sm text-gray-700">
                <% points.each do |point| %><li class="flex gap-2.5"><%= render "pages/check" %><%= point %></li><% end %>
              </ul>
              <% if i == steps.size - 1 %>
                <%= link_to "Start now, it's free", new_signup_path, class: "btn-primary mt-6 px-6 py-2.5" %>
              <% end %>
            </div>
          <% end %>
          <div class="mt-8 flex items-center gap-3">
            <button type="button" class="btn-secondary px-5" data-action="setup-steps#previous" data-setup-steps-target="previous" disabled>Back</button>
            <button type="button" class="btn-primary px-5" data-action="setup-steps#next" data-setup-steps-target="next">Next</button>
            <p class="ml-auto text-xs text-gray-600 max-sm:hidden">Or use the arrow keys</p>
          </div>
        </div>

        <div class="lg:col-span-3">
          <div class="relative aspect-[16/11] overflow-hidden rounded-xl bg-white shadow-2xl shadow-primary-900/15 ring-1 ring-primary-200">
            <% steps.each.with_index do |(title, _, _, image, address), i| %>
              <div class="setup-screen" data-setup-steps-target="screen" aria-hidden="<%= !i.zero? %>">
                <div class="flex h-9 shrink-0 items-center gap-1.5 border-b border-gray-200 bg-gray-50 px-3">
                  <span class="size-2.5 rounded-full bg-gray-300"></span><span class="size-2.5 rounded-full bg-gray-300"></span><span class="size-2.5 rounded-full bg-gray-300"></span>
                  <span class="mx-auto truncate rounded-md bg-white px-3 py-0.5 text-xs text-gray-500 ring-1 ring-gray-200"><%= address %></span>
                </div>
                <%= image_tag "help/tours/#{image}.png", alt: "Step #{i + 1}: #{title}", class: "min-h-0 flex-1 object-cover object-top", loading: "lazy" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# What it runs on, as a strip rather than a section of its own: nothing special to buy. %>
    <div class="mt-10 rounded-2xl border border-gray-200 bg-white px-6 py-6 sm:px-8">
      <h3 class="text-lg font-bold tracking-tight text-gray-950">Runs on what you've got</h3>
      <p class="mt-1 text-sm text-gray-600">Nothing to install. HardPoint runs in the browser, and the scanner and printer on your counter work as they are.</p>
      <ul class="mt-5 grid gap-x-6 gap-y-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <% [ [ :monitor, "Any computer or tablet", "Windows, Mac, Android or iPad" ],
             [ :barcode, "Barcode scanners", "USB or Bluetooth, no setup" ],
             [ :printer, "Receipt printers", "58 or 80 mm thermal" ],
             [ :drawer, "Cash drawer", "Opens on cash sales" ] ].each do |icon, title, body| %>
          <li class="flex items-start gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary-100 text-primary-700"><%= render "pages/icon", name: icon, classes: "size-5" %></span>
            <span><span class="block font-semibold text-gray-900"><%= title %></span><span class="text-gray-600"><%= body %></span></span>
          </li>
        <% end %>
      </ul>
      <p class="mt-5 text-sm text-gray-600">Rather have it arrive ready to plug in? <%= link_to "Ask about a till kit", pricing_path(anchor: "setup"), class: "link" %>.</p>
    </div>
  </div>
</section>

<%# For the shop that already has something: how what it has comes across. Every line is what the product import
    and the setup visit do today (help/importing-products, the pricing page). %>
<section id="switching" class="scroll-mt-20 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Switching</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Already using something? Bring it with you.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">You don’t start from an empty screen. Your price list comes across as a spreadsheet, and you can keep the old way going beside HardPoint until you trust it.</p>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      <% [ [ :import, "From a receipt book or Excel", "Save your price list as a spreadsheet. HardPoint imports the products, prices, barcodes and the stock on the shelf, thousands in seconds. It checks the whole file first and lists any problem by line.", "Importing products", help_article_path("importing-products") ],
           [ :etims, "From another till or an ETR", "Export your products from the old system as a spreadsheet and import them the same way. KRA eTIMS is built in, so every receipt carries KRA’s QR code without a separate machine.", "How eTIMS works", help_article_path("etims") ],
           [ :staff, "Or we do it with you", "On a setup visit we import your product list from a spreadsheet or your old system, connect the printers, M-Pesa and eTIMS, and train your staff at the counter. Free with a year paid upfront.", "The setup visit", pricing_path(anchor: "setup") ] ].each do |icon, title, body, link_text, href| %>
        <div class="flex flex-col rounded-3xl border border-gray-200 p-7">
          <span class="flex size-12 items-center justify-center rounded-xl bg-primary-100 text-primary-700"><%= render "pages/icon", name: icon, classes: "size-6" %></span>
          <h3 class="mt-5 text-xl font-bold tracking-tight text-gray-950 text-balance"><%= title %></h3>
          <p class="mt-3 text-sm text-gray-600"><%= body %></p>
          <%= link_to href, class: "mt-auto pt-5 inline-block font-medium text-accent-600 hover:underline" do %><%= link_text %> <span aria-hidden="true">›</span><% end %>
        </div>
      <% end %>
    </div>
    <p class="mt-8 text-center text-gray-600">And it works the other way: export everything as spreadsheets whenever you like.</p>
  </div>
</section>

<%# Owners hand over their whole business: say plainly how it's kept, every line true of how HardPoint works
    (docs/SECURITY.md, the privacy page and the data processing terms say the same, in more detail). %>
<section id="security" class="scroll-mt-20 border-y border-primary-100 bg-primary-50/60">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Your data</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Safe, private, and yours.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">Your sales, stock, customers and staff belong to your shop. We look after them and do nothing else
        with them: we don’t sell data and we don’t show adverts.</p>
    </div>
    <% promises = [
         [ :shield, "Walled off from every other shop", "Separated inside the database itself, so no other shop can see yours, even if the app had a fault." ],
         [ :lock, "Locked down", "Encrypted connections and keys, passwords not even we can read, and two-factor sign-in for owners and managers." ],
         [ :sync, "Backed up every minute", "Encrypted and copied off-site every minute, so your shop can be brought back to any moment." ],
         [ :log, "Every change recorded", "Who did what and when, from a void to a price change, including our support staff if they ever sign in." ],
         [ :data, "Take it with you, any time", "Export everything as spreadsheets any time, even after you stop paying. Close your account and we delete it." ],
         [ :customers, "Kenya's Data Protection Act", "Written to the 2019 Act: we're your data processor, and we tell you within 72 hours of a breach." ]
       ] %>
    <ul class="mx-auto mt-12 grid max-w-5xl gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
      <% promises.each do |icon, title, body| %>
        <li class="flex items-start gap-4">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-white text-primary-700 ring-1 ring-primary-100"><%= render "pages/icon", name: icon, classes: "size-5" %></span>
          <span><span class="block font-bold text-gray-950"><%= title %></span><span class="mt-1 block text-sm text-gray-600"><%= body %></span></span>
        </li>
      <% end %>
    </ul>
    <p class="mt-10 text-center text-gray-600">In full: <%= link_to "Privacy and your data", privacy_path, class: "link" %> ·
      <%= link_to "Data processing terms", data_processing_path, class: "link" %> · <%= link_to "Service level agreement", sla_path, class: "link" %></p>
  </div>
</section>

<%# What real shops say (config/testimonials.yml). Nothing is drawn until there's a real one to show. %>
<% if (shops = testimonials).any? %>
  <section id="shops" class="scroll-mt-20 border-b border-gray-200 bg-gray-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">From the counter</p>
        <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Shops already selling on HardPoint.</h2>
      </div>
      <div class="mx-auto mt-12 grid gap-5 <%= { 1 => "max-w-2xl", 2 => "max-w-4xl md:grid-cols-2" }.fetch(shops.size, "md:grid-cols-2 lg:grid-cols-3") %>">
        <% shops.each do |shop| %>
          <figure class="flex flex-col rounded-3xl border border-gray-200 bg-white p-7">
            <blockquote class="text-lg text-gray-800 text-pretty">“<%= shop[:quote] %>”</blockquote>
            <figcaption class="mt-auto flex items-center gap-4 pt-6">
              <% if shop[:photo] %>
                <%= image_tag "marketing/shops/#{shop[:photo]}", alt: "", class: "size-12 shrink-0 rounded-full object-cover", loading: "lazy" %>
              <% end %>
              <span class="text-sm"><span class="block font-semibold text-gray-950"><%= safe_join([ shop[:name], shop[:role] ].compact_blank, ", ") %></span>
                <span class="text-gray-600"><%= shop[:shop] %>, <%= shop[:town] %></span></span>
            </figcaption>
          </figure>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<section id="pricing" class="scroll-mt-20 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Pricing</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">One price for the shop. That’s it.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">HardPoint takes nothing per sale or per receipt. Pay by M-Pesa or card, monthly or yearly; a year
        costs <%= Plan::YEARLY_MONTHS_CHARGED %> months, so <%= 12 - Plan::YEARLY_MONTHS_CHARGED %> are free.</p>
      <p class="mt-3 font-semibold text-primary-700"><%= from_price %> a month is KES <%= number_with_delimiter((@plans.map(&:price_cents).min / 100 / 30.0).round) %> a day for the whole shop.</p>
    </div>
    <%= render "pages/plans", plans: @plans %>
    <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-gray-500">Business and Unlimited come with a 99.9% uptime promise in the <%= link_to "service level agreement", sla_path, class: "link" %>.
      Texts to customers, if you switch them on, are billed by Africa’s Talking.
      <%= link_to "The full pricing", pricing_path, class: "link" %>, with setup visits and till kits.</p>
  </div>
</section>

<%# The questions a visitor has before clicking Start. The pricing page has the full list. %>
<section class="border-y border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:py-20">
    <div class="text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Questions</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Before you start.</h2>
    </div>
    <div class="mt-12"><%= render "pages/faqs", faqs: landing_faqs %></div>
    <p class="mt-8 text-center text-gray-600">More answers on the <%= link_to "pricing page", pricing_path, class: "link" %>, and a person on <%= link_to "WhatsApp", whatsapp_support_url, class: "link", target: "_blank", rel: "noopener" %> for the rest.</p>
  </div>
</section>

<%# The door, in the same full-colour band as the offline till: the page ends on its strongest colour. %>
<section class="offline-band relative overflow-hidden text-white">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:py-28">
    <p class="text-sm font-semibold tracking-wide text-white/75 uppercase">Ready when you are</p>
    <h2 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">Open the till.</h2>
    <p class="mt-5 text-lg text-white/85 text-balance sm:text-xl">Questions first? Message a person on WhatsApp or email
      <%= mail_to Rails.configuration.x.support[:email], nil, class: "font-medium text-white underline decoration-white/50 underline-offset-2 hover:decoration-white" %>.</p>
    <div class="relative mt-9 inline-flex flex-col items-center">
      <%= doodle_arrow.("absolute -left-16 -top-8 size-14 -rotate-6 text-white/70 max-sm:hidden") %>
      <%= link_to "Try it free for #{trial}", new_signup_path, class: "btn rounded-md border border-white bg-white px-8 py-3 text-lg font-semibold text-primary-700 shadow-lg shadow-primary-900/20 hover:bg-primary-50 focus-visible:outline-white" %>
    </div>
    <ul class="mt-5 flex flex-wrap justify-center gap-x-5 gap-y-1 text-sm text-white/85">
      <li class="flex items-center gap-1.5"><%= render "pages/check", classes: "text-white" %>No card needed</li>
      <li class="flex items-center gap-1.5"><%= render "pages/check", classes: "text-white" %><%= trial.capitalize %> free</li>
      <li class="flex items-center gap-1.5"><%= render "pages/check", classes: "text-white" %>Selling the same afternoon</li>
    </ul>
  </div>
</section>
