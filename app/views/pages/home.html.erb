<% features = [
  [ "Point of Sale", "#e46f2f", :till, "Barcode scanning, sales by the metre, kilo or pack, parked sales and split payments." ],
  [ "M-Pesa", "#4d9f6f", :sales, "Payment prompts from the till, and Paybill and Till payments matched to sales." ],
  [ "KRA eTIMS", "#3f7fbf", :purchasing, "Sales, voids and returns go to KRA. The signed QR code prints on the receipt." ],
  [ "Offline till", "#6c757d", :dashboard, "The till keeps selling without internet and uploads the sales when it reconnects." ],
  [ "Inventory", "#26a69a", :stock, "Stock per branch, transfers, stock takes, reorder levels, batches and expiry dates." ],
  [ "Purchase", "#8e6bbf", :purchasing, "Purchase orders, goods received, supplier invoices and supplier returns." ],
  [ "Customers", "#d9534f", :staff, "Quotes, orders with deposits, credit accounts, statements and SMS reminders." ],
  [ "Reports", "#5b8def", :reports, "Sales, margin, VAT, payments and slow-moving stock, and a daily summary email." ]
] %>

<section class="bg-white">
  <div class="mx-auto max-w-4xl px-4 pt-16 pb-12 text-center lg:pt-24">
    <h1 class="text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl">Point of sale and stock control for hardware stores</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-gray-600">Sell at the counter, track stock across branches, take M-Pesa and send every sale to KRA eTIMS.
      The till keeps working when the internet is down.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <%= link_to "Start free trial", new_signup_path, class: "btn-primary px-5 py-2.5 text-base" %>
      <%= link_to "See pricing", pricing_path, class: "btn-secondary px-5 py-2.5 text-base" %>
    </div>
    <p class="mt-3 text-sm text-gray-500">30 days free. No card needed.</p>
  </div>
  <div class="mx-auto max-w-5xl px-4">
    <%= image_tag "marketing/dashboard.png", alt: "The HardPoint dashboard", class: "w-full rounded-t-lg border border-b-0 border-gray-200 shadow-xl", width: 1280, height: 800 %>
  </div>
</section>

<section id="features" class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center text-2xl font-semibold">What's included</h2>
    <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      <% features.each do |title, color, icon, body| %>
        <div class="flex gap-4">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-lg text-white" style="background: <%= color %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><path d="<%= NavigationHelper::ICONS.fetch(icon) %>"/></svg>
          </span>
          <div>
            <h3 class="font-semibold"><%= title %></h3>
            <p class="mt-1 text-sm text-gray-600"><%= body %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="border-t border-gray-200 bg-white">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2">
    <div>
      <h2 class="text-2xl font-semibold">Getting started</h2>
      <ol class="mt-6 space-y-5">
        <% [ [ "Create your shop", "Choose a web address and set up the owner's login." ],
             [ "Add products", "Import a spreadsheet or add them one at a time." ],
             [ "Add staff and tills", "Invite staff, set their roles and connect a receipt printer." ],
             [ "Sell", "Cash, M-Pesa, card or on account." ] ].each.with_index(1) do |(title, body), step| %>
          <li class="flex gap-4">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-500 text-sm font-semibold text-white"><%= step %></span>
            <div><p class="font-semibold"><%= title %></p><p class="text-sm text-gray-600"><%= body %></p></div>
          </li>
        <% end %>
      </ol>
    </div>
    <%= image_tag "marketing/till.png", alt: "The HardPoint till with a customer's cart", class: "w-full rounded-lg border border-gray-200 shadow-lg", width: 1280, height: 800 %>
  </div>
</section>

<section class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="mb-8 text-center text-2xl font-semibold">Pricing</h2>
    <%= render "pages/plans", plans: @plans %>
  </div>
</section>

<section class="border-t border-gray-200 bg-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-10">
    <p class="text-lg">Questions? Message us on WhatsApp or email <%= mail_to Rails.configuration.x.support[:email], nil, class: "link" %>.</p>
    <div class="flex flex-wrap gap-3">
      <%= link_to "WhatsApp us", whatsapp_support_url("Hello HardPoint, I'd like to know more about the POS."), class: "btn-secondary", target: "_blank", rel: "noopener" %>
      <%= link_to "Start free trial", new_signup_path, class: "btn-primary" %>
    </div>
  </div>
</section>
