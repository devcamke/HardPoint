      <div class="rounded-3xl bg-white p-7 ring-1 ring-primary-100 md:col-span-2 lg:col-span-1">
        <h3 class="text-xl font-bold tracking-tight text-gray-950">And on WhatsApp.</h3>
        <ul class="mt-5 space-y-4 text-sm">
          <% [ [ "Receipts, quotes, invoices and statements", "sent as sharp pictures or PDFs, or from HardPoint’s own number with delivery and read receipts." ],
               [ "An online store", "at your own address for click-and-collect, paid ahead by M-Pesa or on collection." ],
               [ "Monday reminders", "to everyone overdue, by SMS, or on WhatsApp with their statement." ] ].each do |bold, rest| %>
            <li class="flex gap-3"><%= render "pages/check" %><span class="text-gray-600"><strong class="font-semibold text-gray-950"><%= bold %></strong> <%= rest %></span></li>
          <% end %>
        </ul>
        <p class="flex flex-wrap gap-x-6"><%= learn_more.("WhatsApp", "whatsapp") %><%= learn_more.("The online store", "online-store") %></p>
