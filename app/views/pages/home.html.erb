<% trial = Plan::TRIAL.inspect %>
<% structured_data seo_organization, seo_software(@plans) %>
<%# In the manner of odoo.com: a white page, short bold headlines, the price said out loud in the hero with a
    hand-drawn arrow pointing at it, "Start now, it's free" everywhere, and a grid of app tiles standing in for a
    hero picture. The brand teal does the work Odoo's purple does: buttons, tiles, arrows and one full-colour band
    for the offline till. The order is an argument: the promise and what it does, a sale to click through, why it's
    different, the claims, the owner's view, how to start, the price, and the door. %>
<% from_price = "KES #{number_with_delimiter(@plans.map(&:price_cents).min / 100)}" %>
<% learn_more = ->(text, slug) { link_to help_article_path(slug), class: "mt-4 inline-block font-medium text-accent-600 hover:underline" do
     safe_join([ text, " ", tag.span("›", aria: { hidden: true }) ])
   end } %>
<%# A curly arrow drawn by hand, as Odoo points at its price and its user count. %>
<% doodle_arrow = ->(classes) { tag.svg(class: classes, viewBox: "0 0 48 48", fill: "none", stroke: "currentColor", "stroke-width": "2.5", "stroke-linecap": "round", "stroke-linejoin": "round", aria: { hidden: true }) {
     safe_join([ tag.path(d: "M6 6c2 18 12 30 34 32"), tag.path(d: "M32 30l8 8-10 4") ])
   } } %>

<section class="bg-white">
  <div class="mx-auto max-w-4xl px-4 pt-16 pb-20 text-center sm:pt-24 sm:pb-24">
    <h1 class="text-5xl font-bold tracking-tight text-gray-950 text-balance sm:text-6xl">Point of sale and stock control for hardware stores.</h1>
    <p class="mt-5 text-2xl font-medium text-gray-700 text-balance sm:text-3xl">Simple, works offline, and affordable.</p>
    <p class="relative mx-auto mt-3 inline-flex items-center gap-3 text-lg text-gray-600">
      <%= doodle_arrow.("absolute -left-14 -top-6 size-12 -rotate-12 text-primary-500 max-sm:hidden") %>
      <span>From <strong class="font-bold text-primary-600 tabular-nums"><%= from_price %></strong> a month for the whole shop</span>
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-x-4 gap-y-3">
      <%= link_to "Start now, it's free", new_signup_path, class: "btn-primary rounded-full px-7 py-3 text-lg" %>
      <%= link_to "Talk to us on WhatsApp", whatsapp_support_url("Hello HardPoint, I'd like to know more about the POS."), class: "btn rounded-full border-gray-300 bg-white px-7 py-3 text-lg text-gray-800 hover:bg-gray-50", target: "_blank", rel: "noopener" %>
    </div>
    <p class="mt-4 text-sm text-gray-500"><%= trial.capitalize %> free. No card needed.</p>
  </div>

  <%# The product as a grid of tiles, one per thing a hardware shop does, each opening its help guide. %>
  <div id="features" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-20 sm:pb-28">
    <% tiles = [
         [ "Till", "selling", :till ], [ "Stock", "stock-and-stock-takes", :stock ], [ "M-Pesa", "mpesa", :mpesa ],
         [ "KRA eTIMS", "etims", :etims ], [ "Customers", "customer-accounts", :customers ], [ "Purchasing", "buying-from-suppliers", :purchasing ],
         [ "Reports", "reports", :reports ], [ "Promotions", "promotions", :promotions ], [ "Deliveries", "deliveries", :deliveries ],
         [ "Contractors' jobs", "contractor-jobs", :jobs ], [ "Online store", "online-store", :online_store ], [ "WhatsApp", "whatsapp", :whatsapp ],
         [ "Shifts and cash", "shifts-and-cash", :shifts ], [ "Branches", "shop-settings", :branches ], [ "Returns", "returns-and-refunds", :returns ],
         [ "Batches and expiry", "batches-and-expiry", :batches ], [ "Staff and roles", "staff-and-roles", :staff ], [ "Import products", "importing-products", :import ],
         [ "Stock on your phone", "stock-on-your-phone", :barcode ], [ "Offline till", "offline", :offline ], [ "Airtel Money", "airtel-money", :airtel ],
         [ "Your data", "your-data", :data ], [ "QuickBooks", "quickbooks", :quickbooks ], [ "Apps and the API", "connecting-apps", :api ]
       ]
       shades = [ "bg-primary-500 text-white", "bg-primary-100 text-primary-700", "bg-primary-700 text-white", "bg-primary-50 text-primary-600 ring-1 ring-primary-100" ] %>
    <ul class="grid grid-cols-3 gap-x-3 gap-y-6 text-center sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
      <% tiles.each.with_index do |(label, slug, icon), i| %>
        <li>
          <%= link_to help_article_path(slug), class: "group flex flex-col items-center gap-2.5" do %>
            <span class="flex size-16 items-center justify-center rounded-2xl shadow-sm transition group-hover:-translate-y-1 group-hover:shadow-md <%= shades[(i + i / 8) % shades.size] %>">
              <%= render "pages/icon", name: icon %>
            </span>
            <span class="text-xs font-medium text-gray-700 group-hover:text-gray-950 sm:text-sm"><%= label %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="mt-10 text-center text-gray-600">Every one of these on every plan. <%= link_to "See all the guides", help_path, class: "link" %></p>
  </div>
</section>

<%# The help centre's walkthrough of the till, so a visitor clicks through a sale before signing up. %>
<section class="border-y border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Try it</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">See a sale, start to finish.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">From the first scan to the receipt, on the real screen. Press play, or tap any number.</p>
    </div>
    <div class="mx-auto mt-10 max-w-5xl">
      <%= render "help/walkthrough", tour: HelpTour.find("till"),
            caption: safe_join([ "Every screen has a guide like this one: ", link_to("Selling at the till", help_article_path("selling"), class: "link"), "." ]) %>
    </div>
  </div>
</section>

<%# One full-colour band, where Odoo has its yellow one: the offline point in words. The till itself was just shown. %>
<section class="bg-primary-500 text-white">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:py-20">
    <p class="text-sm font-semibold tracking-wide text-primary-200 uppercase">The offline till</p>
    <h2 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">Keeps selling when the internet doesn't.</h2>
    <p class="mt-5 text-lg text-primary-100 text-balance sm:text-xl">The till keeps its own copy of the catalogue, customers and promotions. It takes cash, M-Pesa and card, prints receipts,
      and sends the sales the moment it reconnects.</p>
    <%= link_to help_article_path("offline"), class: "mt-6 inline-block font-medium text-white underline-offset-4 hover:underline" do %>How the offline till works <span aria-hidden="true">›</span><% end %>
  </div>
</section>

<%# Odoo's "Enterprise software done right": short bold claims, a line each, a link. The two that sell a hardware
    shop in Kenya, M-Pesa and eTIMS, get wide tinted cards; the rest sit in a row of three. Each card wears the
    same tile icon as the hero grid, so the page reads as one set. %>
<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Why HardPoint</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Software for hardware stores, done right.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">Not a generic till with a hardware skin. The things that matter at a hardware counter in Kenya, built in from the start.</p>
    </div>

    <dl class="mx-auto mt-14 grid max-w-4xl gap-8 text-center sm:grid-cols-3">
      <div>
        <dt class="text-5xl font-bold tracking-tight text-primary-600 tabular-nums">20,000</dt>
        <dd class="mt-2 text-gray-600">products imported from a spreadsheet in about twelve seconds.</dd>
      </div>
      <div>
        <dt class="text-5xl font-bold tracking-tight text-primary-600">3 keys</dt>
        <dd class="mt-2 text-gray-600">F2 scan, F8 park, F9 pay. Or finger-sized buttons on a touch screen.</dd>
      </div>
      <div>
        <dt class="text-5xl font-bold tracking-tight text-primary-600">Every sale</dt>
        <dd class="mt-2 text-gray-600">signed by KRA eTIMS, with the QR code on the receipt.</dd>
      </div>
    </dl>

    <% claims = [
         [ :mpesa, "M-Pesa, Airtel Money and card. Matched to the sale.",
           "Send a payment prompt to the customer's phone from the till, or let money paid to your Paybill or Till find its own sale. Cash with change, card, foreign notes, on account, or a mix of them.",
           "How M-Pesa works at the till", help_article_path("mpesa") ],
         [ :etims, "KRA eTIMS. Built in.",
           "Every sale, void and return signed by KRA, with the QR code on the receipt. Queued and retried if KRA is down, so the queue never stops for the taxman.",
           "How eTIMS works", help_article_path("etims") ],
         [ :stock, "Stock across branches.", "Levels per branch and yard, transfers, stock takes on a phone, reorder lists, batches and expiry dates.", "Stock and stock takes", help_article_path("stock-and-stock-takes") ],
         [ :customers, "Customers on account.", "Quotes, orders with deposits, credit limits, statements and a list of who owes you. Reminders by SMS or WhatsApp.", "Customer accounts", help_article_path("customer-accounts") ],
         [ :reports, "Reports the owner reads.", "A live dashboard, and sales, profit, VAT, stock and shift reports to print or export.", "Reports", help_article_path("reports") ],
         [ :plans, "Every feature on every plan.", "No higher tier hiding the thing you need. Plans differ only in how many branches, tills and staff logins they allow.", "See pricing", "#pricing" ],
         [ :data, "Your data is yours.", "Download your products, customers, sales and stock as spreadsheets any time, and export to QuickBooks.", "Your data", help_article_path("your-data") ],
         [ :whatsapp, "A person on WhatsApp.", "Questions go to someone who knows the product, on the app your shop already uses. Help guides for everything else.", "WhatsApp us", whatsapp_support_url ]
       ] %>
    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-6">
      <% claims.each.with_index do |(icon, title, body, link_text, href), i| %>
        <% featured = i < 2 %>
        <div class="flex flex-col rounded-3xl p-7 sm:p-8 <%= featured ? "bg-primary-50 lg:col-span-3" : "border border-gray-200 lg:col-span-2" %>">
          <span class="flex size-12 items-center justify-center rounded-xl <%= featured ? "bg-primary-500 text-white" : "bg-primary-100 text-primary-700" %>"><%= render "pages/icon", name: icon, classes: "size-6" %></span>
          <h3 class="mt-5 font-bold tracking-tight text-gray-950 text-balance <%= featured ? "text-2xl sm:text-3xl" : "text-xl" %>"><%= title %></h3>
          <p class="mt-3 text-gray-600 <%= "text-sm" unless featured %>"><%= body %></p>
          <%= link_to href, class: "mt-auto pt-5 inline-block font-medium text-accent-600 hover:underline", **(href.start_with?("http") ? { target: "_blank", rel: "noopener" } : {}) do %><%= link_text %> <span aria-hidden="true">›</span><% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# The owner's view: the dashboard, the evening summary and the reports. %>
<section class="border-y border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">For the owner</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Clear in the office.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">Today's takings, sales, margin and what needs doing, live, from the shop or your phone. Every evening a summary of the day lands in your inbox.</p>
    </div>
    <%= image_tag "marketing/dashboard.png", alt: "The HardPoint dashboard: today's takings, sales, margin and what needs doing", class: "mt-14 w-full rounded-2xl shadow-2xl shadow-gray-950/15 ring-1 ring-gray-200", width: 1280, height: 800 %>
    <p class="mt-8 text-center text-gray-600">Sales, profit, VAT, stock and shift reports to print or export. <%= link_to "The reports", help_article_path("reports"), class: "link" %></p>
  </div>
</section>

<%# The five setup steps as a path you can walk: numbered tabs on a progress line, and a browser frame showing each
    step's real screen (setup_steps_controller.js). It plays through on its own until touched. %>
<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Getting started</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Up and running in an afternoon.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">A <strong class="font-semibold text-gray-900">Set up your shop</strong> checklist walks you through it, and guided tours show each
        screen when you first use it.</p>
    </div>

    <% steps = [
         [ "Create your shop", "Choose a web address and set up the owner's login. #{trial.capitalize} free, no card needed.",
           [ "Your shop at its own address", "The owner's login, ready to go", "#{trial.capitalize} free, no card needed" ], "home", "yourshop.hardpoint.app" ],
         [ "Name your branches and tills", "Check your tax rates and switch on only the features you use.",
           [ "Branches and yards", "Tills and receipt printers", "Tax rates, and only the features you use" ], "settings", "yourshop.hardpoint.app/settings" ],
         [ "Bring in your products", "Import a spreadsheet of thousands in seconds, or add them one at a time.",
           [ "A spreadsheet of thousands in seconds", "Categories, units and barcodes", "Change prices later the same way" ], "products", "yourshop.hardpoint.app/products" ],
         [ "Invite your staff", "Owner, manager, cashier, stock clerk or accountant, each seeing only their work.",
           [ "Owner, manager, cashier, stock clerk, accountant", "Each sees only their own work", "On a touch screen, tablet or phone" ], "staff", "yourshop.hardpoint.app/memberships/new" ],
         [ "Connect and sell", "Print a test receipt, connect M-Pesa and KRA eTIMS, and open the till.",
           [ "Print a test receipt", "Connect M-Pesa and KRA eTIMS", "Open the till" ], "till", "yourshop.hardpoint.app/pos" ]
       ] %>
    <div class="setup-steps mt-14 rounded-3xl bg-primary-50 px-5 py-8 sm:px-10 sm:py-10" data-controller="setup-steps"
         data-action="keydown->setup-steps#keydown mouseenter->setup-steps#pause mouseleave->setup-steps#resume focusin->setup-steps#pause focusout->setup-steps#resume">
      <div class="relative" role="tablist" aria-label="Setting up your shop">
        <div class="absolute top-5 right-[10%] left-[10%] h-0.5 -translate-y-px bg-primary-200" aria-hidden="true"></div>
        <div class="setup-fill absolute top-5 left-[10%] h-0.5 w-0 -translate-y-px bg-primary-500" data-setup-steps-target="fill" aria-hidden="true"></div>
        <div class="relative grid grid-cols-5 gap-x-2">
          <% steps.each.with_index do |(title, *), i| %>
            <button type="button" id="setup-tab-<%= i + 1 %>" class="setup-tab group flex cursor-pointer flex-col items-center gap-3 text-center focus-visible:outline-hidden" role="tab"
                    aria-selected="<%= i.zero? %>" aria-controls="setup-panel-<%= i + 1 %>" data-setup-steps-target="tab" data-index="<%= i %>" data-action="setup-steps#select">
              <span class="setup-tab-disc group-focus-visible:ring-4 group-focus-visible:ring-primary-400">
                <span class="setup-tab-number"><%= i + 1 %></span>
                <svg class="setup-tab-check size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-8"/></svg>
              </span>
              <span class="setup-tab-title text-sm font-medium text-gray-600 text-balance max-md:sr-only"><%= title %></span>
            </button>
          <% end %>
        </div>
      </div>

      <div class="mt-10 grid items-center gap-8 lg:mt-12 lg:grid-cols-5 lg:gap-12">
        <div class="lg:col-span-2">
          <p class="text-sm font-semibold text-primary-600" data-setup-steps-target="count">Five steps</p>
          <% steps.each.with_index do |(title, body, points, *), i| %>
            <div id="setup-panel-<%= i + 1 %>" class="setup-panel" role="tabpanel" aria-labelledby="setup-tab-<%= i + 1 %>" data-setup-steps-target="panel">
              <h3 class="mt-2 text-2xl font-bold tracking-tight text-gray-950 text-balance sm:text-3xl"><%= title %></h3>
              <p class="mt-3 text-gray-600"><%= body %></p>
              <ul class="mt-5 space-y-2 text-sm text-gray-700">
                <% points.each do |point| %><li class="flex gap-2.5"><%= render "pages/check" %><%= point %></li><% end %>
              </ul>
              <% if i == steps.size - 1 %>
                <%= link_to "Start now, it's free", new_signup_path, class: "btn-primary mt-6 rounded-full px-6 py-2.5" %>
              <% end %>
            </div>
          <% end %>
          <div class="mt-8 flex items-center gap-3">
            <button type="button" class="btn-secondary rounded-full px-5" data-action="setup-steps#previous" data-setup-steps-target="previous" disabled>Back</button>
            <button type="button" class="btn-primary rounded-full px-5" data-action="setup-steps#next" data-setup-steps-target="next">Next</button>
            <p class="ml-auto text-xs text-gray-500 max-sm:hidden">Or use the arrow keys</p>
          </div>
        </div>

        <div class="lg:col-span-3">
          <div class="relative aspect-[16/11] overflow-hidden rounded-xl bg-white shadow-2xl shadow-primary-900/15 ring-1 ring-primary-200">
            <% steps.each.with_index do |(title, _, _, image, address), i| %>
              <div class="setup-screen" data-setup-steps-target="screen" aria-hidden="<%= !i.zero? %>">
                <div class="flex h-9 shrink-0 items-center gap-1.5 border-b border-gray-200 bg-gray-50 px-3">
                  <span class="size-2.5 rounded-full bg-gray-300"></span><span class="size-2.5 rounded-full bg-gray-300"></span><span class="size-2.5 rounded-full bg-gray-300"></span>
                  <span class="mx-auto truncate rounded-md bg-white px-3 py-0.5 text-xs text-gray-500 ring-1 ring-gray-200"><%= address %></span>
                </div>
                <%= image_tag "help/tours/#{image}.png", alt: "Step #{i + 1}: #{title}", class: "min-h-0 flex-1 object-cover object-top", loading: "lazy" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="pricing" class="scroll-mt-20 border-y border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:py-28">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <h2 class="text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Fair pricing.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">One price per shop a month. Pay by M-Pesa or card, monthly or yearly.</p>
    </div>
    <%= render "pages/plans", plans: @plans %>
  </div>
</section>

<section class="bg-white">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:py-28">
    <h2 class="text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Open the till.</h2>
    <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">Questions first? Message a person on WhatsApp or email <%= mail_to Rails.configuration.x.support[:email], nil, class: "link" %>.</p>
    <div class="relative mt-9 inline-flex flex-col items-center">
      <%= doodle_arrow.("absolute -left-16 -top-8 size-14 -rotate-6 text-primary-500 max-sm:hidden") %>
      <%= link_to "Start now, it's free", new_signup_path, class: "btn-primary rounded-full px-8 py-3 text-lg" %>
    </div>
    <ul class="mt-5 flex flex-wrap justify-center gap-x-5 gap-y-1 text-sm text-gray-600">
      <li class="flex items-center gap-1.5"><%= render "pages/check" %>No card needed</li>
      <li class="flex items-center gap-1.5"><%= render "pages/check" %><%= trial.capitalize %> free</li>
      <li class="flex items-center gap-1.5"><%= render "pages/check" %>Selling the same afternoon</li>
    </ul>
  </div>
</section>
