<% trial = Plan::TRIAL.inspect %>
<% structured_data seo_organization, seo_software(@plans), seo_faq(landing_faqs) %>
<%# Written the way Basecamp, HEY and Fizzy write theirs: a white page that talks like a person, one huge
    plainspoken headline, the real screens with notes in marker pen, the price on a sticky note, and two teal bands
    (the offline till and the door). The styles are in app/assets/tailwind/landing.css, all under .lp.
    The order is an argument: the promise, what you won't get, how the shop runs today and with HardPoint, the till,
    the offline till, the owner's view, the rest of the shop, how to start, how the data is kept, the price, the
    questions, and the door. Every fact here is true of how HardPoint works; the help guides say the same at length. %>
<% shillings = ->(cents) { "KES #{number_with_delimiter(cents / 100)}" } %>
<% from_cents = @plans.map(&:price_cents).min %>
<% months_free = 12 - Plan::YEARLY_MONTHS_CHARGED %>
<% arrow = tag.svg(viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2.6", "stroke-linecap": "round", "stroke-linejoin": "round", aria: { hidden: true }) { tag.path(d: "M5 12h14M13 6l6 6-6 6") } %>
<% tick = tag.svg(viewBox: "0 0 22 22", aria: { hidden: true }) { tag.path(d: "M4 11.5l4.5 4.5L18 6") } %>
<% cross = tag.svg(viewBox: "0 0 22 22", aria: { hidden: true }) { tag.path(d: "M5 5l12 12M17 5L5 17") } %>
<% more = ->(text, slug) { link_to(help_article_path(slug), class: "lp-more") { safe_join([ text, tag.span("›", aria: { hidden: true }) ], " ") } } %>
<%# A pen stroke from a note to the thing it's about, drawn in a box of its own. %>
<% pen = ->(d, style) { tag.svg(viewBox: "0 0 80 40", style: style, aria: { hidden: true }) { safe_join(d.map { tag.path(d: _1) }) } } %>

<%# One controller for the whole page so "Watch a sale" in the hero can open the dialog at the end, which sits
    outside .lp so the help walkthrough inside it keeps its own styles. %>
<div data-controller="dialog">
<div class="lp">

<%# The promise. The handwritten line above the headline is part of the h1, so search engines still read what
    HardPoint is; the headline is what it does. %>
<div class="lp-wrap">
  <div class="lp-hero">
    <div>
      <h1><span class="lp-kicker">Point of sale and stock control for hardware stores in Kenya</span>
        Stock that adds up. A till that <span class="lp-hl">never stops.</span></h1>
      <p class="lp-lede">Most shop software was built for supermarkets and then sold to hardware stores. HardPoint was
        built for your counter, where cement goes by the bag, wire by the metre and nails by the kilo.
        <strong>M-Pesa and KRA eTIMS come built in, and when the internet drops the till keeps selling.</strong></p>
      <div class="lp-cta">
        <%= link_to new_signup_path, class: "lp-btn" do %>Try it free for <%= trial %><%= arrow %><% end %>
        <button type="button" class="lp-btn lp-btn-ghost" data-action="dialog#open">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>Watch a sale
        </button>
      </div>
      <p class="lp-fine" style="margin-top: 16px">No card needed. Nothing to install.
        Questions? <%= link_to "Talk to us on WhatsApp", whatsapp_support_url("Hello HardPoint, I'd like to know more about the POS."), target: "_blank", rel: "noopener" %></p>
    </div>

    <%# An example sale, drawn rather than screenshotted so it reads at any size. "Pull the plug" shows what the
        offline till does differently: the M-Pesa prompt needs the internet, so the cashier types the code; the
        receipt takes an offline number; KRA gets the sale when it's sent (help/offline says the same). %>
    <div class="lp-stage" data-controller="offline-demo">
      <p class="lp-sticky"><b><%= shillings.(from_cents) %></b>a month for the whole shop. Not per till, not per sale.</p>
      <div class="lp-till" data-offline-demo-target="till" aria-live="polite">
        <div class="lp-till-top"><span><b>Till 1</b> · an example sale</span>
          <span class="lp-pill" data-offline-demo-target="text" data-offline-text="Offline · still selling">Online</span></div>
        <ul class="lp-lines">
          <li><span>Cement 50 kg</span><span class="lp-qty">4 bags × 830</span><span class="lp-amt">3,320</span></li>
          <li><span>Binding wire, 1.2 mm</span><span class="lp-qty">2.5 kg × 350</span><span class="lp-amt">875</span></li>
          <li><span>Roofing nails, 3″</span><span class="lp-qty">1 kg × 260</span><span class="lp-amt">260</span></li>
          <li><span>PVC pipe, ½″</span><span class="lp-qty">6 m × 90</span><span class="lp-amt">540</span></li>
        </ul>
        <div class="lp-total"><span>Total</span><b>KES 4,995</b></div>
        <dl class="lp-paid">
          <div><dt>Paid by</dt><dd data-offline-demo-target="text" data-offline-text="M-Pesa code typed in, checked later">M-Pesa prompt · 0712 ••• 448</dd></div>
          <div><dt>KRA eTIMS</dt><dd data-offline-demo-target="text" data-offline-text="Waiting, goes when you’re back">Signed and sent</dd></div>
          <div><dt>Receipt</dt><dd data-offline-demo-target="text" data-offline-text="MAIN-OFF1-K7Q2-0001 · printed">MAIN-004812 · on WhatsApp</dd></div>
        </dl>
      </div>
      <p class="lp-note lp-note-weigh">Sell by the metre, the kilo or the bag
        <svg viewBox="0 0 44 26" aria-hidden="true"><path d="M2 4c14-2 26 4 36 16"/><path d="M28 20h10l-2-10"/></svg></p>
      <p class="lp-note lp-note-etims"><span data-offline-demo-target="text" data-offline-text="Internet down? The sale still goes through. KRA gets it later.">Every sale sent to KRA without you lifting a finger</span>
        <svg viewBox="0 0 44 26" aria-hidden="true"><path d="M2 24c14 2 26-4 36-18"/><path d="M28 6h10l-1 10"/></svg></p>
      <div class="lp-unplug">
        <button type="button" class="lp-toggle" hidden aria-pressed="false" data-offline-demo-target="button" data-action="offline-demo#toggle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 2v6M15 2v6M6 8h12v3a6 6 0 0 1-12 0zM12 17v5"/></svg>
          <span data-offline-demo-target="text" data-offline-text="Plug the internet back in">Pull the plug on the internet</span>
        </button>
      </div>
    </div>
  </div>

</div>

<%# What you won't get, struck through, the way HEY lists what it leaves out. %>
<aside class="lp-nots" aria-labelledby="nots-title"><div class="lp-wrap">
  <h2 id="nots-title">What you won’t get</h2>
  <ul>
    <li><s>An installer</s>It runs in the browser on the computer, tablet or phone you already have.</li>
    <li><s>A contract</s>Pay monthly. Close the shop whenever you like and take your data with you.</li>
    <li><s>Fees per sale</s>One price for the shop, however busy December gets.</li>
    <li><s>A training course</s>Each screen shows your staff around the first time they open it.</li>
  </ul>
</div></aside>

<%# Before and after, the Basecamp way: what a hardware shop keeps track with today, and what replaces each. %>
<section class="lp-section" id="how"><div class="lp-wrap">
  <div class="lp-head">
    <p class="lp-kicker">Be honest</p>
    <h2>How does your shop keep track today?</h2>
    <p class="lp-lede">If it’s a notebook, a calculator and a phone full of M-Pesa messages, you’re not alone. It works
      until it doesn’t: a stock take that never adds up, a customer who swears they paid, a Sunday night with Excel.</p>
  </div>
  <div class="lp-ba">
    <div class="lp-ba-col lp-ba-before">
      <h3>Before HardPoint</h3>
      <ul>
        <% [ "A calculator and a receipt book", "Stock in an exercise book", "Checking the phone for every M-Pesa",
             "An ETR machine in the corner", "The debtors’ notebook", "Quotes worked out on the counter",
             "Closing when the internet is down" ].each do |before| %>
          <li><%= cross %><%= before %></li>
        <% end %>
      </ul>
    </div>
    <div class="lp-ba-col lp-ba-after">
      <h3>After HardPoint</h3>
      <ul>
        <% [ [ "A real till.", "Scan, search or tap. F2 scan, F8 park, F9 pay." ],
             [ "Stock that’s right.", "The till won’t sell what isn’t on the shelf." ],
             [ "M-Pesa matched to the sale,", "by a prompt to the customer’s phone or by your Paybill." ],
             [ "eTIMS on every receipt,", "with KRA’s QR code." ],
             [ "Who owes you,", "with statements and Monday reminders." ],
             [ "Quotes in a minute", "from the material calculator." ],
             [ "Open all day,", "internet or not." ] ].each do |bold, rest| %>
          <li><%= tick %><span><b><%= bold %></b> <%= rest %></span></li>
        <% end %>
      </ul>
    </div>
  </div>
</div></section>

<%# The real till, with notes in the margin. %>
<section class="lp-section lp-section-tight"><div class="lp-wrap">
  <div class="lp-head lp-center">
    <p class="lp-kicker">At the counter</p>
    <h2>A till your cashier gets on day one.</h2>
    <p class="lp-lede">Big buttons, the shop’s own categories and the stock left on every one. Loose goods by the kilo
      or the metre. Works with the scanner and receipt printer you already have, on a computer, a touch screen or a phone.</p>
  </div>
  <% till_notes = [ "Tap the shop’s own categories", "Stock left, on every button", "Cash, M-Pesa, card, on account or foreign notes" ] %>
  <div class="lp-shot-wrap">
    <p class="lp-anno lp-anno-left" style="top: 17%; transform: rotate(-5deg)"><%= till_notes[0] %>
      <%= pen.([ "M2 8c26 0 50 8 74 24", "M62 34l14-2-4-13" ], "top: 18px") %></p>
    <p class="lp-anno lp-anno-left" style="top: 44%; transform: rotate(3deg)"><%= till_notes[1] %>
      <%= pen.([ "M2 24c30 6 56 0 76-14", "M64 6l14 4-6 12" ], "top: -2px") %></p>
    <p class="lp-anno lp-anno-right" style="top: 66%; transform: rotate(4deg)"><%= till_notes[2] %>
      <%= pen.([ "M78 6c-24 0-50 10-72 26", "M20 34L6 32l6-12" ], "top: 10px") %></p>
    <div class="lp-shot">
      <div class="lp-shot-bar" aria-hidden="true"><i></i><i></i><i></i><span>yourshop.hardpoint.app/pos</span></div>
      <%= image_tag "marketing/till.png", alt: "The HardPoint till: quick-pick buttons with prices and stock left, 2.5 kg of wire nails being added to a sale of cement and steel, and the payment buttons", width: 1280, height: 800, loading: "lazy" %>
    </div>
  </div>
  <ul class="lp-anno-list" aria-hidden="true"><% till_notes.each do |note| %><li><%= note %></li><% end %></ul>
  <p class="lp-center"><%= more.("Selling at the till", "selling") %></p>
</div></section>

<%# The offline till, in the first teal band: the story told as one morning's log. %>
<section class="lp-band"><div class="lp-wrap lp-section">
  <div class="lp-band-grid">
    <div>
      <p class="lp-kicker">The offline till</p>
      <h2>The internet goes down. The queue doesn’t notice.</h2>
      <p class="lp-lede">Power cuts, a router on strike, your internet provider having a morning. The till keeps its own
        copy of what it needs, so you keep selling.</p>
      <ol class="lp-points">
        <li>Every product, price, customer and promotion is already on the till.</li>
        <li>Take cash, or type in the M-Pesa, Airtel Money or card code, and print the receipt.</li>
        <li>Every sale goes up the moment it reconnects, once, and KRA signs it. Nothing to redo, nothing lost.</li>
      </ol>
      <%= more.("How the offline till works", "offline") %>
    </div>
    <div>
      <p class="lp-log-cap">An example Saturday morning at the yard</p>
      <ol class="lp-log" aria-label="An example morning at the till">
        <li><time>09:12</time><span>KES 12,400 · M-Pesa · signed by KRA</span></li>
        <li><time>09:40</time><span class="lp-down">Internet down. The till carries on.</span></li>
        <li><time>09:44</time><span>KES 3,150 · cash · waiting for KRA</span></li>
        <li><time>10:05</time><span>KES 860 · card code typed in · waiting for KRA</span></li>
        <li><time>10:31</time><span>KES 4,995 · M-Pesa code typed in · waiting for KRA</span></li>
        <li><time>10:52</time><span class="lp-up">Back online. 3 sales sent and signed.</span></li>
      </ol>
    </div>
  </div>
</div></section>

<%# The owner's view: the real home screen, with notes. %>
<section class="lp-section" id="owner"><div class="lp-wrap">
  <div class="lp-head lp-center">
    <p class="lp-kicker">For the owner</p>
    <h2>Know how today went <span class="lp-hl">before you get home.</span></h2>
    <p class="lp-lede">Today’s takings, sales, margin and what needs doing, live, from the shop or your phone. An email
      every morning with the day in charts, every Monday the week, and an alert the moment a till closes short.</p>
  </div>
  <% owner_notes = [ "Up on last Saturday? It says so", "What needs you, most costly first", "The week at a glance" ] %>
  <div class="lp-shot-wrap">
    <p class="lp-anno lp-anno-left" style="top: 20%; transform: rotate(-4deg)"><%= owner_notes[0] %>
      <%= pen.([ "M2 8c26-2 50 6 74 22", "M62 32l14-2-5-13" ], "top: 16px") %></p>
    <p class="lp-anno lp-anno-left" style="top: 46%; transform: rotate(3deg)"><%= owner_notes[1] %>
      <%= pen.([ "M2 12c30-4 56 4 76 18", "M64 32l14-2-6-12" ], "top: 4px") %></p>
    <p class="lp-anno lp-anno-right" style="top: 30%; transform: rotate(4deg)"><%= owner_notes[2] %>
      <%= pen.([ "M78 8c-26-2-50 8-72 26", "M20 36L6 34l6-12" ], "top: 8px") %></p>
    <div class="lp-shot">
      <div class="lp-shot-bar" aria-hidden="true"><i></i><i></i><i></i><span>yourshop.hardpoint.app</span></div>
      <%= image_tag "marketing/dashboard.png", alt: "The owner's home screen: takings, sales, margin and cash in the drawers, a list of what needs doing today, and charts of the week and of takings by hour", width: 1280, height: 800, loading: "lazy" %>
    </div>
  </div>
  <ul class="lp-anno-list" aria-hidden="true"><% owner_notes.each do |note| %><li><%= note %></li><% end %></ul>
  <p class="lp-center"><%= more.("Sales, profit, VAT, stock and shift reports", "reports") %></p>
</div></section>

<%# The rest of the shop, as cards in sticky-note colours; then everything else as a row of links. The Features
    link in the nav comes here. %>
<section class="lp-section lp-section-tight" id="features"><div class="lp-wrap">
  <div class="lp-head">
    <p class="lp-kicker">The rest of the shop</p>
    <h2>Everything a hardware store does. Nothing it doesn’t.</h2>
  </div>
  <div class="lp-cards">
    <% [ [ "M-Pesa", "Money that finds its own sale.", "Send a prompt to the customer’s phone from the till, or let a payment to your Paybill or Till find its sale. Airtel Money, card, foreign notes and cash with change too.", "M-Pesa at the till", "mpesa" ],
         [ "KRA eTIMS", "The taxman, handled.", "Every sale, void and return signed by KRA, with the QR code on the receipt. Queued and retried if KRA is down, so the queue never stops for the taxman.", "How eTIMS works", "etims" ],
         [ "Stock", "Never sell what isn’t there.", "Every morning, a list of what customers asked for and couldn’t get. One branch short and another full? It suggests the move before you order.", "Stock and stock takes", "stock-and-stock-takes" ],
         [ "Customers", "Accounts that get paid.", "Credit limits, statements and a list of who owes you. Accounts too long overdue go on hold, and Monday reminders go out by SMS or WhatsApp.", "Customer accounts", "customer-accounts" ],
         [ "Contractors", "A quote before they finish asking.", "A 40 m wall or a 10 × 8 slab becomes stones, cement, sand, ballast and steel at your prices, and one press makes the quote. Each job’s purchases kept together.", "The material calculator", "material-calculator" ],
         [ "Fundis", "Fundis’ commission, kept for you.", "The masons, plumbers and electricians who bring you customers earn their commission when the sale is paid, and you pay it out in cash or by M-Pesa.", "Fundis and commission", "fundis" ] ].each do |tag_line, title, body, link_text, slug| %>
      <article class="lp-card">
        <p class="lp-tag"><%= tag_line %></p>
        <h3><%= title %></h3>
        <p><%= body %></p>
        <%= more.(link_text, slug) %>
      </article>
    <% end %>
  </div>
  <div class="lp-also">
    <span class="lp-also-label">And the rest:</span>
    <% [ [ :staff, "Staff and roles", "staff-and-roles" ], [ :shifts, "Shifts and cash", "shifts-and-cash" ],
         [ :purchasing, "Buying from suppliers", "buying-from-suppliers" ], [ :promotions, "Promotions", "promotions" ],
         [ :deliveries, "Deliveries", "deliveries" ], [ :returns, "Returns", "returns-and-refunds" ],
         [ :online_store, "Online store", "online-store" ], [ :whatsapp, "WhatsApp", "whatsapp" ],
         [ :quickbooks, "QuickBooks", "quickbooks" ] ].each do |icon, label, slug| %>
      <%= link_to help_article_path(slug), class: "lp-chip" do %><%= render "pages/icon", name: icon, classes: "" %><%= label %><% end %>
    <% end %>
    <%= link_to "All the guides ›", help_path, class: "lp-link", style: "margin-left: 6px" %>
  </div>
</div></section>

<%# How to start: five steps, in order. %>
<section class="lp-section lp-rule" id="start"><div class="lp-wrap">
  <div class="lp-head">
    <p class="lp-kicker">Getting started</p>
    <h2>Up and running in an afternoon.</h2>
    <p class="lp-lede">A <strong>Set up your shop</strong> checklist walks you through it, and each screen shows you
      around the first time you open it. Rather we did it? <%= link_to "Ask about a setup visit", pricing_path(anchor: "setup"), class: "lp-link" %>.</p>
  </div>
  <ol class="lp-steps">
    <li><h3>Create your shop</h3><p>Pick your web address and the owner’s login. <%= trial.capitalize %> free, no card needed.</p></li>
    <li><h3>Name your branches and tills</h3><p>Check your tax rates and switch on only the features you use.</p></li>
    <li><h3>Bring in your products</h3><p>Import a spreadsheet of thousands in seconds, or add them one at a time.</p></li>
    <li><h3>Invite your staff</h3><p>Owner, manager, cashier, stock clerk or accountant, each seeing only their work.</p></li>
    <li><h3>Connect and sell</h3><p>Print a test receipt, connect M-Pesa and KRA eTIMS, and open the till.</p></li>
  </ol>
  <div class="lp-also">
    <span class="lp-also-label">Runs on what you’ve got:</span>
    <% [ [ :monitor, "Any computer or tablet" ], [ :barcode, "USB or Bluetooth scanners" ], [ :printer, "58 or 80 mm receipt printers" ], [ :drawer, "A cash drawer" ] ].each do |icon, label| %>
      <span class="lp-chip"><%= render "pages/icon", name: icon, classes: "" %><%= label %></span>
    <% end %>
    <%= link_to "Or a till kit, ready to plug in ›", pricing_path(anchor: "setup"), class: "lp-link", style: "margin-left: 6px" %>
  </div>
</div></section>

<%# Owners hand over their whole business: say plainly how it's kept, every line true of how HardPoint works
    (docs/SECURITY.md, the privacy page and the data processing terms say the same, in more detail). %>
<section class="lp-section lp-rule" id="security"><div class="lp-wrap">
  <div class="lp-head">
    <p class="lp-kicker">Your data</p>
    <h2>Safe, private, and yours.</h2>
    <p class="lp-lede">Your sales, stock, customers and staff belong to your shop. We look after them and do nothing else
      with them: we don’t sell data and we don’t show adverts.</p>
  </div>
  <ul class="lp-promises">
    <% [ [ "Walled off from every other shop", "Separated inside the database itself, so no other shop can see yours, even if the app had a fault." ],
         [ "Locked down", "Encrypted connections and keys, passwords not even we can read, and two-factor sign-in for owners and managers." ],
         [ "Backed up every minute", "Encrypted and copied off-site every minute, so your shop can be brought back to any moment." ],
         [ "Every change recorded", "Who did what and when, from a void to a price change, including our support staff if they ever sign in." ],
         [ "Take it with you, any time", "Export everything as spreadsheets any time, even after you stop paying. Close your account and we delete it." ],
         [ "Kenya’s Data Protection Act", "Written to the 2019 Act: we’re your data processor, and we tell you within 72 hours of a breach." ] ].each do |title, body| %>
      <li><h3><%= title %></h3><p><%= body %></p></li>
    <% end %>
  </ul>
  <p class="lp-small-links">In full: <%= link_to "Privacy and your data", privacy_path, class: "lp-link" %> ·
    <%= link_to "Data processing terms", data_processing_path, class: "lp-link" %> · <%= link_to "Service level agreement", sla_path, class: "lp-link" %></p>
</div></section>

<%# The price, from Plan, so it can't drift from billing. The pricing page has the monthly/yearly switch and the rest. %>
<section class="lp-section lp-pricing" id="pricing"><div class="lp-wrap">
  <div class="lp-head lp-center">
    <p class="lp-kicker">Pricing</p>
    <h2>One price for the shop. That’s it.</h2>
    <p class="lp-lede">HardPoint takes nothing per sale or per receipt. Pay by M-Pesa or card, monthly or yearly; a year
      costs <%= Plan::YEARLY_MONTHS_CHARGED %> months, so <%= months_free %> are free.</p>
  </div>
  <div class="lp-plans">
    <% @plans.each do |plan| %>
      <% recommended = plan.key == "business" %>
      <div id="plan_<%= plan.key %>" class="lp-plan <%= "lp-plan-pick" if recommended %>">
        <% if recommended %><p class="lp-plan-flag">Recommended</p><% end %>
        <h3><%= plan.name %></h3>
        <p class="lp-plan-for"><%= plan.blurb %></p>
        <p class="lp-price"><%= shillings.(plan.price_cents) %> <small>/ month</small></p>
        <p class="lp-price-year">or <%= shillings.(plan.yearly_price_cents) %> a year</p>
        <ul>
          <% Plan::RESOURCES.each do |resource| %>
            <% limit = plan.limit(resource) %>
            <li><%= tick %><span><%= limit ? Plan.allowance(limit, resource) : "Unlimited #{Plan::NOUNS[resource].pluralize}" %></span></li>
          <% end %>
          <li><%= tick %><span>Unlimited products</span></li>
          <% if plan.api? %><li><%= tick %><span>API and webhooks for web shops and other apps</span></li><% end %>
          <% if plan.add_ons? %><li><%= tick %><span>One more till <%= shillings.(plan.add_on_cents(:registers)) %>, a branch <%= shillings.(plan.add_on_cents(:branches)) %> a month</span></li><% end %>
        </ul>
        <%= link_to "Try #{plan.name} free", new_signup_path(plan: plan.key), class: "lp-btn #{"lp-btn-ghost" unless recommended}" %>
      </div>
    <% end %>
  </div>
  <p class="lp-price-foot">Every plan has every feature, M-Pesa, KRA eTIMS, the offline till and WhatsApp support.
    Business and Enterprise come with a 99.9% uptime promise in the <%= link_to "service level agreement", sla_path, class: "lp-link" %>.
    Texts to customers, if you switch them on, are billed by Africa’s Talking.
    <%= link_to "The full pricing", pricing_path, class: "lp-link" %>, with setup visits and till kits.</p>
</div></section>

<%# The questions a visitor has before clicking Start. The pricing page has the full list. %>
<section class="lp-section" id="questions"><div class="lp-wrap">
  <div class="lp-faq">
    <div class="lp-head">
      <p class="lp-kicker">Questions</p>
      <h2>Before you start.</h2>
      <p class="lp-lede">More answers on the <%= link_to "pricing page", pricing_path, class: "lp-link" %>, and a person
        on <%= link_to "WhatsApp", whatsapp_support_url, class: "lp-link", target: "_blank", rel: "noopener" %> for the rest.</p>
    </div>
    <div>
      <% landing_faqs.each do |question, answer| %>
        <details><summary><%= question %></summary><p><%= answer %></p></details>
      <% end %>
    </div>
  </div>
</div></section>

<%# The door, in the second teal band: the page ends on its strongest colour. %>
<section class="lp-band lp-door"><div class="lp-wrap lp-section">
  <p class="lp-kicker">Ready when you are</p>
  <h2>Open the till.</h2>
  <div class="lp-cta">
    <%= link_to new_signup_path, class: "lp-btn lp-btn-marker" do %>Try it free for <%= trial %><%= arrow %><% end %>
  </div>
  <p class="lp-door-note">No card needed · selling the same afternoon · questions?
    <%= link_to "WhatsApp us", whatsapp_support_url("Hello HardPoint, I'd like to know more about the POS."), target: "_blank", rel: "noopener" %></p>
</div></section>

</div>

<%# "Watch a sale": the help centre's walkthrough of the till, in a dialog over the page. %>
<dialog class="m-auto w-[min(72rem,calc(100vw-1.5rem))] overflow-hidden rounded-2xl border-2 border-[#0f2327] bg-white p-0 text-gray-800 shadow-2xl backdrop:bg-gray-950/60 backdrop:backdrop-blur-sm" data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop" aria-labelledby="sale-dialog-title">
  <div class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-3">
    <div>
      <p class="font-hand text-lg text-primary-600">Watch a sale</p>
      <h2 id="sale-dialog-title" class="font-semibold text-gray-950">From the first scan to the receipt, on the real screen.</h2>
    </div>
    <button type="button" class="flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-2xl leading-none text-gray-500 hover:bg-gray-100 hover:text-gray-900" data-action="dialog#close" aria-label="Close">×</button>
  </div>
  <div class="p-3 sm:p-5 [&_.walkthrough]:my-0">
    <%= render "help/walkthrough", tour: HelpTour.find("till"), compact: true %>
  </div>
  <p class="border-t border-gray-200 bg-gray-50 px-5 py-3 text-center text-sm text-gray-600">Liked it? <%= link_to "Try it free for #{trial}", new_signup_path, class: "font-medium text-accent-600 hover:underline" %> · Every screen has a guide like this one in the <%= link_to "help centre", help_path, class: "link" %>.</p>
</dialog>
</div>
