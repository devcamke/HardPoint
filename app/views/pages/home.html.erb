<% trial = Plan::TRIAL.inspect %>
<% structured_data seo_organization, seo_software(@plans), seo_faq(landing_faqs) %>
<%# In the manner of odoo.com: a white page, short bold headlines, the price said out loud in the hero with a
    hand-drawn arrow pointing at it, "Start now, it's free" everywhere, and a grid of app tiles standing in for a
    hero picture. The brand teal does the work Odoo's purple does: buttons, tiles, arrows and one full-colour band
    for the offline till. The order is the usual one for the trade, and an argument: the promise, what it works with,
    what it does, why it's different, the offline till, the owner's view, the hardware, how to start, how the data
    is kept, the price, the questions, and the door. Sections alternate white, light grey and a pale tint of the
    theme colour, so no two neighbours share a background, with two full-colour bands (the offline till and the closing
    call) as anchors; every section opens the same way, a small label, a bold headline and a line under it.
    The walkthrough of a sale is one click away, "Watch a sale" in the hero, in a dialog over the page.
    From the market: a "works with" strip where Shopify puts its logo wall, Square's "ready for what you've got"
    hardware section, and the questions before the door that both of them carry. %>
<% from_price = "KES #{number_with_delimiter(@plans.map(&:price_cents).min / 100)}" %>
<% learn_more = ->(text, slug) { link_to help_article_path(slug), class: "mt-4 inline-block font-medium text-accent-600 hover:underline" do
     safe_join([ text, " ", tag.span("›", aria: { hidden: true }) ])
   end } %>
<%# A curly arrow drawn by hand, as Odoo points at its price and its user count. %>
<% doodle_arrow = ->(classes) { tag.svg(class: classes, viewBox: "0 0 48 48", fill: "none", stroke: "currentColor", "stroke-width": "2.5", "stroke-linecap": "round", "stroke-linejoin": "round", aria: { hidden: true }) {
     safe_join([ tag.path(d: "M6 6c2 18 12 30 34 32"), tag.path(d: "M32 30l8 8-10 4") ])
   } } %>

<section class="bg-white" data-controller="dialog">
  <%# The hero as odoo.com draws its own: the headline in marker pen with a highlighter swash behind the words that
      matter, and the price scribbled beside an arrow. The small line above the headline is part of the h1, so search
      engines still read what HardPoint is; the headline is what it does. %>
  <div class="relative mx-auto max-w-5xl px-4 pt-20 pb-10 text-center sm:pt-28 sm:pb-12">
    <h1 class="font-hand text-5xl leading-[1.15] text-gray-950 text-balance sm:text-6xl lg:text-7xl">
      <span class="mb-6 block font-sans text-sm leading-normal font-semibold tracking-wide text-primary-600 uppercase">Point of sale and stock control for hardware stores in Kenya</span>
      Stock that adds up. A till that
      <span class="relative inline-block isolate whitespace-nowrap">
        <svg class="absolute -inset-x-[0.15em] bottom-[0.02em] -z-10 h-[0.8em] w-[calc(100%+0.3em)] text-amber-300" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true"><path d="M4 22C40 12 120 8 196 14L194 32C120 36 50 38 6 34Z" fill="currentColor"/></svg>
        <span class="relative">never stops.</span></span></h1>
    <p class="mx-auto mt-8 max-w-3xl text-lg text-gray-600 text-balance sm:text-xl">Most shop software was built for supermarkets and then sold to hardware stores. HardPoint was
      built for your counter, where cement goes by the bag, wire by the metre and nails by the kilo.
      <strong class="font-semibold text-gray-900">M-Pesa and KRA eTIMS come built in, and when the internet drops the till keeps selling.</strong></p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-3">
      <%= link_to "Try it free for #{trial}", new_signup_path, class: "btn-primary px-7 py-3 text-lg" %>
      <button type="button" class="btn border-gray-100 bg-gray-100 px-7 py-3 text-lg text-gray-800 hover:bg-gray-200" data-action="dialog#open">
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-5 text-primary-600" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>Watch a sale
      </button>
    </div>
    <p class="mt-4 text-sm text-gray-500">No card needed. Nothing to install. Questions? <%= link_to "Talk to us on WhatsApp", whatsapp_support_url("Hello HardPoint, I'd like to know more about the POS."), class: "font-medium text-accent-600 hover:underline", target: "_blank", rel: "noopener" %></p>

    <%# The price, in the margin, with an arrow down to it. %>
    <div class="font-hand mt-8 text-2xl leading-tight text-primary-700 xl:absolute xl:-right-28 xl:bottom-6 xl:mt-0 xl:w-56 xl:-rotate-6 xl:text-left">
      <svg class="mx-auto mb-1 h-12 w-16 xl:absolute xl:-top-12 xl:left-0 xl:h-10 xl:w-12 xl:-rotate-12" viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4c6 18 20 32 50 38"/><path d="M44 34l12 8-13 4"/></svg>
      <%= from_price %> a month<br>for the whole shop.<br>Not per till, not per sale.
    </div>
  </div>

  <%# "Watch a sale": the help centre's walkthrough of the till, in a dialog over the page, screen only. %>
  <dialog data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop" aria-labelledby="sale-dialog-title"
          class="m-auto w-[min(72rem,calc(100vw-1.5rem))] overflow-hidden rounded-2xl bg-white p-0 text-gray-800 shadow-2xl backdrop:bg-gray-950/60 backdrop:backdrop-blur-sm">
    <div class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-3">
      <div>
        <p class="text-xs font-semibold tracking-wide text-primary-600 uppercase">Watch a sale</p>
        <h2 id="sale-dialog-title" class="font-semibold text-gray-950">From the first scan to the receipt, on the real screen.</h2>
      </div>
      <button type="button" class="flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-2xl leading-none text-gray-500 hover:bg-gray-100 hover:text-gray-900" data-action="dialog#close" aria-label="Close">×</button>
    </div>
    <%# A film of a real sale, once there is one (MarketingHelper#sale_video), with the walkthrough to click through under it. %>
    <div class="max-h-[75vh] overflow-y-auto p-3 sm:p-5 [&_.walkthrough]:my-0">
      <% if (film = sale_video) %>
        <%= video_tag film[:src], controls: true, preload: "none", playsinline: true, poster: film[:poster], class: "aspect-video w-full rounded-xl bg-gray-950 ring-1 ring-gray-200", aria: { label: "A sale from the first search to the receipt" } %>
        <% if film[:recording] %><p class="mt-2 text-sm text-gray-500">Recorded on the real screen, in HardPoint’s demo shop. M-Pesa is simulated there. No sound.</p><% end %>
        <p class="mt-5 mb-3 text-sm font-semibold text-gray-950">Or click through it yourself:</p>
      <% end %>
      <%= render "help/walkthrough", tour: HelpTour.find("till"), compact: true %>
    </div>
    <p class="border-t border-gray-200 bg-gray-50 px-5 py-3 text-center text-sm text-gray-600">Liked it? <%= link_to "Start now, it's free", new_signup_path, class: "font-medium text-accent-600 hover:underline" %> · Every screen has a guide like this one in the <%= link_to "help centre", help_path, class: "link" %>.</p>
  </dialog>
</section>

<%# Where others put a wall of customer logos: what the shop already has, which HardPoint works with as it is. %>
<section class="border-t border-gray-200 bg-white">
  <%# The label on its own line, then the eight: one row spaced evenly on a wide screen; two or four neat columns,
      icons lined up, on smaller ones, so nothing is left alone on a row. %>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <p class="text-center text-xs font-semibold tracking-wide text-gray-500 uppercase">Works with what your shop already uses</p>
    <ul class="mx-auto mt-5 grid w-fit grid-cols-2 gap-x-10 gap-y-4 text-sm font-medium text-gray-700 sm:grid-cols-4 lg:flex lg:w-full lg:justify-between">
      <% [ [ :mpesa, "M-Pesa" ], [ :airtel, "Airtel Money" ], [ :card, "Cards" ], [ :etims, "KRA eTIMS" ], [ :barcode, "Barcode scanners" ],
           [ :printer, "Receipt printers" ], [ :whatsapp, "WhatsApp" ], [ :quickbooks, "QuickBooks" ] ].each do |icon, label| %>
        <li class="flex items-center gap-2 whitespace-nowrap"><span class="shrink-0 text-primary-600"><%= render "pages/icon", name: icon, classes: "size-5" %></span><%= label %></li>
      <% end %>
    </ul>
  </div>
</section>

<%# What a shop owner expects to be stuck with, and won't be: each struck through, with what happens instead. %>
<section class="border-t border-gray-200 bg-white" aria-labelledby="nots-title">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h2 id="nots-title" class="text-center text-xs font-semibold tracking-wide text-gray-500 uppercase">What you won’t get</h2>
    <ul class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      <% [ [ "An installer", "It runs in the browser on the computer, tablet or phone you already have." ],
           [ "A contract", "Pay monthly. Close the shop whenever you like and take your data with you." ],
           [ "Fees per sale", "One price for the shop, however busy December gets." ],
           [ "A training course", "Each screen shows your staff around the first time they open it." ] ].each do |nope, instead| %>
        <li><s class="block text-lg font-bold text-gray-500 decoration-rose-500 decoration-2"><%= nope %></s><span class="mt-1 block text-sm text-gray-600"><%= instead %></span></li>
      <% end %>
    </ul>
  </div>
</section>

<%# The product as a grid of tiles, one per thing a hardware shop does, each opening its help guide: white tiles with
      a coloured glyph, as Odoo draws its apps. Twelve, the ones a shop decides on; the guides hold the rest. The switch beneath, "Imagine without HardPoint", greys the tiles and
      writes by hand what each one replaces in a hardware shop. CSS alone: the switch is a checkbox the grid listens to. %>
<section id="features" class="scroll-mt-20 border-b border-gray-200/70 bg-gray-50">
  <%# The hero hands over to the tiles along a hand-drawn wave rather than a ruled line: white above, grey below. %>
  <svg class="block h-12 w-full sm:h-20 lg:h-24" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
    <path fill="#fff" d="M0 0H1440V62C1360 86 1280 96 1180 78C1080 60 1000 20 880 42C760 64 700 88 560 70C420 52 340 40 220 56C140 68 60 72 0 50Z"/>
  </svg>
  <div class="group/imagine mx-auto max-w-5xl px-4 pt-10 pb-20 sm:pt-12 sm:pb-24">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Be honest</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">How does your shop keep track today?</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">If it’s a notebook, a calculator and a phone full of M-Pesa messages, you’re not alone. It works
        until it doesn’t: a stock take that never adds up, a customer who swears they paid, a Sunday night with Excel.</p>
    </div>
    <% tiles = [
         [ "Till", "selling", :till, "text-primary-600", "A calculator and a receipt book" ],
         [ "Stock", "stock-and-stock-takes", :stock, "text-amber-500", "An exercise book" ],
         [ "M-Pesa", "mpesa", :mpesa, "text-green-600", "Checking the phone" ],
         [ "KRA eTIMS", "etims", :etims, "text-rose-600", "An ETR machine" ],
         [ "Customers", "customer-accounts", :customers, "text-violet-500", "The debtors' notebook" ],
         [ "Purchasing", "buying-from-suppliers", :purchasing, "text-orange-500", "Ringing round suppliers" ],
         [ "Reports", "reports", :reports, "text-blue-500", "Excel on Sunday night" ],
         [ "Promotions", "promotions", :promotions, "text-pink-500", "A chalkboard" ],
         [ "Contractors' jobs", "contractor-jobs", :jobs, "text-yellow-500", "Quotes on a notepad" ],
         [ "Staff and roles", "staff-and-roles", :staff, "text-purple-500", "One password for everyone" ],
         [ "Branches", "shop-settings", :branches, "text-teal-500", "Driving over to check" ],
         [ "Offline till", "offline", :offline, "text-gray-800", "Closing when the net is down" ],
         [ "Fundis", "fundis", :fundi, "text-amber-600", "Commission in a notebook" ],
         [ "Calculator", "material-calculator", :calculator, "text-sky-600", "Working it out on the counter" ]
       ] %>
    <ul class="grid grid-cols-3 gap-x-4 gap-y-10 text-center sm:grid-cols-4 lg:grid-cols-7">
      <% tiles.each do |label, slug, icon, colour, without| %>
        <li>
          <%= link_to help_article_path(slug), class: "group flex flex-col items-center gap-4" do %>
            <span class="flex size-20 items-center justify-center rounded-2xl bg-white shadow-lg shadow-gray-950/10 ring-1 ring-gray-950/5 transition duration-300 group-hover:-translate-y-1 group-hover:shadow-xl group-has-[:checked]/imagine:opacity-30 group-has-[:checked]/imagine:grayscale sm:size-24 <%= colour %>">
              <%= render "pages/icon", name: icon, classes: "size-10 sm:size-12" %>
            </span>
            <span class="font-medium text-gray-800 group-hover:text-gray-950 group-has-[:checked]/imagine:hidden sm:text-lg"><%= label %></span>
            <span class="font-hand hidden -rotate-3 text-lg leading-tight text-primary-700 text-balance group-has-[:checked]/imagine:block sm:text-xl"><%= without %></span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="mt-16 flex flex-col items-center justify-between gap-6 sm:flex-row">
      <label class="relative flex cursor-pointer items-center gap-4 select-none">
        <%# Sparks off the switch, as on odoo.com. %>
        <svg class="absolute -top-7 -left-8 size-10 text-primary-500" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M20 4v10M8 10l7 7M32 10l-7 7"/></svg>
        <input type="checkbox" class="peer sr-only">
        <span class="relative h-8 w-14 rounded-full bg-gray-300 transition peer-checked:bg-primary-500 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary-400">
          <span class="absolute top-1 left-1 size-6 rounded-full bg-white shadow transition group-has-[:checked]/imagine:translate-x-6"></span>
        </span>
        <span class="text-xl font-semibold text-gray-800 sm:text-2xl">Imagine without HardPoint</span>
      </label>
      <%= link_to help_path, class: "group flex items-center gap-3 text-xl font-semibold text-primary-700 hover:text-primary-800 sm:text-2xl" do %>
        See all the guides
        <svg class="h-6 w-14 transition group-hover:translate-x-1" viewBox="0 0 56 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13c14-5 28-5 44 0"/><path d="M38 6l10 7-11 6"/></svg>
      <% end %>
    </div>
  </div>
</section>

<%# The real till, with what to notice on it listed beneath. %>
<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">At the counter</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">A till your cashier gets on day one.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">Big buttons, the shop’s own categories and the stock left on every one. Loose goods by the kilo
        or the metre. Works with the scanner and receipt printer you already have, on a computer, a touch screen or a phone.</p>
    </div>
    <%= image_tag "marketing/till.png", alt: "The HardPoint till: quick-pick buttons with prices and stock left, a sale of cement, steel and 2.5 kg of wire nails, and the payment buttons", class: "mx-auto mt-12 w-full max-w-5xl rounded-2xl shadow-2xl shadow-gray-950/15 ring-1 ring-gray-200", width: 1280, height: 800, loading: "lazy" %>
    <ul class="mx-auto mt-8 flex max-w-4xl flex-wrap justify-center gap-x-8 gap-y-2 text-gray-700">
      <% [ "Tap the shop’s own categories", "Stock left, on every button", "Cash, M-Pesa, card, on account or foreign notes" ].each do |note| %>
        <li class="flex items-center gap-1.5"><%= render "pages/check" %><%= note %></li>
      <% end %>
    </ul>
    <p class="text-center"><%= learn_more.("Selling at the till", "selling") %></p>
  </div>
</section>

<%# One full-colour band, where Odoo has its yellow one. The copy on the left; on the right a drawn till that tells
    the story in a loop: the signal drops, sales ring up and queue as orange dots, a receipt prints, the signal
    returns, and the dots fly up to the cloud. The animation is CSS (offline-art in application.css) and stands
    still for anyone who prefers reduced motion, showing the offline scene. %>
<section class="offline-band relative overflow-hidden text-white">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16">
    <div class="max-w-xl">
      <p class="text-sm font-semibold tracking-wide text-primary-200 uppercase">The offline till</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-balance sm:text-5xl">The internet goes down. The queue doesn’t notice.</h2>
      <p class="mt-5 text-lg text-primary-100 text-balance sm:text-xl">Power cuts, a router on strike, your internet provider having a morning. The till keeps its own
        copy of what it needs, so you keep selling.</p>
      <ul class="mt-8 space-y-4">
        <% [ [ :stock, "Every product, price, customer and promotion is already on the till." ],
             [ :printer, "Take cash, or type in the M-Pesa, Airtel Money or card code, and print the receipt." ],
             [ :sync, "Every sale goes up the moment it reconnects, once, and KRA signs it. Nothing to redo, nothing lost." ] ].each do |icon, text| %>
          <li class="flex gap-4">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white/15 text-white ring-1 ring-white/20"><%= render "pages/icon", name: icon, classes: "size-5" %></span>
            <p class="pt-1.5 text-primary-50"><%= text %></p>
          </li>
        <% end %>
      </ul>
      <%= link_to help_article_path("offline"), class: "mt-8 inline-block font-medium text-white underline-offset-4 hover:underline" do %>How the offline till works <span aria-hidden="true">›</span><% end %>
    </div>

    <div class="offline-art mx-auto w-full max-w-lg lg:max-w-none" aria-hidden="true">
      <svg viewBox="0 0 480 340" class="h-auto w-full" fill="none">
        <%# The signal, lost then found. %>
        <g class="oa-arcs" stroke="#fff" stroke-width="3.5" stroke-linecap="round">
          <path d="M90 74a42 42 0 0 1 60 0"/><path d="M104 88a22 22 0 0 1 32 0"/>
          <circle cx="120" cy="100" r="3.5" fill="#fff" stroke="none"/>
        </g>
        <path class="oa-slash" d="M96 50 L144 98" stroke="#fda4af" stroke-width="3.5" stroke-linecap="round"/>

        <%# The cloud, and the dotted road up to it. %>
        <path class="oa-cloud" d="M380 104h70a20 20 0 0 0 3-40 28 28 0 0 0-52-9 22 22 0 0 0-21 49z" fill="#fff" fill-opacity="0.1" stroke="#fff" stroke-opacity="0.7" stroke-width="2.5" stroke-linejoin="round"/>
        <path class="oa-check" d="M403 82l8 8 16-16" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" opacity="0"/>
        <path d="M308 120 L392 92" stroke="#fff" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round"/>

        <%# The sales waiting to go up. %>
        <circle class="oa-sale-1" cx="308" cy="120" r="5.5" fill="#e46f2f" stroke="#fff" stroke-width="2"/>
        <circle class="oa-sale-2" cx="322" cy="115.3" r="5.5" fill="#e46f2f" stroke="#fff" stroke-width="2"/>
        <circle class="oa-sale-3" cx="336" cy="110.7" r="5.5" fill="#e46f2f" stroke="#fff" stroke-width="2"/>

        <%# The till. %>
        <ellipse cx="240" cy="322" rx="190" ry="10" fill="#fff" fill-opacity="0.08"/>
        <rect x="170" y="280" width="40" height="24" fill="#fff" fill-opacity="0.3"/>
        <rect x="126" y="302" width="128" height="10" rx="5" fill="#fff" fill-opacity="0.4"/>
        <rect x="60" y="110" width="260" height="170" rx="16" fill="#fff" fill-opacity="0.08" stroke="#fff" stroke-opacity="0.55" stroke-width="2"/>
        <rect x="76" y="126" width="140" height="22" rx="6" fill="#fff" fill-opacity="0.15"/>
        <g transform="translate(228 126)">
          <rect width="76" height="22" rx="11" fill="#fff" fill-opacity="0.2"/>
          <circle class="oa-dot" cx="13" cy="11" r="4.5" fill="#f59e0b"/>
          <text class="oa-offline-text" x="25" y="15" fill="#fff" font-size="11" font-weight="600">Offline</text>
          <text class="oa-online-text" x="25" y="15" fill="#fff" font-size="11" font-weight="600" opacity="0">Online</text>
        </g>
        <g class="oa-line-1"><rect x="76" y="162" width="150" height="14" rx="4" fill="#fff" fill-opacity="0.6"/><rect x="250" y="162" width="54" height="14" rx="4" fill="#fff" fill-opacity="0.35"/></g>
        <g class="oa-line-2"><rect x="76" y="188" width="118" height="14" rx="4" fill="#fff" fill-opacity="0.6"/><rect x="250" y="188" width="54" height="14" rx="4" fill="#fff" fill-opacity="0.35"/></g>
        <g class="oa-line-3"><rect x="76" y="214" width="136" height="14" rx="4" fill="#fff" fill-opacity="0.6"/><rect x="250" y="214" width="54" height="14" rx="4" fill="#fff" fill-opacity="0.35"/></g>
        <rect x="76" y="246" width="228" height="22" rx="7" fill="#e46f2f"/>
        <text x="190" y="261" fill="#fff" font-size="12" font-weight="700" text-anchor="middle">Pay</text>

        <%# The printer and its receipt. %>
        <g class="oa-receipt">
          <rect x="352" y="196" width="56" height="64" rx="2" fill="#fff"/>
          <rect x="360" y="206" width="40" height="3" fill="#93b7be"/><rect x="360" y="216" width="28" height="3" fill="#93b7be"/>
          <rect x="360" y="226" width="36" height="3" fill="#93b7be"/><rect x="360" y="240" width="40" height="3" fill="#0f5e6e"/>
        </g>
        <rect x="338" y="258" width="84" height="44" rx="10" fill="#fff" fill-opacity="0.2" stroke="#fff" stroke-opacity="0.5" stroke-width="2"/>
        <rect x="350" y="257" width="60" height="4" rx="2" fill="#072d35" fill-opacity="0.6"/>
      </svg>
    </div>
  </div>
</section>

<%# The owner's view: the dashboard, the evening summary and the reports. %>
<section class="border-y border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">For the owner</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-gray-950 text-balance sm:text-5xl">Know how today went before you get home.</h2>
      <p class="mt-5 text-lg text-gray-600 text-balance sm:text-xl">Today’s takings, sales, margin and what needs doing, live, from the shop or your phone. An email
        every morning with the day in charts, every Monday the week, and an alert the moment a till closes short.</p>
    </div>
    <%= image_tag "marketing/dashboard.png", alt: "The owner's home screen: takings, sales, margin and cash in the drawers, a list of what needs doing today, and charts of the week and of takings by hour", class: "mx-auto mt-12 w-full max-w-5xl rounded-2xl shadow-2xl shadow-gray-950/15 ring-1 ring-gray-200", width: 1280, height: 800, loading: "lazy" %>
    <ul class="mx-auto mt-8 flex max-w-4xl flex-wrap justify-center gap-x-8 gap-y-2 text-gray-700">
      <% [ "Up on last Saturday? It says so", "What needs you, most costly first", "The week at a glance" ].each do |note| %>
        <li class="flex items-center gap-1.5"><%= render "pages/check" %><%= note %></li>
      <% end %>
    </ul>
    <p class="text-center"><%= learn_more.("Sales, profit, VAT, stock and shift reports", "reports") %></p>
  </div>
</section>

<%# Keeping an eye on the counter, told as an example of the morning email and the alerts that don't wait for it.
    The wording is the email's own (CashierPatterns, OwnerAlertsMailer); the names and numbers are made up. %>
<section id="counter" class="scroll-mt-20 bg-white">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:py-20 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="text-sm font-semibold tracking-wide text-primary-600 uppercase">Trust, but check</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 text-balance sm:text-4xl">Know what happened at the counter, without standing at it.</h2>
      <p class="mt-5 text-lg text-gray-600">Most shrinkage isn’t theft from the shelf. It’s a void here, a discount there, a drawer opened
        for change. HardPoint asks for the right person at the right moment, and tells you the next morning what stood out.</p>
      <ul class="mt-8 space-y-4">
        <% [ [ "A manager’s PIN for the big things.", "Discounts over your limit, voids, returns and going over a credit limit. The PIN approves that one thing and signs nobody in." ],
             [ "Shifts that add up.", "An opening float, cash drops and payouts, a blind count at close and a Z report." ],
             [ "No silent drawer.", "Opening the drawer without a sale asks why, and every opening is listed on the shift." ],
             [ "Each cashier against their own usual.", "Voids, discounts, cash refunds and drawer openings well above a cashier’s normal day are flagged in the morning email." ],
             [ "Alerts that don’t wait.", "An email straight away when a till closes short, a big sale is voided or a stock count comes out short." ],
             [ "A record of who did what.", "From a price change to a void, including our support staff if they ever sign in." ] ].each do |bold, rest| %>
          <li class="flex gap-3"><%= render "pages/check", classes: "mt-1 text-primary-600" %><span class="text-gray-600"><strong class="font-semibold text-gray-950"><%= bold %></strong> <%= rest %></span></li>
        <% end %>
      </ul>
      <%= learn_more.("Shifts and cash", "shifts-and-cash") %>
    </div>
    <figure class="mx-auto w-full max-w-md" aria-label="An example of the owner's morning email">
      <figcaption class="mb-3 text-center text-xs font-semibold tracking-wide text-gray-500 uppercase">An example morning email</figcaption>
      <div class="rounded-2xl bg-white p-6 shadow-2xl shadow-gray-950/15 ring-1 ring-gray-200">
        <div class="flex justify-between text-sm text-gray-500"><span class="font-semibold text-primary-700">HardPoint</span><span>7:00</span></div>
        <p class="mt-2 font-semibold text-gray-950">Mwangi Hardware: KES 184,250.00 taken on Wednesday</p>
        <div class="mt-5 grid grid-cols-3 gap-3 border-y border-gray-100 py-4">
          <div><span class="block text-xs text-gray-500">Takings</span><b class="block font-bold text-gray-950 tabular-nums">KES 184,250</b><span class="block text-xs text-green-700">+12% on last Wednesday</span></div>
          <div><span class="block text-xs text-gray-500">Sales</span><b class="block font-bold text-gray-950 tabular-nums">41</b></div>
          <div><span class="block text-xs text-gray-500">Margin</span><b class="block font-bold text-gray-950 tabular-nums">18.4%</b></div>
        </div>
        <p class="mt-4 text-xs font-semibold tracking-wide text-gray-500 uppercase">Worth a look</p>
        <ul class="mt-2 space-y-2 text-sm text-gray-700">
          <li><b class="font-semibold text-gray-950">Kevin</b> voided 7 sales <span class="text-gray-500">(usually about 1 a day)</span></li>
          <li><b class="font-semibold text-gray-950">Grace</b> opened the drawer without a sale 5 times <span class="text-gray-500">(usually under one a day)</span></li>
        </ul>
      </div>
      <div class="mt-4 flex items-center gap-3 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-200"><span class="size-2 shrink-0 rounded-full bg-amber-500" aria-hidden="true"></span><span><b class="font-semibold">Sent at 18:42:</b> Front counter closed KES 1,200 short</span></div>
    </figure>
  </div>
</section>

<%# Away from the counter: the stock app on a phone for the staff, and a customer's own page for the customers.
