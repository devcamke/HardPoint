<%# locals: (plans:) %>
<%# The plans, from Plan, on the landing and pricing pages. Whole shillings: every plan is a round amount, and
    "KES 2,500.00" reads like an invoice. The monthly/yearly switch is CSS only (:has on the radios), so it works
    with nothing loaded. %>
<% shillings = ->(cents) { "KES #{number_with_delimiter(cents / 100)}" }
   months_free = 12 - Plan::YEARLY_MONTHS_CHARGED
   tick = tag.svg(viewBox: "0 0 20 20", aria: { hidden: true }) { tag.path(d: "M3.5 10.5l4 4L16.5 5.5") } %>

<div class="lp-plans-wrap">
  <fieldset class="lp-billing">
    <legend class="sr-only">Pay monthly or yearly</legend>
    <label><input type="radio" name="billing" value="monthly" class="sr-only" checked>Monthly</label>
    <label><input type="radio" name="billing" value="yearly" class="sr-only">Yearly <span class="lp-free"><%= months_free %> months free</span></label>
  </fieldset>

  <div class="lp-plans">
    <% plans.each do |plan| %>
      <% recommended = plan.key == "business" %>
      <div id="plan_<%= plan.key %>" class="lp-plan <%= "lp-plan-pick" if recommended %>">
        <% if recommended %><p class="lp-plan-flag">Recommended</p><% end %>
        <h3><%= plan.name %></h3>
        <p class="lp-plan-for"><%= plan.blurb %></p>
        <div class="lp-monthly">
          <p class="lp-price"><%= shillings.(plan.price_cents) %> <small>/ month</small></p>
          <p class="lp-price-year">or <%= shillings.(plan.yearly_price_cents) %> a year, <%= months_free %> months free</p>
        </div>
        <div class="lp-yearly">
          <p class="lp-price"><%= shillings.(plan.yearly_price_cents) %> <small>/ year</small></p>
          <p class="lp-price-year"><%= months_free %> months free, and the setup visit is included</p>
        </div>
        <ul>
          <% Plan::RESOURCES.each do |resource| %>
            <% limit = plan.limit(resource) %>
            <li><%= tick %><span><%= limit ? Plan.allowance(limit, resource) : "Unlimited #{Plan::NOUNS[resource].pluralize}" %></span></li>
          <% end %>
          <li><%= tick %><span>Unlimited products</span></li>
          <% if plan.api? %><li><%= tick %><span>API and webhooks for web shops and other apps</span></li><% end %>
        </ul>
        <% if plan.add_ons? %>
          <p class="lp-price-year mt-[16px]">Need one more? A till is <%= shillings.(plan.add_on_cents(:registers)) %> and a branch <%= shillings.(plan.add_on_cents(:branches)) %> a month.</p>
        <% end %>
        <%= link_to "Try #{plan.name} free", new_signup_path(plan: plan.key), class: "lp-btn #{"lp-btn-ghost" unless recommended}" %>
      </div>
    <% end %>
  </div>

  <div class="lp-includes" aria-label="Every plan includes">
    <% [ "Every feature", "M-Pesa and Airtel Money", "KRA eTIMS", "The till keeps selling offline", "Tablets, touch screens and phones",
         "Your data as spreadsheets, any time", "WhatsApp support" ].each do |item| %>
      <span class="lp-chip"><%= tick %><%= item %></span>
    <% end %>
  </div>
  <p class="lp-price-foot">Prices in Kenya shillings, per shop. <%= Plan::TRIAL.inspect.capitalize %> free, no card needed. Pay by M-Pesa or card.</p>
</div>
