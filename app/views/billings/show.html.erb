<% content_for :title, "Billing" %>
<% plan = @account.subscription_plan %>
<% usage = @account.usage %>

<div class="mt-2 mb-6">
  <h1 class="text-xl font-medium"><%= link_to "Settings", settings_path, class: "link" %> <span class="text-gray-400">/</span> Billing</h1>
  <p class="hint mt-1">
    <% if @account.trialing? && @account.trial_ends_at %>
      Free trial of the <%= plan.name %> plan: <strong><%= pluralize(@account.trial_days_left, "day") %> left</strong>, until <%= l(@account.trial_ends_at.to_date, format: :long) %>. The first invoice comes then, due a week later.
    <% elsif @account.suspended? %>
      <span class="font-semibold text-red-700">Suspended<%= ": #{@account.suspended_reason}" if @account.suspended_reason.present? %>.</span> Contact HardPoint support.
    <% elsif @account.read_only? %>
      <span class="font-semibold text-red-700">Read-only until the invoice below is paid.</span> Everything can still be seen and exported.
    <% elsif @account.current_period_ends_at %>
      <%= plan.name %> plan, billed <%= @account.billing_interval %>, paid until <%= l(@account.current_period_ends_at.to_date, format: :long) %>.
    <% end %>
  </p>
</div>

<% if @invoice %>
  <section class="card mb-6 border-2 <%= @invoice.overdue? ? "border-red-300" : "border-primary-300" %>">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="hint">Invoice <%= link_to @invoice.number, billing_invoice_path(@invoice), target: "_blank", class: "link font-mono" %> · <%= @invoice.description %></p>
        <p class="mt-1 text-3xl font-bold tabular-nums"><%= money(@invoice.amount_cents, currency: @invoice.currency) %></p>
        <p class="<%= @invoice.overdue? ? "font-semibold text-red-700" : "text-gray-500" %>"><%= @invoice.overdue? ? "Was due" : "Due" %> <%= l(@invoice.due_on, format: :long) %></p>
      </div>
      <div class="w-full max-w-md space-y-3">
        <% if @pending_mpesa %>
          <div class="rounded-lg border-2 border-primary-500 bg-primary-50 p-3" data-controller="mpesa-poll" data-mpesa-poll-url-value="<%= billing_mpesa_payment_path(@pending_mpesa, format: :json) %>">
            <p class="flex items-center gap-2 font-semibold"><span class="size-3 animate-pulse rounded-full bg-primary-500"></span>Waiting for <%= PhoneNumber.display(@pending_mpesa.phone) %> to enter their M-Pesa PIN</p>
          </div>
        <% elsif Billing::MpesaShortcode.new.available? %>
          <%= form_with url: billing_mpesa_payments_path, class: "flex items-end gap-2" do |form| %>
            <div class="flex-1"><%= form.label :phone, "Pay by M-Pesa (a prompt to your phone)", class: "label" %>
              <%= form.telephone_field :phone, value: PhoneNumber.display(Current.user.try(:phone)), placeholder: "0722 000 111", required: true, class: "input" %></div>
            <%= form.submit "Pay by M-Pesa", class: "btn-primary" %>
          <% end %>
        <% end %>
        <% if Billing::Paystack.available? %>
          <%= button_to "Pay by card", billing_card_payments_path, class: "btn-secondary w-full", form: { data: { turbo: false } } %>
        <% end %>
        <% if (failed = @invoice.payments.failed.last) %><p class="text-sm text-red-700">Last attempt: <%= failed.failure %></p><% end %>
      </div>
    </div>
  </section>
<% elsif @account.trialing? %>
  <section class="card mb-6 flex flex-wrap items-center justify-between gap-3">
    <p>Ready to keep HardPoint? You can start paying now; the trial ends when you do.</p>
    <%= button_to "Start my subscription", billing_subscription_start_path, class: "btn-secondary" %>
  </section>
<% end %>

<h2 class="mb-3 text-lg font-semibold">Plans</h2>
<div class="mb-8 grid gap-4 md:grid-cols-3">
  <% Plan.all.each do |option| %>
    <% current = option == plan %>
    <section class="card flex flex-col <%= "border-2 border-primary-500" if current %>">
      <p class="text-lg font-semibold"><%= option.name %> <%= status_dot("Your plan", :info, class: "ml-2") if current %></p>
      <p class="hint"><%= option.blurb %></p>
      <p class="my-3 text-2xl font-bold"><%= option.price %><span class="text-sm font-normal text-gray-500"> / month, or <%= option.yearly_price %> a year</span></p>
      <ul class="mb-4 space-y-1 text-sm">
        <% Plan::RESOURCES.each do |resource| %>
          <% limit = option.limit(resource) %>
          <% over = limit && usage[resource] > (@account.limit(resource, on: option) || usage[resource]) %>
          <li class="flex justify-between <%= "text-red-700" if over %>"><span><%= { branches: "Branches", registers: "Tills", users: "Staff" }[resource] %></span>
            <span class="tabular-nums"><%= limit ? number_with_delimiter(limit) : "No limit" %></span></li>
        <% end %>
        <li class="flex justify-between"><span>Products</span><span>No limit</span></li>
        <% if option.add_ons? %>
          <li class="hint pt-1">Extra till <%= Money.format(option.add_on_cents(:registers), currency: "KES") %>, extra branch <%= Money.format(option.add_on_cents(:branches), currency: "KES") %> a month</li>
        <% end %>
      </ul>
      <% unless current %>
        <%= button_to "Switch to #{option.name}", billing_plan_path, method: :patch, params: { plan: option.key }, class: "btn-secondary mt-auto w-full",
              disabled: !@account.within_plan?(option), title: ("This shop uses more than #{option.name} allows" unless @account.within_plan?(option)) %>
      <% end %>
    </section>
  <% end %>
</div>

<section id="add_ons" class="card mb-6">
  <h2 class="mb-1 text-lg font-semibold">Add-ons and how often you pay</h2>
  <p class="hint mb-4">
    <% if plan.add_ons? %>
      One more till or branch than <%= plan.name %> allows? Add it here instead of moving up a plan. More room applies straight away; prices change from your next invoice.
    <% else %>
      <%= plan.name %> has no limits, so there's nothing to add. You can still choose to pay yearly.
    <% end %>
  </p>
  <%= form_with model: @account, url: billing_add_ons_path, method: :patch, class: "flex flex-wrap items-end gap-4" do |form| %>
    <% if plan.add_ons? %>
      <div><%= form.label :extra_registers, "Extra tills (#{Money.format(plan.add_on_cents(:registers), currency: "KES")} a month each)", class: "label" %>
        <%= form.number_field :extra_registers, min: 0, max: 99, class: "input w-28" %></div>
      <div><%= form.label :extra_branches, "Extra branches (#{Money.format(plan.add_on_cents(:branches), currency: "KES")} a month each)", class: "label" %>
        <%= form.number_field :extra_branches, min: 0, max: 99, class: "input w-28" %></div>
    <% end %>
    <fieldset>
      <legend class="label">Pay</legend>
      <div class="flex gap-4">
        <label class="flex items-center gap-2"><%= form.radio_button :billing_interval, "monthly" %> Monthly</label>
        <label class="flex items-center gap-2"><%= form.radio_button :billing_interval, "yearly" %> Yearly, <%= 12 - Plan::YEARLY_MONTHS_CHARGED %> months free</label>
      </div>
    </fieldset>
    <%= form.submit "Save", class: "btn-secondary" %>
  <% end %>
  <p class="hint mt-3">Your next invoice: <strong class="tabular-nums"><%= money(@account.period_price_cents, currency: "KES") %></strong> for <%= @account.yearly? ? "a year" : "a month" %>
    (<%= plan.name %> plan<%= " with #{@account.add_ons.select { |_, n| n.positive? }.map { |resource, n| Plan.allowance(n, resource) }.to_sentence} extra" if @account.add_ons.values.any?(&:positive?) %>).</p>
</section>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="card">
    <h2 class="mb-3 text-lg font-semibold">In use</h2>
    <% Plan::RESOURCES.each do |resource| %>
      <% limit = @account.limit(resource) %>
      <div class="mb-3">
        <p class="flex justify-between text-sm"><span><%= { branches: "Branches", registers: "Active tills", users: "Staff" }[resource] %></span>
          <span class="tabular-nums"><%= number_with_delimiter(usage[resource]) %><%= " of #{number_with_delimiter(limit)}" if limit %></span></p>
        <% if limit %>
          <div class="mt-1 h-2 rounded-full bg-gray-200"><div class="h-2 rounded-full <%= usage[resource] >= limit ? "bg-red-600" : "bg-primary-500" %>" style="width: <%= [ usage[resource] * 100 / [ limit, 1 ].max, 100 ].min %>%"></div></div>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="card">
    <h2 class="mb-3 text-lg font-semibold">Invoices</h2>
    <% if @invoices.any? %>
      <table class="table">
        <tbody>
          <% @invoices.each do |invoice| %>
            <tr><td><%= link_to invoice.number, billing_invoice_path(invoice), target: "_blank", class: "link font-mono" %></td>
              <td class="text-sm"><%= invoice.one_off? ? invoice.description : "#{invoice.period_start.strftime("%-d %b")} – #{(invoice.period_end - 1).strftime("%-d %b %Y")}" %></td>
              <td class="tabular-nums"><%= money(invoice.amount_cents, currency: invoice.currency) %></td>
              <td><%= status_dot invoice.paid? ? "Paid" : (invoice.overdue? ? "Overdue" : "Due"), invoice.paid? ? :success : (invoice.overdue? ? :danger : :warning) %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="hint">No invoices yet.</p>
    <% end %>
  </section>
</div>
