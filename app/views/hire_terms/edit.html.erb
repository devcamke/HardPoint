<% content_for :title, "Hire terms" %>
<% account = Current.account %>

<div class="mt-2 mb-6">
  <h1 class="text-xl font-medium"><%= link_to "Tools for hire", hire_items_path, class: "link" %> <span class="text-gray-400">/</span> Hire terms</h1>
  <p class="mt-1 max-w-3xl text-gray-500">The terms printed on every hire agreement, above the signatures. Each agreement keeps the terms it was made
    under, so a change here applies to agreements made from now on, never to ones already signed.</p>
</div>

<div class="grid items-start gap-6 lg:grid-cols-2">
  <%= form_with model: account, url: hire_terms_path, method: :patch, class: "card" do |form| %>
    <%= render "shared/errors", model: account %>
    <div class="field">
      <%= form.label :hire_terms, "Your terms, one per line", class: "label" %>
      <%= form.text_area :hire_terms, value: account.hire_terms_list.join("\n"), rows: 14, class: "input text-sm",
            "aria-describedby": "hire_terms_hint" %>
      <p id="hire_terms_hint" class="hint mt-1">Each line is one numbered term. Up to <%= Account::HireTerms::MAX_TERMS %> terms of
        <%= Account::HireTerms::MAX_TERM_LENGTH %> characters each. Numbers you type at the start of a line are left off; the agreement numbers them.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <%= form.submit "Save terms", class: "btn-primary" %>
      <% if account.own_hire_terms? %>
        <%= form.button "Go back to the standard terms", name: "reset", value: "1", class: "btn-secondary",
              data: { turbo_confirm: "Use the standard terms on new agreements? Your own terms will be removed." } %>
      <% end %>
    </div>
  <% end %>

  <section class="card">
    <h2 class="mb-1 font-semibold">On the agreement now</h2>
    <p class="hint mb-3"><%= account.own_hire_terms? ? "Your own terms." : "The standard terms. Change them on the left to make them your own." %></p>
    <ol class="list-decimal space-y-1.5 pl-5 text-sm text-gray-800">
      <% account.hire_terms_list.each do |term| %><li><%= term %></li><% end %>
    </ol>
  </section>
</div>
