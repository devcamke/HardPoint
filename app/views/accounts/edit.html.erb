<% content_for :title, "Shop settings" %>

<h1 class="mb-6 text-3xl font-bold">Shop settings</h1>

<div class="card max-w-xl">
  <%= form_with model: @account, url: account_path do |form| %>
    <%= render "shared/errors", model: @account %>

    <div class="field">
      <%= form.label :name, "Business name", class: "label" %>
      <%= form.text_field :name, required: true, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :time_zone, class: "label" %>
      <%= form.time_zone_select :time_zone, nil, {}, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :currency, "Currency (ISO code)", class: "label" %>
      <%= form.text_field :currency, required: true, maxlength: 3, class: "input uppercase" %>
    </div>

    <div class="field">
      <%= form.label :max_cashier_discount_percent, "Largest discount a cashier can give without approval (%)", class: "label" %>
      <%= form.number_field :max_cashier_discount_percent, value: plain_number(@account.max_cashier_discount_percent), step: "0.5", min: 0, max: 100, class: "input w-32" %>
    </div>

    <div class="field">
      <%= form.label :receipt_footer, "Receipt footer", class: "label" %>
      <%= form.text_area :receipt_footer, rows: 2, class: "input", placeholder: "e.g. Goods sold are returnable within 7 days with this receipt. PIN P051234567X" %>
    </div>

    <div class="field flex items-start gap-2">
      <%= form.check_box :require_two_factor_for_managers, class: "mt-1 size-4 accent-safety-500" %>
      <div>
        <%= form.label :require_two_factor_for_managers, "Require two-factor sign-in for owners and managers", class: "text-sm font-medium text-navy-800" %>
        <p class="hint">They'll be asked to set it up the next time they use HardPoint.</p>
      </div>
    </div>

    <p class="mb-4 text-sm text-steel-600">Web address: <%= request.host %> (contact support to change it)</p>

    <%= form.submit "Save settings", class: "btn-primary" %>
  <% end %>
</div>
