<% content_for :title, "Shop settings" %>

<h1 class="mb-6 text-xl font-medium">Shop settings</h1>

<div class="card max-w-xl">
  <%= form_with model: @account, url: account_path do |form| %>
    <%= render "shared/errors", model: @account %>

    <div class="field">
      <%= form.label :name, "Business name", class: "label" %>
      <%= form.text_field :name, required: true, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :time_zone, class: "label" %>
      <%= form.time_zone_select :time_zone, nil, {}, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :currency, "Currency (ISO code)", class: "label" %>
      <%= form.text_field :currency, required: true, maxlength: 3, class: "input uppercase" %>
    </div>

    <div class="field">
      <%= form.label :max_cashier_discount_percent, "Largest discount a cashier can give without approval (%)", class: "label" %>
      <%= form.number_field :max_cashier_discount_percent, value: plain_number(@account.max_cashier_discount_percent), step: "0.5", min: 0, max: 100, class: "input w-32" %>
    </div>

    <div class="field">
      <%= form.label :payout_approval_above, "Payouts from a till above this need a manager's approval PIN (#{@account.currency})", class: "label" %>
      <%= form.number_field :payout_approval_above, value: plain_number(@account.payout_approval_above), step: "0.01", min: 0, class: "input w-40" %>
    </div>

    <fieldset id="alerts" class="field scroll-mt-16">
      <legend class="label">Email owners and managers straight away when</legend>
      <p class="hint mb-2">Everything smaller still shows in the next morning's summary. Each person can turn these emails off under My profile.</p>
      <div class="grid gap-3 sm:grid-cols-3">
        <div>
          <%= form.label :alert_shift_short_above, "A till closes short by more than (#{@account.currency})", class: "text-sm text-gray-700" %>
          <%= form.number_field :alert_shift_short_above, value: plain_number(@account.alert_shift_short_above), step: "0.01", min: 0, class: "input" %>
        </div>
        <div>
          <%= form.label :alert_void_above, "A completed sale over this is voided (#{@account.currency})", class: "text-sm text-gray-700" %>
          <%= form.number_field :alert_void_above, value: plain_number(@account.alert_void_above), step: "0.01", min: 0, class: "input" %>
        </div>
        <div>
          <%= form.label :alert_count_loss_above, "A stock count loses more than, at cost (#{@account.currency})", class: "text-sm text-gray-700" %>
          <%= form.number_field :alert_count_loss_above, value: plain_number(@account.alert_count_loss_above), step: "0.01", min: 0, class: "input" %>
        </div>
      </div>
    </fieldset>

    <div class="field flex items-start gap-2">
      <%= form.check_box :require_second_approver, class: "mt-1 size-4 accent-primary-500" %>
      <div>
        <%= form.label :require_second_approver, "Owners and managers need a second person to approve their own voids, discounts and credit", class: "text-sm font-medium text-gray-800" %>
        <p class="hint">Another owner or manager types their approval PIN. Off, they approve their own, and Activity notes it.</p>
      </div>
    </div>

    <div class="field">
      <%= form.label :receipt_footer, "Receipt footer", class: "label" %>
      <%= form.text_area :receipt_footer, rows: 2, class: "input", placeholder: "e.g. Goods sold are returnable within 7 days with this receipt. PIN P051234567X" %>
    </div>

    <div class="field flex items-start gap-2">
      <%= form.check_box :require_two_factor_for_managers, class: "mt-1 size-4 accent-primary-500" %>
      <div>
        <%= form.label :require_two_factor_for_managers, "Require two-factor sign-in for owners and managers", class: "text-sm font-medium text-gray-800" %>
        <p class="hint">They'll be asked to set it up the next time they use HardPoint.</p>
      </div>
    </div>

    <div id="sms" class="field flex items-start gap-2">
      <%= form.check_box :sms_enabled, class: "mt-1 size-4 accent-primary-500" %>
      <div>
        <%= form.label :sms_enabled, "Send texts to customers (SMS)", class: "text-sm font-medium text-gray-800" %>
        <p class="hint">Receipts by text, "your order is ready" and balance reminders, sent through Africa's Talking.
          <%= "#{pluralize(@account.sms_messages.where(created_at: Time.current.all_month).count, "text")} this month · " if @account.sms_enabled? %><%= link_to "Texts sent", sms_messages_path, class: "link" %></p>
      </div>
    </div>

    <p class="mb-4 text-sm text-gray-500">Web address: <%= request.host %> (contact support to change it)</p>

    <%= form.submit "Save settings", class: "btn-primary" %>
  <% end %>
</div>
