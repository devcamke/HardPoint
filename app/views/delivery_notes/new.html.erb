<% content_for :title, "New delivery note" %>
<% sale = @delivery_note.sale %>
<h1 class="mb-2 text-xl font-medium"><%= link_to "Sale #{sale.receipt_number}", sale, class: "link" %> <span class="text-gray-400">/</span> Deliver sale <%= sale.receipt_number %></h1>
<p class="hint mb-6"><%= sale.customer&.name || "Walk-in customer" %> · <%= pluralize(sale.lines.size, "line") %> · <%= money(sale.total_cents) %></p>

<%= form_with model: @delivery_note, class: "card max-w-xl" do |form| %>
  <%= render "shared/errors", model: @delivery_note %>
  <%= form.hidden_field :sale_id %>
  <div class="field"><%= form.label :address, "Deliver to", class: "label" %><%= form.text_field :address, required: true, autofocus: true, class: "input", placeholder: "Site, street, landmark" %></div>
  <div class="field"><%= form.label :contact_phone, "Contact on site", class: "label" %><%= form.telephone_field :contact_phone, class: "input" %></div>
  <div class="field"><%= form.label :note, "Note for the driver", class: "label" %><%= form.text_field :note, class: "input", placeholder: "e.g. offload at the back gate" %></div>
  <div class="field">
    <%= form.label :transport_charge, "Transport charge (#{Current.account.currency})", class: "label" %>
    <% if (on_sale = sale.transport_cents).positive? %>
      <p class="hint">Transport of <%= money(on_sale) %> is already on the sale.</p>
    <% elsif sale.customer %>
      <%= form.number_field :transport_charge, value: (plain_number(@delivery_note.transport_charge) if @delivery_note.transport_charge_cents.positive?), step: "0.01", min: 0, class: "input" %>
      <p class="hint mt-1">Leave blank if delivery is free. A charge becomes an order for <%= sale.customer.name %>, collected at the till or put on their account.</p>
    <% else %>
      <p class="hint">A walk-in sale can't be charged afterwards; add transport at the till before payment.</p>
    <% end %>
  </div>
  <%= form.submit "Create delivery note", class: "btn-primary" %>
<% end %>
