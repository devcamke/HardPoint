#!/usr/bin/env sh

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

# Precompiled assets (from a production build, or assets:precompile) make Propshaft serve those instead of the
# live files, so the CSS stops updating. They're never wanted in development.
if [ -f public/assets/.manifest.json ]; then
  echo "Removing precompiled assets in public/assets (they'd hide your changes)"
  rm -rf public/assets
fi

exec foreman start -f Procfile.dev "$@"
